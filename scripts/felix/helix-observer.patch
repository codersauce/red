+                "ranges": selections.iter().map(|r| [r.anchor, r.head]).collect::<Vec<_>>(),
+                "unnamed": read_register('"'), "search": read_register('/'),
+                "prompt": prompt, "pending": ui.keymaps.pending().iter().map(ToString::to_string).collect::<Vec<_>>(),
+                "count": self.editor.count, "last_insert": format!("{:?}", ui.last_insert),
+                "insert_recipe": {"command": ui.last_insert.0.name(), "events": insert_events},
+                "revision": doc.version(), "document": doc.display_name(),
+                "viewport": {"anchor": doc.view_offset(view.id).anchor, "height": view.inner_height()},
+                "history_revision": self.editor.document_mut(view.doc).unwrap().get_current_revision()
+            });
+            writeln!(output, "{record}").expect("write reference trace");
+        }
+
         if should_redraw && !self.editor.should_close() {
             self.render().await;
         }
