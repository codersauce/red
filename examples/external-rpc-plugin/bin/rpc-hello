#!/bin/sh
# Minimal JSON-RPC 2.0 over stdio plugin example for Red.
while IFS= read -r line; do
    req_id=$(printf '%s' "$line" | sed -n 's/.*"jsonrpc":"2.0","id":\([0-9][0-9]*\).*/\1/p')
    case "$line" in
        *'"method":"initialize"'*)
            printf '{"jsonrpc":"2.0","id":%s,"result":{"commands":[{"name":"RpcHello","title":"Say hello via JSON-RPC","category":"Examples","arguments":true}],"events":["editor:ready"]}}\n' "$req_id"
            ;;
        *'"method":"lifecycle/activate"'*|*'"method":"lifecycle/stateImport"'*|*'"method":"lifecycle/exportState"'*|*'"method":"lifecycle/deactivate"'*|*'"method":"lifecycle/beforeExit"'*)
            printf '{"jsonrpc":"2.0","id":%s,"result":null}\n' "$req_id"
            ;;
        *'"method":"command/execute"'*)
            printf '{"jsonrpc":"2.0","method":"red/execute","params":{"action":"Print","args":["Hello from JSON-RPC plugin!"]}}\n'
            printf '{"jsonrpc":"2.0","id":%s,"result":null}\n' "$req_id"
            ;;
        *'"method":"event/notify"'*)
            printf '{"jsonrpc":"2.0","id":%s,"result":null}\n' "$req_id"
            ;;
        *)
            if [ -n "$req_id" ]; then
                printf '{"jsonrpc":"2.0","id":%s,"error":{"code":-32601,"message":"Method not found"}}\n' "$req_id"
            fi
            ;;
    esac
done
