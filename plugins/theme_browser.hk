struct ThemeBrowserState {
    picker: Option<i32>,
}

#[red::state]
fn initial_state() -> ThemeBrowserState {
    return ThemeBrowserState { picker: None };
}

#[red::command(
    name = "ThemeBrowser",
    title = "Browse themes",
    category = "View",
    description = "Preview and select an editor theme",
    aliases = ["colorscheme", "theme"],
    scope = "global",
)]
fn theme_browser() {
    let handle = red::execute("OpenThemeBrowser");
    red::state_patch(ThemeBrowserState { picker: Some(handle) });
}

fn deactivate() {
    let state: ThemeBrowserState = red::state();
    if let Some(handle) = state.picker {
        red::execute("ClosePicker", handle);
    }
}
