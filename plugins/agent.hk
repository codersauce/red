// Bundled Codex conversation, follow, permission, and attributed-history interface.
//
// Rust owns process and thread lifecycle, dynamic tools, live editor changes, saving,
// and recovery. This plugin owns only presentation and session-scoped UI state. Event
// handlers ignore foreign session IDs, queued prompts remain FIFO, and deactivate closes
// plugin UI resources without claiming that an active Codex process survived recovery.

struct AgentSessionEvent {
    session_id: String,
    turn_id: Option<String>,
}

struct AgentTextEvent {
    session_id: String,
    text: String,
}

struct AgentCompletedEvent {
    session_id: String,
    turn_id: Option<String>,
    stop_reason: String,
    elapsed_ms: i64,
}

/// A message the core holds before, or while, it is sent.
struct AgentPanePrompt {
    id: String,
    text: String,
}

/// Lifecycle snapshot published by the editor core in `agent:pane_state`.
/// The core owns the session, turn phase, and follow-up queue; the pane renders it.
struct AgentPaneState {
    phase: String,
    session_id: Option<String>,
    turn_id: Option<String>,
    in_flight: Option<AgentPanePrompt>,
    queued: [AgentPanePrompt],
    paused: bool,
    stop_failed: bool,
    recap_pending: bool,
    // The message whose reply Codex cut short; the core waits for a choice.
    interrupted: Option<AgentPanePrompt>,
    // A saved thread resumes when the pane opens or the next message is sent.
    resume_pending: bool,
}


struct AgentErrorEvent {
    session_id: String,
    turn_id: Option<String>,
    message: String,
}

struct AgentSessionLostEvent {
    session_id: String,
    prompt: String,
    message: String,
}

struct AgentPanelEvent {
    action: String,
    text: String,
}

struct RestoredPane {
    id: String,
    visible: bool,
}

struct RestoredPanesEvent {
    panels: [RestoredPane],
}

struct AgentTranscriptEvent {
    transcript: String,
}

struct AgentConversationItem {
    id: String,
    turn_id: Option<String>,
    role: String,
    text: String,
}

struct AgentConversationEvent {
    thread_id: String,
    cwd: String,
    model_info: Json,
    items: [AgentConversationItem],
}

/// A conversation saved by an earlier Red launch in this workspace.
struct AgentResumableEvent {
    thread_id: String,
    cwd: String,
    model_info: Json,
    items: [AgentConversationItem],
    age: String,
}

struct AgentStringValueEvent {
    value: String,
}

struct AgentStoredValueEvent {
    // Plugin storage may be absent or contain an arbitrary prior-version payload.
    value: Json,
}

struct AgentActivityRow {
    id: String,
    title: String,
    full_title: String,
    status: String,
    kind: String,
    detail: String,
}

struct AgentActivityHistory {
    id: String,
    details: String,
    rows: [AgentActivityRow],
    expanded: bool,
}

struct AgentActivityWorkspaceRow { data: AgentActivityRow }
struct AgentActivityWorkspaceEvent { action: String, row: AgentActivityWorkspaceRow }

struct AgentThoughtContent {
    text: String,
}

struct AgentThoughtChunk {
    content: Option<AgentThoughtContent>,
}

struct AgentToolCall {
    title: Option<String>,
    full_title: Option<String>,
    kind: Option<String>,
    tool_call_id: Option<String>,
    status: Option<String>,
    detail: Option<String>,
}

struct AgentToolCallUpdate {
    tool_call_id: Option<String>,
    status: Option<String>,
    title: Option<String>,
    full_title: Option<String>,
    kind: Option<String>,
    detail: Option<String>,
}

enum AgentActivityUpdate {
    AgentThoughtChunk(AgentThoughtChunk),
    ToolCall(AgentToolCall),
    ToolCallUpdate(AgentToolCallUpdate),
    Plan,
    // Forward-compatible agent updates remain intentionally opaque.
    Unknown(Json),
}

struct AgentActivityEvent {
    session_id: String,
    update: AgentActivityUpdate,
}

struct AgentTextBlock {
    id: String,
    kind: String,
    format: String,
    text: String,
}

struct TextPanelComposerConfig {
    placeholder: String,
    rows: i32,
}

struct TextPanelHeaderAction {
    id: String,
    key: String,
    label: String,
    compact_label: String,
}

struct AgentEditOrigin {
    kind: String,
    session_id: Option<String>,
    turn_id: Option<String>,
    name: Option<String>,
}

struct AgentHistoryEntry {
    transaction_id: String,
    label: String,
    current: bool,
    applied: bool,
    origin: AgentEditOrigin,
    file: String,
    age: String,
    added: i32,
    removed: i32,
    turn: Option<i32>,
    prompt: Option<String>,
    document: Json,
}

struct AgentHistoryResult {
    entries: [AgentHistoryEntry],
    total: Option<i32>,
}

struct AgentHistoryRowData {
    transaction_id: String,
    title: String,
    document: Json,
}

struct AgentHistoryRow {
    id: String,
    data: AgentHistoryRowData,
}

struct AgentHistoryEvent {
    action: String,
    row: AgentHistoryRow,
}

struct AgentWorkspaceActionHint {
    id: String,
    key: String,
    label: String,
    priority: String,
}

struct AgentWorkspaceAction {
    hint: AgentWorkspaceActionHint,
}

struct AgentPermissionOption {
    option_id: String,
    name: String,
    kind: String,
}

struct AgentPermissionEvent {
    session_id: String,
    request_id: String,
    options: [AgentPermissionOption],
}

struct AgentState {
    default_model_info: Json,
    default_model_loading: bool,
    model_info: Json,
    turn_model_info: Json,
    accepted_model: Json,
    model_catalog: [Json],
    model_catalog_loaded: bool,
    model_catalog_request: i32,
    model_picker: Option<i32>,
    model_picker_session: String,
    model_picker_loading: bool,
    model_selection: Json,
    session_browser_open: bool,
    session_browser_scope: String,
    session_browser_query: String,
    session_browser_cwd: String,
    session_browser_request: i32,
    session_browser_debounce: String,
    session_browser_results: [Json],
    session_browser_results_query: String,
    session_browser_views: Json,
    session_browser_selected: String,
    session_browser_selected_index: i32,
    session_browser_preview_open: bool,
    session_browser_preview_request: i32,
    session_browser_preview_debounce: String,
    session_browser_preview_cache: Json,
    session_switch_target: String,
    model_header_text: String,
    model_header_secondary: String,
    session_id: String,
    pane: AgentPaneState,
    committed_prompt_id: String,
    panel_created: bool,
    panel_open: bool,
    /// False while a compact (narrow-terminal) pane is open but covered by the editor.
    panel_in_view: bool,
    /// Turns sent in this pane, which picks the turn's working verb.
    sent_turns: i32,
    focus_panel_on_first_prompt: bool,
    permission_request_id: String,
    prompt_history: [String],
    transcript: String,
    transcript_blocks: [AgentTextBlock],
    streaming: bool,
    stream_block_id: String,
    block_generation: i32,
    stream_timer: String,
    stream_delta: String,
    stream_trimmed: bool,
    history_open: bool,
    history_detail: [[PanelSegment]],
    history_document: Json,
    history_detail_title: String,
    history_selected: String,
    history_agent_only: bool,
    ui_phase: String,
    ui_label: String,
    activity_rows: [AgentActivityRow],
    activity_history: [AgentActivityHistory],
    activity_inspector_id: String,
    activity_inspector_detail: [[PanelSegment]],
    activity_block_id: String,
    thought: String,
    // Prompt id of the interrupted reply whose notice is in the transcript.
    interruption_id: String,
    // Codex itself went away (not just a failed turn), so the next
    // interruption gets the full explanation.
    codex_lost: bool,
    // The shown interruption came from Codex going away.
    interruption_lost_codex: bool,
    // Composer hint for a conversation continued from an earlier launch.
    resume_hint: String,
    // Age of that conversation while its transcript is still the saved copy,
    // which the resumed thread's history replaces.
    resume_age: String,
}

#[red::state]
fn initial_state() -> AgentState {
    return AgentState {
        default_model_info: Json {},
        default_model_loading: false,
        model_info: Json {},
        turn_model_info: Json {},
        accepted_model: Json {},
        model_catalog: [],
        model_catalog_loaded: false,
        model_catalog_request: -1,
        model_picker: None,
        model_picker_session: "",
        model_picker_loading: false,
        model_selection: Json {},
        session_browser_open: false,
        session_browser_scope: "red",
        session_browser_query: "",
        session_browser_cwd: "",
        session_browser_request: -1,
        session_browser_debounce: "",
        session_browser_results: [],
        session_browser_results_query: "",
        session_browser_views: Json {},
        session_browser_selected: "",
        session_browser_selected_index: 0,
        session_browser_preview_open: false,
        session_browser_preview_request: -1,
        session_browser_preview_debounce: "",
        session_browser_preview_cache: Json {},
        session_switch_target: "",
        model_header_text: "",
        model_header_secondary: "",
        session_id: "",
        pane: idle_pane_state(),
        committed_prompt_id: "",
        panel_created: false,
        panel_open: false,
        panel_in_view: true,
        sent_turns: 0,
        focus_panel_on_first_prompt: false,
        permission_request_id: "",
        prompt_history: [],
        transcript: "",
        transcript_blocks: [],
        streaming: false,
        stream_block_id: "",
        block_generation: 0,
        stream_timer: "",
        stream_delta: "",
        stream_trimmed: false,
        history_open: false,
        history_detail: [],
        history_document: red::null(),
        history_detail_title: "",
        history_selected: "",
        history_agent_only: false,
        ui_phase: "idle",
        ui_label: "",
        activity_rows: [],
        activity_history: [],
        activity_inspector_id: "",
        activity_inspector_detail: [],
        activity_block_id: "",
        thought: "",
        interruption_id: "",
        codex_lost: false,
        interruption_lost_codex: false,
        resume_hint: "",
        resume_age: "",
    };
}

struct AgentModelChangedEvent {
    session_id: String,
    model_info: Json,
}

struct AgentModelReroutedEvent {
    session_id: String,
    model: String,
}

#[red::on("agent:model_rerouted")]
fn model_rerouted(event: AgentModelReroutedEvent) {
    if event.session_id == "" || event.session_id != state().session_id { return; }
    red::state_patch(AgentState { turn_model_info: Json { model: event.model } });
    refresh_model_header();
}

struct AgentModelsResult {
    models: [Json],
    error: String,
}

struct AgentSessionsResult {
    sessions: [Json],
    error: String,
    more: bool,
}

struct AgentSessionPreviewResult {
    session_id: String,
    prompt: String,
    response: String,
    error: String,
}

struct AgentDefaultModelResult {
    model_info: Json,
    error: String,
}

// Preview only: opening a pane must not create a conversation or change settings.
fn load_default_model() {
    if state().session_id != "" || state().default_model_loading
        || pane_phase() != "idle" { return; }
    red::state_patch(AgentState { default_model_loading: true });
    red::request("AgentReadDefaultModel", default_model_loaded);
}

fn default_model_loaded(result: AgentDefaultModelResult) {
    red::state_patch(AgentState { default_model_loading: false });
    if red::string(result.error, "") != "" { return; }
    red::state_patch(AgentState { default_model_info: result.model_info });
    refresh_model_header();
}

fn next_model_info() -> Json {
    if model_name(state().accepted_model) != "" { return state().accepted_model; }
    if model_name(state().model_info) != "" { return state().model_info; }
    if state().session_id == "" { return state().default_model_info; }
    return Json {};
}

struct AgentModelSetResult {
    accepted: bool,
    model_info: Json,
    error: String,
}

fn model_name(info: Json) -> String {
    if info == red::null() { return ""; }
    return red::string(info.model, "");
}

fn model_effort(info: Json) -> String {
    if info == red::null() { return ""; }
    return red::string(info.effort, "");
}

fn model_description(info: Json) -> String {
    let name = model_name(info);
    let effort = model_effort(info);
    if name != "" && effort != "" { return name + " · " + effort; }
    return name;
}

fn same_model(left: Json, right: Json) -> bool {
    return model_name(left) == model_name(right) && model_effort(left) == model_effort(right);
}

fn reset_model_state() {
    red::state_patch(AgentState { model_info: Json {}, turn_model_info: Json {}, accepted_model: Json {} });
    refresh_model_header();
}

fn refresh_model_header() {
    if !state().panel_created { return; }
    if state().session_browser_open {
        refresh_session_browser_header();
        return;
    }
    let current = state().model_info;
    if model_name(current) == "" { current = next_model_info(); }
    let running = state().turn_model_info;
    let accepted = state().accepted_model;
    let text = model_name(current);
    let secondary = model_effort(current);
    let next = Json {};
    if model_name(running) != "" {
        text = model_name(running);
        secondary = model_effort(running);
        if model_name(current) != "" && !same_model(running, current) {
            next = current;
        }
    }
    if model_name(accepted) != "" && !same_model(accepted, current) {
        next = accepted;
    }
    if text == "" { text = "Codex"; }
    let compact = "";
    if model_name(next) != "" {
        secondary = "Next: " + model_description(next);
        compact = text + " → " + model_name(next);
    }
    if is_restoring() { secondary = "restoring…"; compact = ""; }
    if text == state().model_header_text && secondary == state().model_header_secondary { return; }
    red::state_patch(AgentState { model_header_text: text, model_header_secondary: secondary });
    red::execute("SetTextPanelHeaderDetail", "agent-conversation", Json {
        text: text, secondary: secondary, compact_text: compact, action: "model", shortcut: "Alt-m",
    });
}

#[red::on("agent:model_changed")]
fn model_changed(event: AgentModelChangedEvent) {
    if event.session_id == "" || event.session_id != state().session_id { return; }
    if turn_running() && model_name(state().turn_model_info) == "" {
        red::state_patch(AgentState { turn_model_info: event.model_info });
    }
    red::state_patch(AgentState { model_info: event.model_info, accepted_model: Json {} });
    refresh_model_header();
}

#[red::command(
    name = "AgentModel",
    title = "Change agent model",
    category = "Agent",
    description = "Choose the model and reasoning effort for this conversation",
    aliases = ["change model", "reasoning effort"],
    scope = "global",
)]
fn choose_model() {
    if state().session_browser_open { close_session_browser(); }
    if is_restoring() {
        red::execute("Print", "Wait for the agent session to finish restoring");
        return;
    }
    if state().model_picker_loading { return; }
    red::state_patch(AgentState { model_picker_session: state().session_id });
    let loading = !state().model_catalog_loaded;
    let status = "This conversation only";
    if loading { status = "Loading models…"; }
    let handle = red::execute("OpenPicker", "Agent model", model_items(), PickerOptions {
        placeholder: "Search models…", initial_selection: current_catalog_model(),
        status: status, busy: loading, presentation: "compact", item_layout: "label_first",
    }, PickerHandlers { selected: model_selected, cancelled: model_picker_cancelled });
    red::state_patch(AgentState { model_picker: Some(handle) });
    prefetch_models();
}

fn prefetch_models() {
    if state().model_catalog_loaded || state().model_catalog_request != -1 { return; }
    let request = red::request("AgentListModels", models_loaded);
    red::state_patch(AgentState { model_catalog_request: request });
}

fn invalidate_model_catalog() {
    red::state_patch(AgentState {
        model_catalog: [], model_catalog_loaded: false, model_catalog_request: -1,
    });
}

fn current_catalog_model() -> String {
    let current = model_name(next_model_info());
    if current != "" { return current; }
    for model in state().model_catalog {
        if red::bool(model.isDefault, false) { return red::string(model.model, ""); }
    }
    return "";
}

fn model_picker_is_current() -> bool {
    if state().model_picker_session != state().session_id {
        red::execute("Print", "The agent conversation changed; choose its model again");
        return false;
    }
    return true;
}

fn models_loaded(result: AgentModelsResult, request_id: i32) {
    if request_id != state().model_catalog_request { return; }
    red::state_patch(AgentState { model_catalog_request: -1 });
    let error = red::string(result.error, "");
    if error == "" && red::len(result.models) == 0 {
        error = "Codex did not return any available models";
    }
    if error == "" {
        red::state_patch(AgentState { model_catalog: result.models, model_catalog_loaded: true });
    }
    let Some(handle) = state().model_picker else { return; };
    if state().model_picker_session != state().session_id {
        red::state_patch(AgentState { model_picker: None });
        red::execute("ClosePicker", handle);
        return;
    }
    red::execute("UpdatePickerBusy", handle, false);
    if error != "" {
        red::execute("UpdatePickerStatus", handle, "Could not load models: " + error);
        return;
    }
    red::execute("UpdatePickerItems", handle, model_items());
    red::execute("UpdatePickerSelection", handle, current_catalog_model());
    red::execute("UpdatePickerStatus", handle, "This conversation only");
}

fn model_items() -> [PickerItem] {
    let current = current_catalog_model();
    let items = [];
    for model in state().model_catalog {
        let id = red::string(model.model, "");
        let icon = "";
        if id == current { icon = "✓"; }
        items = red::push(items, PickerItem {
            id: id, icon: icon,
            label: red::string(model.displayName, id),
            detail: red::string(model.description, ""), data: model,
        });
    }
    return items;
}

fn model_selected(item: PickerItem) {
    red::state_patch(AgentState { model_picker: None });
    if !model_picker_is_current() { return; }
    let model = item.data;
    let effort = model_effort(next_model_info());
    let selected_effort = red::string(model.defaultReasoningEffort, "");
    let items = [];
    for option in model.supportedReasoningEfforts {
        let id = red::string(option.reasoningEffort, "");
        if id == effort { selected_effort = id; }
        items = red::push(items, PickerItem {
            id: id, label: id, detail: red::string(option.description, ""),
            data: Json { model: model.model, effort: id },
        });
    }
    red::state_patch(AgentState { model_selection: Json { model: model.model } });
    if red::len(items) == 0 {
        apply_model_selection();
        return;
    }
    red::execute("OpenPicker", "Reasoning effort", items, PickerOptions {
        placeholder: "Choose reasoning effort…", initial_selection: selected_effort,
        status: red::string(model.displayName, model.model), presentation: "compact", item_layout: "label_first",
    }, PickerHandlers { selected: model_effort_selected, cancelled: model_picker_cancelled });
}

fn model_effort_selected(item: PickerItem) {
    red::state_patch(AgentState { model_selection: item.data });
    apply_model_selection();
}

fn apply_model_selection() {
    if !model_picker_is_current() { return; }
    red::state_patch(AgentState { model_picker_loading: true });
    red::request("AgentSetModel", model_set, state().model_picker_session, state().model_selection);
}

fn model_set(result: AgentModelSetResult) {
    red::state_patch(AgentState { model_picker_loading: false });
    if !model_picker_is_current() { return; }
    let error = red::string(result.error, "");
    if error != "" {
        invalidate_model_catalog();
        red::execute("Print", "Could not change Codex model: " + error);
        return;
    }
    if model_name(result.model_info) != "" {
        red::state_patch(AgentState { model_info: result.model_info, accepted_model: Json {} });
    } else if !same_model(state().model_selection, state().model_info) {
        red::state_patch(AgentState { accepted_model: state().model_selection });
    }
    refresh_model_header();
    red::execute("Print", "Agent model selected: " + model_description(state().model_selection));
}

fn model_picker_cancelled(event: PickerCancelled) {
    red::state_patch(AgentState { model_picker: None });
}

#[red::command(
    name = "AgentSessions",
    title = "Resume agent session",
    category = "Agent",
    description = "Search and resume a previous Codex conversation in the Agent pane",
    aliases = ["resume session", "switch session", "previous agent session"],
    scope = "global",
)]
fn choose_session() {
    if pane_phase() != "idle" {
        red::execute("Print", "Wait for the current agent operation to finish");
        return;
    }
    if queued_count() > 0 || state().interruption_id != "" {
        red::execute("Print", "Send, discard, or resolve held Agent follow-ups before switching sessions");
        return;
    }
    if state().session_browser_open {
        close_session_browser();
        return;
    }
    ensure_conversation_panel();
    red::state_patch(AgentState {
        session_browser_open: true,
        session_browser_cwd: "",
        session_browser_request: -1,
        session_browser_results: [],
        session_browser_results_query: "",
    });
    red::request("GetConfig", session_browser_cwd_loaded, "cwd");
}

fn session_browser_cwd_loaded(result: AgentStringValueEvent) {
    if !state().session_browser_open { return; }
    let cwd = red::string(result.value, ".");
    let previous = state().session_browser_views[cwd];
    let scope = "red";
    let query = "";
    let selected = "";
    let selected_index = 0;
    let preview = false;
    if previous != red::null() {
        scope = red::string(previous.scope, "red");
        query = red::string(previous.query, "");
        selected = red::string(previous.selected, "");
        selected_index = red::int(previous.selected_index, 0);
        preview = red::bool(previous.preview, false);
    }
    red::state_patch(AgentState {
        session_browser_cwd: cwd,
        session_browser_scope: scope,
        session_browser_query: query,
        session_browser_selected: selected,
        session_browser_selected_index: selected_index,
        session_browser_preview_open: preview,
        session_browser_preview_request: -1,
        session_browser_preview_debounce: "",
    });
    red::execute("EnterTextPanelContext", "agent-conversation", "Search previous sessions…", Json {
        key: cwd, query: query,
    });
    refresh_session_browser_header();
    render_session_browser([], "", true, false);
    if preview {
        red::execute("SetTextPanelPreview", "agent-conversation", Json {
            session_id: selected, loading: true,
        });
    }
    request_sessions();
}

fn session_scope_label() -> String {
    if state().session_browser_scope == "workspace" { return "This workspace"; }
    if state().session_browser_scope == "all" { return "All Codex"; }
    return "Red";
}

fn refresh_session_browser_header() {
    if !state().session_browser_open { return; }
    let scope = session_scope_label();
    red::execute("SetTextPanelHeaderDetail", "agent-conversation", Json {
        text: "Previous sessions", secondary: scope, compact_text: scope,
        action: "session_scope", shortcut: "Alt-s",
    });
}

fn request_sessions() {
    if !state().session_browser_open { return; }
    red::execute("SetTextPanelStatus", "agent-conversation", TextPanelStatus {
        busy: true, label: "Searching " + session_scope_label() + " sessions…", stream: false,
    });
    let request = red::request(
        "AgentListSessions",
        sessions_loaded,
        state().session_browser_cwd,
        state().session_browser_scope,
        state().session_browser_query,
        state().session_id
    );
    red::state_patch(AgentState { session_browser_request: request });
}

fn sessions_loaded(result: AgentSessionsResult, request_id: i32) {
    if request_id != state().session_browser_request { return; }
    red::state_patch(AgentState { session_browser_request: -1 });
    if !state().session_browser_open { return; }
    red::execute("SetTextPanelStatus", "agent-conversation");
    let error = red::string(result.error, "");
    if error != "" {
        red::state_patch(AgentState { session_browser_results: [] });
        red::state_patch(AgentState { session_browser_results_query: state().session_browser_query });
        render_session_browser([], "Could not load sessions: " + error, false, false);
        return;
    }
    red::state_patch(AgentState {
        session_browser_results: result.sessions,
        session_browser_results_query: state().session_browser_query,
    });
    restore_session_browser_selection(result.sessions);
    render_session_browser(result.sessions, "", false, red::bool(result.more, false));
    if state().session_browser_preview_open { queue_session_preview(); }
}

fn restore_session_browser_selection(sessions: [Json]) {
    let selected = red::string(state().session_browser_selected, "");
    let selected_index = red::int(state().session_browser_selected_index, 0);
    let index = 0;
    let found = false;
    for session in sessions {
        if red::string(session.id, "") == selected {
            selected_index = index;
            found = true;
        }
        index = index + 1;
    }
    if !found && red::len(sessions) > 0 {
        if selected_index >= red::len(sessions) { selected_index = red::len(sessions) - 1; }
        if selected_index < 0 { selected_index = 0; }
        selected = red::string(sessions[selected_index].id, "");
    }
    if red::len(sessions) == 0 {
        selected = "";
        selected_index = 0;
    }
    red::state_patch(AgentState {
        session_browser_selected: selected,
        session_browser_selected_index: selected_index,
    });
}

fn render_session_browser(sessions: [Json], error: String, loading: bool, more: bool) {
    if !state().session_browser_open { return; }
    let blocks = [];
    if loading {
        blocks = red::push(blocks, AgentTextBlock {
            id: "session-browser:loading", kind: "text", format: "plain", text: "Loading sessions…",
        });
    }
    if error != "" {
        blocks = red::push(blocks, AgentTextBlock {
            id: "session-browser:error", kind: "error", format: "plain", text: error,
        });
    }
    let current_group = "";
    for session in sessions {
        let group = red::string(session.time_group, "Earlier");
        if group != current_group {
            blocks = red::push(blocks, AgentTextBlock {
                id: "session-browser:group:" + group,
                kind: "text", format: "plain", text: group,
            });
            current_group = group;
        }
        let detail = red::string(session.detail, "");
        let snippet = red::string(session.snippet, "");
        if !red::bool(session.is_red, false) { detail = detail + " · Continue in Red"; }
        if snippet != "" { detail = detail + " · " + snippet; }
        blocks = red::push(blocks, AgentTextBlock {
            id: "session-browser:session:" + red::string(session.id, ""),
            kind: "action", format: "plain",
            text: red::string(session.label, "Untitled session") + "\n" + detail,
        });
    }
    if more {
        blocks = red::push(blocks, AgentTextBlock {
            id: "session-browser:more", kind: "text", format: "plain",
            text: "Showing the " + red::len(sessions) + " most recent · type to search older sessions",
        });
    }
    if !loading && error == "" && red::len(sessions) == 0 {
        let message = "No previous sessions in this scope";
        if red::trim(state().session_browser_query) != "" { message = "No matching sessions"; }
        blocks = red::push(blocks, AgentTextBlock {
            id: "session-browser:empty", kind: "text", format: "plain", text: message,
        });
    }
    red::execute("UpdateTextPanel", "agent-conversation", blocks);
}

fn session_browser_query_changed(query: String) {
    if !state().session_browser_open || query == state().session_browser_query { return; }
    red::state_patch(AgentState { session_browser_query: query, session_browser_request: -1 });
    let previous = red::string(state().session_browser_debounce, "");
    if previous != "" { red::execute("CancelTimeout", previous); }
    let timer = red::execute("SetTimeout", 150);
    red::state_patch(AgentState { session_browser_debounce: timer });
}

#[red::on("timeout:callback")]
fn session_browser_timeout(event: TimerEvent) {
    if event.timer_id == state().session_browser_preview_debounce {
        red::state_patch(AgentState { session_browser_preview_debounce: "" });
        request_session_preview();
        return;
    }
    if event.timer_id != state().session_browser_debounce { return; }
    red::state_patch(AgentState { session_browser_debounce: "" });
    request_sessions();
}

fn session_browser_selection_changed(block_id: String) {
    if !state().session_browser_open { return; }
    let index = 0;
    for session in state().session_browser_results {
        let id = red::string(session.id, "");
        if block_id == "session-browser:session:" + id {
            if id == state().session_browser_selected { return; }
            red::state_patch(AgentState {
                session_browser_selected: id,
                session_browser_selected_index: index,
                session_browser_preview_request: -1,
            });
            if state().session_browser_preview_open { queue_session_preview(); }
            return;
        }
        index = index + 1;
    }
}

fn toggle_session_preview() {
    if !state().session_browser_open { return; }
    let open = !state().session_browser_preview_open;
    let previous = red::string(state().session_browser_preview_debounce, "");
    if previous != "" { red::execute("CancelTimeout", previous); }
    red::state_patch(AgentState {
        session_browser_preview_open: open,
        session_browser_preview_request: -1,
        session_browser_preview_debounce: "",
    });
    if !open {
        red::execute("SetTextPanelPreview", "agent-conversation");
        return;
    }
    queue_session_preview();
}

fn queue_session_preview() {
    if !state().session_browser_open || !state().session_browser_preview_open { return; }
    let selected = red::string(state().session_browser_selected, "");
    if selected == "" {
        red::execute("SetTextPanelPreview", "agent-conversation", Json {
            error: "Select a session to preview",
        });
        return;
    }
    let item = red::null();
    for session in state().session_browser_results {
        if red::string(session.id, "") == selected { item = session; }
    }
    if item == red::null() { return; }
    let cached = state().session_browser_preview_cache[selected];
    if cached != red::null() {
        if cached.updated_at == item.updated_at {
            red::execute("SetTextPanelPreview", "agent-conversation", Json {
                session_id: selected,
                prompt: red::string(cached.prompt, ""),
                response: red::string(cached.response, ""),
            });
            return;
        }
    }
    let previous = red::string(state().session_browser_preview_debounce, "");
    if previous != "" { red::execute("CancelTimeout", previous); }
    red::execute("SetTextPanelPreview", "agent-conversation", Json {
        session_id: selected, loading: true,
    });
    let timer = red::execute("SetTimeout", 120);
    red::state_patch(AgentState { session_browser_preview_debounce: timer });
}

fn request_session_preview() {
    if !state().session_browser_open || !state().session_browser_preview_open { return; }
    let selected = red::string(state().session_browser_selected, "");
    if selected == "" { return; }
    let request = red::request(
        "AgentReadSessionPreview",
        session_preview_loaded,
        state().session_browser_cwd,
        selected
    );
    red::state_patch(AgentState { session_browser_preview_request: request });
}

fn session_preview_loaded(result: AgentSessionPreviewResult, request_id: i32) {
    if request_id != state().session_browser_preview_request { return; }
    red::state_patch(AgentState { session_browser_preview_request: -1 });
    if !state().session_browser_open || !state().session_browser_preview_open { return; }
    let error = red::string(result.error, "");
    if error != "" {
        red::execute("SetTextPanelPreview", "agent-conversation", Json { error: error });
        return;
    }
    let id = red::string(result.session_id, "");
    if id == "" || id != state().session_browser_selected { return; }
    let item = red::null();
    for session in state().session_browser_results {
        if red::string(session.id, "") == id { item = session; }
    }
    if item == red::null() { return; }
    let prompt = red::string(result.prompt, "");
    let response = red::string(result.response, "");
    let cache = state().session_browser_preview_cache;
    cache[id] = Json { updated_at: item.updated_at, prompt: prompt, response: response };
    red::state_patch(AgentState { session_browser_preview_cache: cache });
    red::execute("SetTextPanelPreview", "agent-conversation", Json {
        session_id: id, prompt: prompt, response: response,
    });
}

fn cycle_session_scope() {
    if !state().session_browser_open { return; }
    let scope = "red";
    if state().session_browser_scope == "red" { scope = "workspace"; }
    else if state().session_browser_scope == "workspace" { scope = "all"; }
    red::state_patch(AgentState {
        session_browser_scope: scope,
        session_browser_results: [],
        session_browser_results_query: "",
    });
    refresh_session_browser_header();
    render_session_browser([], "", true, false);
    request_sessions();
}

fn close_session_browser() {
    if !state().session_browser_open { return; }
    let debounce = red::string(state().session_browser_debounce, "");
    if debounce != "" { red::execute("CancelTimeout", debounce); }
    let cwd = red::string(state().session_browser_cwd, "");
    if cwd != "" {
        let views = state().session_browser_views;
        views[cwd] = Json {
            scope: state().session_browser_scope,
            query: state().session_browser_query,
            selected: state().session_browser_selected,
            selected_index: state().session_browser_selected_index,
            preview: state().session_browser_preview_open,
        };
        red::state_patch(AgentState { session_browser_views: views });
    }
    let preview_timer = red::string(state().session_browser_preview_debounce, "");
    if preview_timer != "" { red::execute("CancelTimeout", preview_timer); }
    red::state_patch(AgentState {
        session_browser_open: false,
        session_browser_request: -1,
        session_browser_debounce: "",
        session_browser_results: [],
        session_browser_results_query: "",
        session_browser_preview_open: false,
        session_browser_preview_request: -1,
        session_browser_preview_debounce: "",
    });
    red::execute("SetTextPanelStatus", "agent-conversation");
    red::execute("ExitTextPanelContext", "agent-conversation");
    red::state_patch(AgentState { model_header_text: "", model_header_secondary: "" });
    refresh_model_header();
}

fn activate_session_browser_block(block_id: String) {
    if block_id == "session-browser:back" {
        close_session_browser();
        return;
    }
    for session in state().session_browser_results {
        if block_id == "session-browser:session:" + red::string(session.id, "") {
            session_selected(session);
            return;
        }
    }
}

fn session_selected(item: Json) {
    if state().session_browser_query != state().session_browser_results_query { return; }
    if pane_phase() != "idle" {
        red::execute("Print", "The Agent state changed; choose the session again");
        return;
    }
    let target = red::string(item.id, "");
    if target == "" { return; }
    let selected_index = 0;
    let index = 0;
    for session in state().session_browser_results {
        if red::string(session.id, "") == target { selected_index = index; }
        index = index + 1;
    }
    red::state_patch(AgentState {
        session_browser_selected: target,
        session_browser_selected_index: selected_index,
    });
    let resume = red::bool(item.is_red, false);
    let cwd = state().session_browser_cwd;
    close_session_browser();
    red::state_patch(AgentState { session_switch_target: target });
    let label = "Continuing in Red…";
    if resume { label = "Resuming session…"; }
    set_phase("restoring", label);
    red::execute("SetTextPanelComposerState", "agent-conversation", false, label);
    red::execute("AgentSwitchSession", cwd, target, resume);
}

fn state() -> AgentState {
    return red::state();
}

fn idle_pane_state() -> AgentPaneState {
    return AgentPaneState {
        phase: "idle", session_id: None, turn_id: None, in_flight: None, queued: [],
        paused: false, stop_failed: false, recap_pending: false,
        interrupted: None, resume_pending: false,
    };
}

/// The core's phase: idle, starting, restoring, working, or stopping.
fn pane_phase() -> String {
    return red::string(state().pane.phase, "idle");
}

fn turn_running() -> bool {
    let phase = pane_phase();
    return phase == "working" || phase == "stopping";
}

fn is_restoring() -> bool {
    return pane_phase() == "restoring";
}

fn queued_count() -> i32 {
    return red::len(state().pane.queued);
}

fn pane_turn_id() -> String {
    let turn_id = "";
    if let Some(value) = state().pane.turn_id { turn_id = value; }
    return turn_id;
}

/// A little personality while the agent thinks: each turn gets one verb, so the
/// status row stays calm instead of flickering between phrases.
fn working_verb() -> String {
    let verbs = [
        "Thinking…", "Pondering…", "Mulling it over…", "Reading the room…",
        "Connecting the dots…", "Sketching a plan…", "Untangling…", "Brewing ideas…",
    ];
    let turn = red::int(state().sent_turns, 1) - 1;
    if turn < 0 { turn = 0; }
    return red::string(verbs[turn % red::len(verbs)], "Thinking…");
}

/// The core sent this message as a new turn; move it from the queue into the
/// transcript in the same update.
fn commit_sent_prompt(prompt: AgentPanePrompt) {
    red::state_patch(AgentState { committed_prompt_id: prompt.id });
    if state().resume_hint != "" {
        red::state_patch(AgentState { resume_hint: "" });
        red::execute("SetTextPanelComposerState", "agent-conversation", true, "");
    }
    append_transcript_block("You", prompt.text, prompt.id);
    if state().focus_panel_on_first_prompt {
        red::state_patch(AgentState { focus_panel_on_first_prompt: false });
        red::execute("FocusTextPanelComposer", "agent-conversation");
    }
    red::state_patch(AgentState { sent_turns: red::int(state().sent_turns, 0) + 1 });
    red::state_patch(AgentState { ui_phase: "waiting", ui_label: working_verb() });
    red::execute("SetStorage", "transcript", state().transcript);
}

/// The core republishes lifecycle state after every change; the pane mirrors it.
#[red::on("agent:pane_state")]
fn pane_state_changed(event: AgentPaneState) {
    let previous = state().pane;
    let session_id = "";
    if let Some(value) = event.session_id { session_id = value; }
    if session_id != red::string(state().session_id, "") && session_id == "" {
        reset_model_state();
    }
    red::state_patch(AgentState { pane: event, session_id: session_id });
    let phase = pane_phase();
    let was = red::string(previous.phase, "idle");
    if phase == "stopping" && was != "stopping" {
        // Restart elapsed time so the status measures cancellation latency.
        red::execute("SetTextPanelStatus", "agent-conversation");
    }
    if phase != "working" && phase != "stopping" && (was == "working" || was == "stopping") {
        red::state_patch(AgentState { turn_model_info: Json {} });
        refresh_model_header();
    } else if was == "restoring" && phase != "restoring" {
        // Clear the header's "restoring…" once the thread is back.
        refresh_model_header();
    }
    let had_session = false;
    if let Some(value) = previous.session_id { had_session = value != ""; }
    if state().panel_created {
        if phase == "restoring" && was != "restoring" {
            // Messages typed now are sent as soon as the thread is back.
            red::execute("SetTextPanelComposerState", "agent-conversation", true, "Reconnecting to Codex… you can keep typing");
        } else if was == "restoring" || (session_id != "" && !had_session) {
            // A live thread replaces any "archived conversation" hint.
            red::execute("SetTextPanelComposerState", "agent-conversation", true, ready_composer_hint());
        }
    }
    sync_interruption();
    let grew = queued_count() > red::len(previous.queued);
    let committed = false;
    if let Some(prompt) = state().pane.in_flight {
        if prompt.id != state().committed_prompt_id {
            commit_sent_prompt(prompt);
            committed = true;
        }
    }
    render_conversation();
    render_status();
    if committed {
        // Paint the sent message before the turn starts streaming.
        red::execute("Refresh");
    }
    if grew {
        // Paint a newly queued message right away instead of on the next frame.
        red::execute("Refresh");
        if turn_running() {
            let waiting = "it sends when this turn ends";
            if queued_count() > 1 { waiting = queued_count() + " waiting · they send in order"; }
            red::execute("Print", "Agent is busy · follow-up queued · " + waiting);
        }
    }
}

#[red::on("agent:session_created")]
fn session_created(event: AgentSessionEvent) {
    resolve_agent_issue();
    red::state_patch(AgentState { codex_lost: false });
    // The core adopts the thread and sends any waiting message; the pane only
    // refreshes what it shows for the new conversation.
    if event.session_id != red::string(state().session_id, "") {
        red::state_patch(AgentState { model_info: Json {}, turn_model_info: Json {} });
    }
    ensure_conversation_panel();
    render_conversation();
    refresh_model_header();
    red::execute("Print", "Agent session started");
}

#[red::command(
    name = "Agent",
    title = "Ask the agent",
    category = "Agent",
    description = "Open the agent prompt",
    aliases = ["ask ai", "chat"],
    scope = "global",
)]
#[red::command(
    name = "AgentPrompt",
    title = "Open agent prompt",
    category = "Agent",
    description = "Ask a question in the active agent session",
    aliases = ["ask ai", "chat"],
    scope = "global",
)]
fn prompt() {
    if state().session_browser_open { close_session_browser(); }
    prepare_saved_conversation();
    if state().interruption_id != "" && state().interruption_lost_codex {
        open_conversation();
        choose_interruption();
        return;
    }
    if is_restoring() {
        ensure_conversation_panel();
        red::execute("FocusTextPanelComposer", "agent-conversation");
        return;
    }
    let has_live_session = red::string(state().session_id, "") != "";
    let has_restored_conversation = queued_count() == 0
        && red::trim(red::string(state().transcript, "")) != "";
    // A held prompt lives in the pane, where its paused status and actions show.
    if has_live_session || has_restored_conversation || pane_phase() != "idle" || queued_count() > 0 {
        let was_created = state().panel_created;
        ensure_conversation_panel();
        if !was_created {
            render_conversation();
        }
        if !has_live_session && state().pane.recap_pending {
            red::execute("SetTextPanelComposerState", "agent-conversation", true, "Archived conversation · next message starts a new session");
        }
        red::execute("FocusTextPanelComposer", "agent-conversation");
        return;
    }
    red::request("GetStorage", prompt_history_loaded, "prompt_history");
}

#[red::command(
    name = "AgentToggle",
    title = "Toggle agent conversation",
    category = "Agent",
    description = "Show or hide the agent conversation pane",
    aliases = ["toggle chat"],
    scope = "global",
)]
fn toggle_conversation() {
    if state().panel_open {
        close_conversation();
    } else {
        prepare_saved_conversation();
        let was_created = state().panel_created;
        ensure_conversation_panel();
        if !was_created {
            render_conversation();
            red::execute("FocusTextPanelComposer", "agent-conversation");
        } else {
            red::execute("RestorePanelFocus", "agent-conversation");
        }
    }
}

#[red::command(
    name = "AgentOpen",
    title = "Open agent conversation",
    category = "Agent",
    description = "Show and focus the conversation pane without opening a prompt",
    aliases = ["show chat", "open chat"],
    scope = "global",
)]
fn open_conversation() {
    prepare_saved_conversation();
    let was_created = state().panel_created;
    if !was_created {
        ensure_conversation_panel();
        render_conversation();
    }
    if was_created && !state().panel_open { load_default_model(); prefetch_models(); }
    // An explicit open wins over a recovered hidden-pane preference.
    red::execute("SetPanelVisible", "agent-conversation", true);
    red::state_patch(AgentState { panel_open: true });
    red::execute("FocusTextPanelComposer", "agent-conversation");
}

fn ensure_conversation_panel() {
    if !state().panel_created {
        red::execute("CreateTextPanel", "agent-conversation", PanelConfig {
            side: "right",
            width: 62,
            title: "Agent",
            composer: TextPanelComposerConfig { placeholder: "Ask a follow-up…", rows: 3 },
            header_actions: [
                TextPanelHeaderAction { id: "sessions", key: "Alt-s", label: "Sessions", compact_label: "S" },
                TextPanelHeaderAction { id: "new", key: "Alt-n", label: "New", compact_label: "N" },
                TextPanelHeaderAction { id: "clear", key: "Alt-c", label: "Clear", compact_label: "C" },
                TextPanelHeaderAction { id: "close", key: "Alt-w", label: "×", compact_label: "×" },
            ],
        });
        red::state_patch(AgentState { panel_created: true });
        if red::len(state().prompt_history) > 0 {
            sync_text_panel_prompt_history();
        } else {
            red::request("GetStorage", docked_prompt_history_loaded, "prompt_history");
        }
        red::state_patch(AgentState { model_header_text: "", model_header_secondary: "" });
        if state().resume_hint != "" {
            red::execute("SetTextPanelComposerState", "agent-conversation", true, state().resume_hint);
        }
        prefetch_models();
        refresh_model_header();
        load_default_model();
        red::state_patch(AgentState { panel_open: true });
        red::state_patch(AgentState { focus_panel_on_first_prompt: true });
        return;
    }
    if !state().panel_open {
        red::execute("SetPanelVisible", "agent-conversation", true);
        red::state_patch(AgentState { panel_open: true });
        load_default_model();
        prefetch_models();
    }
}

#[red::on("editor:panes_restore")]
fn restore_conversation_pane(event: RestoredPanesEvent) {
    for pane in event.panels {
        if pane.id == "agent-conversation" && red::bool(pane.visible, false) {
            // A pane reopened at launch is about to be used: resume right away.
            prepare_saved_conversation();
            let was_created = state().panel_created;
            ensure_conversation_panel();
            if !was_created {
                render_conversation();
            }
            return;
        }
    }
}

fn prompt_history_loaded(result: AgentStoredValueEvent) {
    let history = merged_prompt_history(result);
    red::state_patch(AgentState { prompt_history: history });
    sync_text_panel_prompt_history();
    red::execute(
        "OpenComposer",
        "Agent prompt",
        "",
        history,
        ComposerHandlers {
            submitted: prompt_submitted,
            cancelled: prompt_cancelled,
        }
    );
}

fn docked_prompt_history_loaded(result: AgentStoredValueEvent) {
    let history = merged_prompt_history(result);
    red::state_patch(AgentState { prompt_history: history });
    sync_text_panel_prompt_history();
}

fn merged_prompt_history(result: AgentStoredValueEvent) -> [String] {
    let history = [];
    for entry in state().prompt_history {
        let text = red::string(entry, "");
        if red::trim(text) != "" && !red::contains(history, text) && red::len(history) < 50 {
            history = red::push(history, text);
        }
    }
    if result.value != red::null() {
        for entry in result.value {
            let text = red::string(entry, "");
            if red::trim(text) != "" && !red::contains(history, text) && red::len(history) < 50 {
                history = red::push(history, text);
            }
        }
    }
    return history;
}

fn sync_text_panel_prompt_history() {
    if state().panel_created {
        red::execute(
            "SetTextPanelComposerHistory",
            "agent-conversation",
            state().prompt_history
        );
    }
}

fn prompt_submitted(text: String) {
    if red::trim(text) == "" {
        return;
    }
    let history = [text];
    for entry in state().prompt_history {
        if entry != text && red::len(history) < 50 {
            history = red::push(history, entry);
        }
    }
    red::state_patch(AgentState { prompt_history: history });
    sync_text_panel_prompt_history();
    red::execute("SetStorage", "prompt_history", history);
    ensure_conversation_panel();
    if state().streaming {
        red::state_patch(AgentState { stream_trimmed: true });
    }
    // The core decides whether to start a thread, send now, or queue.
    red::execute("AgentSubmit", text, red::string(state().transcript, ""));
}

#[red::on("agent:turn_started")]
fn turn_started(event: AgentSessionEvent) {
    if is_current_session(event.session_id) {
        red::state_patch(AgentState { turn_model_info: state().model_info });
        refresh_model_header();
    }
    if !is_current_session(event.session_id) {
        return;
    }
    resolve_agent_issue();
    set_phase("waiting", working_verb());
}

/// Returns whether a terminal event belongs to an earlier turn than the one shown.
fn is_stale_turn(turn_id: Option<String>) -> bool {
    let ended = "";
    if let Some(value) = turn_id { ended = value; }
    let current = pane_turn_id();
    return ended != "" && current != "" && ended != current;
}

/// Update the turn phase/label and re-render the panel status row.
fn set_phase(phase: String, label: String) {
    red::state_patch(AgentState { ui_phase: phase });
    red::state_patch(AgentState { ui_label: label });
    render_status();
}

/// Single writer for the panel status row; every phase change funnels here so
/// queue depth and streaming state are never clobbered by individual events.
fn render_status() {
    let phase = pane_phase();
    let queued = queued_count();
    if phase == "idle" {
        if state().pane.paused && queued > 0 {
            red::execute("SetTextPanelStatus", "agent-conversation", TextPanelStatus {
                busy: false,
                label: queued + " held · :AgentSendQueued to send",
                stream: false,
            });
            return;
        }
        red::execute("SetTextPanelStatus", "agent-conversation");
        return;
    }
    let label = "Working…";
    if phase == "starting" {
        label = "Starting agent…";
    } else if phase == "restoring" {
        label = "Restoring session…";
    } else if phase == "stopping" {
        label = "Stopping…";
    } else if state().pane.stop_failed {
        label = "Stop failed · Ctrl-C to retry";
    } else if red::string(state().ui_label, "") != "" {
        label = state().ui_label;
    }
    // While a thread starts, the waiting message is the next turn, not a backlog.
    if queued > 0 && (phase == "working" || phase == "stopping") {
        label = label + " · " + queued + " queued";
    }
    red::execute("SetTextPanelStatus", "agent-conversation", TextPanelStatus {
        busy: true,
        label: label,
        stream: state().streaming,
    });
}

#[red::on("agent:activity")]
fn activity(event: AgentActivityEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    match event.update {
        AgentActivityUpdate::AgentThoughtChunk(update) => thought_activity(update),
        AgentActivityUpdate::ToolCall(update) => tool_activity(update),
        AgentActivityUpdate::ToolCallUpdate(update) => update_tool_activity(update),
        AgentActivityUpdate::Plan => set_phase("working", "Planning…"),
        AgentActivityUpdate::Unknown(update) => {},
    }
}

fn optional_text(value: Option<String>, fallback: String) -> String {
    if let Some(text) = value {
        return text;
    }
    return fallback;
}

fn thought_activity(update: AgentThoughtChunk) {
    if let Some(content) = update.content {
        let text = content.text;
        if text != "" {
            let thought = state().thought + text;
            if red::len(thought) > 240 {
                thought = red::slice(thought, red::len(thought) - 240);
            }
            red::state_patch(AgentState { thought: thought });
            render_activity();
        }
    }
    set_phase("thinking", working_verb());
}

fn tool_activity(update: AgentToolCall) {
    let title = optional_text(update.title, "");
    if title == "" {
        title = optional_text(update.kind, "Tool");
    }
    update_tool_activity(AgentToolCallUpdate {
        tool_call_id: update.tool_call_id,
        title: Some(title),
        full_title: update.full_title,
        status: Some(optional_text(update.status, "in_progress")),
        kind: update.kind,
        detail: update.detail,
    });
}

fn update_tool_activity(update: AgentToolCallUpdate) {
    let target = optional_text(update.tool_call_id, "");
    let status = optional_text(update.status, "");
    let title = optional_text(update.title, "");
    let full_title = optional_text(update.full_title, title);
    let kind = optional_text(update.kind, "tool");
    let detail = optional_text(update.detail, "");
    let rows = state().activity_rows;
    let updated = [];
    let active = "";
    let found = false;
    for row in rows {
        if row.id == target && row.id != "" {
            found = true;
            if status != "" {
                row.status = status;
            }
            if title != "" {
                row.title = title;
            }
            if full_title != "" { row.full_title = full_title; }
            if detail != "" { row.detail = detail; }
        }
        if row.status == "in_progress" || row.status == "pending" {
            active = row.title;
        }
        updated = red::push(updated, row);
    }
    // A completed item can arrive without its start, for example after reconnecting.
    if !found && title != "" && red::len(updated) < 100 {
        let row_status = status;
        if row_status == "" { row_status = "in_progress"; }
        updated = red::push(updated, AgentActivityRow {
            id: target, title: title, full_title: full_title, status: row_status, kind: kind, detail: detail,
        });
        if row_status == "in_progress" || row_status == "pending" { active = title; }
    }
    red::state_patch(AgentState { activity_rows: updated });
    render_activity();
    if active != "" {
        set_phase("tool", active);
    } else if state().streaming {
        set_phase("streaming", "Writing…");
    } else {
        set_phase("working", "Working…");
    }
}

/// Lazily create the current turn's activity timeline block.
fn ensure_activity_block() -> String {
    let block_id = red::string(state().activity_block_id, "");
    if block_id != "" {
        return block_id;
    }
    let generation = red::int(state().block_generation, 0) + 1;
    red::state_patch(AgentState { block_generation: generation });
    block_id = "activity:" + generation;
    red::state_patch(AgentState { activity_block_id: block_id });
    let blocks = state().transcript_blocks;
    blocks = red::push(blocks, AgentTextBlock {
        id: block_id,
        kind: "activity",
        format: "plain",
        text: "",
    });
    red::state_patch(AgentState { transcript_blocks: blocks });
    return block_id;
}

fn activity_glyph(status: String) -> String {
    if status == "completed" {
        return "✓";
    }
    if status == "failed" {
        return "✗";
    }
    if status == "cancelled" { return "−"; }
    return "→";
}

fn activity_details(rows: [AgentActivityRow]) -> String {
    let text = "";
    for row in rows {
        if text != "" { text = text + "\n"; }
        text = text + activity_glyph(row.status) + " " + row.full_title;
        if row.detail != "" { text = text + " · " + row.detail; }
    }
    return text;
}

fn add_activity_count(text: String, count: i32, singular: String, plural: String) -> String {
    if count == 0 { return text; }
    if text != "" { text = text + " · "; }
    if count == 1 { return text + "1 " + singular; }
    return text + count + " " + plural;
}

/// Count all actions, with recoverable issues kept out of the answer text.
fn activity_summary(rows: [AgentActivityRow]) -> String {
    let failed = 0;
    let stopped = 0;
    for row in rows {
        if row.status == "failed" { failed = failed + 1; }
        else if row.status == "cancelled" { stopped = stopped + 1; }
    }
    let text = add_activity_count("Activity", red::len(rows), "action", "actions");
    text = add_activity_count(text, failed, "issue", "issues");
    text = add_activity_count(text, stopped, "stopped", "stopped");
    return text;
}

fn short_activity_row(row: AgentActivityRow) -> String {
    let title = row.title;
    if row.status == "completed" {
        if red::starts_with(title, "Reading ") { title = "Read " + red::slice(title, 8); }
        else if red::starts_with(title, "Editing ") { title = "Edited " + red::slice(title, 8); }
        else if red::starts_with(title, "Creating ") { title = "Created " + red::slice(title, 9); }
        else if red::starts_with(title, "Searching for ") { title = "Searched for " + red::slice(title, 14); }
        else if red::starts_with(title, "Checking language-server status for ") {
            title = "Checked language-server status for " + red::slice(title, 36);
        }
        else if red::starts_with(title, "Checking diagnostics for ") {
            title = "Checked diagnostics for " + red::slice(title, 25);
        }
        else if red::starts_with(title, "Checking rename support for ") {
            title = "Checked rename support for " + red::slice(title, 28);
        }
        else if red::starts_with(title, "Previewing rename in ") {
            title = "Previewed rename in " + red::slice(title, 21);
        }
        else if red::starts_with(title, "Applying language-server edits") {
            title = "Applied language-server edits";
        }
    }
    let reason = "";
    if row.status == "failed" {
        reason = failed_activity_reason(row.detail);
        title = title + " — " + reason;
    }
    return "  " + activity_glyph(row.status) + " " + title;
}

/// Turn bounded tool errors into a useful one-line recovery hint.
///
/// Keep the original detail in the activity inspector; this only controls the
/// compact conversation preview. Matching is case-insensitive so errors from
/// the editor and language servers present consistently.
fn failed_activity_reason(detail: String) -> String {
    let detail = red::lower(detail);
    if red::len(red::split(detail, "outside workspace")) > 1 {
        return "outside workspace";
    }
    if red::len(red::split(detail, "not found")) > 1 {
        return "not found";
    }
    if red::len(red::split(detail, "stale revision")) > 1
        || red::len(red::split(detail, "file changed")) > 1
        || red::len(red::split(detail, "changed since")) > 1
        || red::len(red::split(detail, "revision mismatch")) > 1
        || red::len(red::split(detail, "revision changed")) > 1 {
        return "file changed; reread";
    }
    if red::len(red::split(detail, "timed out")) > 1
        || red::len(red::split(detail, "timeout")) > 1
        || red::len(red::split(detail, "deadline exceeded")) > 1 {
        return "timed out; retry";
    }
    if red::len(red::split(detail, "not ready")) > 1
        || red::len(red::split(detail, "still starting")) > 1
        || red::len(red::split(detail, "server is starting")) > 1 {
        return "not ready; retry";
    }
    if red::len(red::split(detail, "invalid range")) > 1
        || red::len(red::split(detail, "line range")) > 1
        || red::len(red::split(detail, "out of bounds")) > 1
        || red::len(red::split(detail, "must be between")) > 1
        || red::len(red::split(detail, "must be >=")) > 1 {
        return "invalid range";
    }
    if red::len(red::split(detail, "invalid argument")) > 1
        || red::len(red::split(detail, "invalid parameter")) > 1
        || red::len(red::split(detail, "invalid scope")) > 1 {
        return "invalid argument";
    }
    return "failed";
}

/// Keep disclosure small even when the full turn used many tools.
fn activity_preview(rows: [AgentActivityRow]) -> String {
    let text = "";
    let start = red::len(rows) - 5;
    let index = 0;
    for row in rows {
        if index >= start {
            if text != "" { text = text + "\n"; }
            text = text + short_activity_row(row);
        }
        index = index + 1;
    }
    return text + "\n  View all details…";
}

fn remember_activity(block_id: String, rows: [AgentActivityRow]) {
    let history = [];
    let expanded = false;
    for entry in state().activity_history {
        if entry.id == block_id { expanded = entry.expanded; }
        else { history = red::push(history, entry); }
    }
    if red::len(history) >= 100 {
        let bounded = [];
        let index = 0;
        for entry in history {
            if index > 0 { bounded = red::push(bounded, entry); }
            index = index + 1;
        }
        history = bounded;
    }
    history = red::push(history, AgentActivityHistory {
        id: block_id, details: activity_details(rows), rows: rows, expanded: expanded,
    });
    red::state_patch(AgentState { activity_history: history });
}

/// Keep the live transcript bounded; the dedicated status row names the current tool.
fn render_activity() {
    let rows = state().activity_rows;
    if red::len(rows) == 0 { return; }
    let block_id = ensure_activity_block();
    let text = "▸ " + activity_summary(rows);
    remember_activity(block_id, rows);
    let blocks = state().transcript_blocks;
    let updated = [];
    for block in blocks {
        if block.id == block_id {
            block.text = text;
        }
        updated = red::push(updated, block);
    }
    red::state_patch(AgentState { transcript_blocks: updated });
    render_conversation();
}

/// Keep tool details above the answer and elapsed time in a quiet trailing footer.
fn collapse_activity(elapsed_ms: i64) {
    let block_id = red::string(state().activity_block_id, "");
    let blocks = state().transcript_blocks;
    let previous_visible = flat_transcript(blocks);
    red::state_patch(AgentState { activity_block_id: "" });
    let rows = [];
    for row in state().activity_rows {
        if row.status == "in_progress" || row.status == "pending" { row.status = "cancelled"; }
        rows = red::push(rows, row);
    }
    red::state_patch(AgentState { activity_rows: [] });
    red::state_patch(AgentState { thought: "" });
    let elapsed = format_turn_elapsed(elapsed_ms);
    let count = red::len(rows);
    if block_id == "" && count == 0 && elapsed == "" {
        return;
    }
    let updated = [];
    for block in blocks {
        if block_id == "" || block.id != block_id { updated = red::push(updated, block); }
    }
    if count > 0 {
        let summary_id = block_id;
        if summary_id == "" {
            let generation = red::int(state().block_generation, 0) + 1;
            red::state_patch(AgentState { block_generation: generation });
            summary_id = "activity:" + generation;
        }
        remember_activity(summary_id, rows);
        updated = place_activity_summary(blocks, block_id, AgentTextBlock {
            id: summary_id, kind: "activity", format: "plain", text: "▸ " + activity_summary(rows),
        });
    }
    if elapsed != "" {
        let generation = red::int(state().block_generation, 0) + 1;
        red::state_patch(AgentState { block_generation: generation });
        // No history entry: expanding tool activity must not expand the timer.
        updated = red::push(updated, AgentTextBlock {
            id: "activity:" + generation, kind: "activity", format: "plain", text: "Worked for " + elapsed,
        });
    }
    red::state_patch(AgentState { transcript: replace_visible_transcript(previous_visible, flat_transcript(updated)) });
    red::state_patch(AgentState { transcript_blocks: updated });
    render_conversation();
    red::execute("SetStorage", "transcript", state().transcript);
}

/// Preserve the live block's position unless the first tool event arrived after the answer.
fn place_activity_summary(blocks: [AgentTextBlock], block_id: String, summary_block: AgentTextBlock) -> [AgentTextBlock] {
    let anchor = block_id;
    let activity_index = -1;
    let answer_index = -1;
    let answer_id = "";
    let index = 0;
    for block in blocks {
        if block.kind == "user" { answer_index = -1; answer_id = ""; }
        if block.kind == "agent" { answer_index = index; answer_id = block.id; }
        if block.id == block_id && block_id != "" { activity_index = index; }
        index = index + 1;
    }
    if answer_index >= 0 && (activity_index < 0 || activity_index > answer_index) {
        anchor = answer_id;
    }
    let updated = [];
    let inserted = false;
    for block in blocks {
        if !inserted && anchor != "" && block.id == anchor {
            updated = red::push(updated, summary_block);
            inserted = true;
        }
        if block_id == "" || block.id != block_id { updated = red::push(updated, block); }
    }
    if !inserted { updated = red::push(updated, summary_block); }
    return updated;
}

fn format_turn_elapsed(elapsed_ms: i64) -> String {
    let ms = red::int(elapsed_ms, 0);
    if ms <= 0 {
        return "";
    }
    let seconds = ms / 1000;
    if seconds < 1 {
        return "<1s";
    }
    if seconds < 60 {
        return seconds + "s";
    }
    let minutes = seconds / 60;
    let remaining_seconds = seconds - minutes * 60;
    if minutes < 60 {
        return minutes + "m " + remaining_seconds + "s";
    }
    let hours = minutes / 60;
    let remaining_minutes = minutes - hours * 60;
    return hours + "h " + remaining_minutes + "m " + remaining_seconds + "s";
}

#[red::on("panel:event:agent-conversation")]
fn panel_event(event: AgentPanelEvent) {
    if event.action == "filter_input" && state().session_browser_open {
        session_browser_query_changed(red::string(event.text, ""));
    } else if event.action == "filter_submit" && state().session_browser_open {
        let query = red::string(event.text, "");
        session_browser_query_changed(query);
        if query == state().session_browser_results_query
            && red::len(state().session_browser_results) > 0 {
            session_selected(state().session_browser_results[0]);
        }
    } else if event.action == "filter_cancel" && state().session_browser_open {
        close_session_browser();
    } else if event.action == "submit" {
        let text = red::string(event.text, "");
        if red::trim(text) != "" {
            prompt_submitted(text);
        }
    } else if event.action == "composer_focus" {
        red::execute("FocusTextPanelComposer", "agent-conversation");
    } else if event.action == "interrupt" {
        cancel();
    } else if event.action == "model" {
        choose_model();
    } else if event.action == "session_scope" {
        cycle_session_scope();
    } else if event.action == "session_preview" && state().session_browser_open {
        toggle_session_preview();
    } else if (event.action == "up" || event.action == "down") && state().session_browser_open {
        session_browser_selection_changed(event.text);
    } else if event.action == "sessions" {
        choose_session();
    } else if event.action == "activity" {
        toggle_activity();
    } else if event.action == "activate_block" && red::starts_with(event.text, "interruption-choice:") {
        let choice = red::slice(event.text, red::len("interruption-choice:"));
        if choice != "hint" { resolve_interruption(choice); }
    } else if event.action == "activate_block" {
        if state().session_browser_open {
            activate_session_browser_block(event.text);
        } else {
            activate_activity_block(event.text);
        }
    } else if event.action == "clear" {
        clear_conversation();
    } else if event.action == "new" {
        new_conversation();
    } else if event.action == "history" {
        history();
    } else if event.action == "close" {
        close_conversation();
    } else if event.action == "view" {
        // A compact pane on a narrow terminal steps aside while the editor has
        // focus; it is still open, so completion notices must say where it went.
        red::state_patch(AgentState { panel_in_view: red::string(event.text, "visible") != "hidden" });
    }
}

#[red::command(
    name = "AgentActivity",
    title = "Toggle agent activity details",
    category = "Agent",
    description = "Expand or collapse tool activity in the conversation",
    scope = "global",
)]
fn toggle_activity() {
    if state().session_browser_open { close_session_browser(); }
    let history = state().activity_history;
    if red::len(history) > 0 { activate_activity_block(history[red::len(history) - 1].id); }
    else { render_conversation(); }
}

fn activate_activity_block(block_id: String) {
    let history = [];
    for entry in state().activity_history {
        if block_id == "activity-details:" + entry.id {
            open_activity_details(entry.id);
            return;
        }
        if entry.id == block_id { entry.expanded = !entry.expanded; }
        history = red::push(history, entry);
    }
    red::state_patch(AgentState { activity_history: history });
    render_conversation();
}

fn activity_row_detail(row: AgentActivityRow) -> [[PanelSegment]] {
    let detail = [[PanelSegment { text: row.full_title, style: heading_style() }],
        [PanelSegment { text: row.status, style: muted_style() }]];
    if row.detail != "" {
        detail = red::push(detail, [PanelSegment { text: row.detail, style: normal_style() }]);
    }
    return detail;
}

fn open_activity_details(block_id: String) {
    red::state_patch(AgentState { activity_inspector_id: block_id });
    for entry in state().activity_history {
        if entry.id == block_id && red::len(entry.rows) > 0 {
            red::state_patch(AgentState { activity_inspector_detail: activity_row_detail(entry.rows[0]) });
        }
    }
    red::execute("OpenWorkspace", "agent-activity", WorkspaceConfig {
        title: "Agent activity", detail_ratio: 58, min_two_pane_width: 88,
    });
    render_activity_inspector();
}

fn render_activity_inspector() {
    let rows = [];
    for entry in state().activity_history {
        if entry.id == state().activity_inspector_id {
            let index = 0;
            for row in entry.rows {
                rows = red::push(rows, WorkspaceRow {
                    id: "tool:" + index, selectable: true,
                    segments: [PanelSegment { text: short_activity_row(row), style: normal_style() }],
                    data: row,
                });
                index = index + 1;
            }
        }
    }
    red::execute("UpdateWorkspace", "agent-activity", WorkspaceModel {
        rows: rows, detail: state().activity_inspector_detail,
    });
}

#[red::on("workspace:event:agent-activity")]
fn activity_inspector_event(event: AgentActivityWorkspaceEvent) {
    if event.action == "q" || event.action == "escape" {
        red::execute("CloseWorkspace", "agent-activity");
        red::state_patch(AgentState { activity_inspector_id: "" });
        return;
    }
    if event.row != red::null() && event.row.data != red::null() {
        red::state_patch(AgentState { activity_inspector_detail: activity_row_detail(event.row.data) });
        render_activity_inspector();
    }
}

#[red::command(
    name = "AgentClear",
    title = "Clear agent conversation",
    category = "Agent",
    description = "Clear the visible conversation while preserving context",
    aliases = ["clear chat"],
    scope = "global",
)]
fn clear_conversation() {
    if state().session_browser_open { close_session_browser(); }
    reset_stream_render();
    red::state_patch(AgentState { transcript_blocks: [] });
    red::state_patch(AgentState { activity_block_id: "" });
    red::state_patch(AgentState { activity_rows: [] });
    red::state_patch(AgentState { activity_history: [] });
    red::state_patch(AgentState { thought: "" });
    // Queued messages still run after a Clear, so they stay visible.
    red::execute("UpdateTextPanel", "agent-conversation", with_unsent_prompts([]));
    red::execute("SetTextPanelComposerState", "agent-conversation", true, "Conversation view cleared · context preserved");
}

fn reset_stream_render() {
    let timer = red::string(state().stream_timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
        red::state_patch(AgentState { stream_timer: "" });
    }
    red::state_patch(AgentState { streaming: false });
    red::state_patch(AgentState { stream_block_id: "" });
    red::state_patch(AgentState { stream_delta: "" });
    red::state_patch(AgentState { stream_trimmed: false });
}

#[red::command(
    name = "AgentClose",
    title = "Close agent conversation",
    category = "Agent",
    description = "Hide the conversation pane without ending the session",
    aliases = ["hide chat"],
    scope = "global",
)]
fn close_conversation() {
    if state().session_browser_open { close_session_browser(); }
    if state().panel_open {
        red::execute("SetPanelVisible", "agent-conversation", false);
        red::state_patch(AgentState { panel_open: false });
    }
    red::execute("FocusEditor");
}

#[red::command(
    name = "AgentStart",
    title = "Start agent session",
    category = "Agent",
    description = "Start a new agent conversation",
    aliases = ["new chat"],
    scope = "global",
)]
#[red::command(
    name = "AgentNew",
    title = "Start new agent conversation",
    category = "Agent",
    description = "Reset the session and start a new conversation",
    aliases = ["new conversation"],
    scope = "global",
)]
fn new_conversation() {
    if state().session_browser_open { close_session_browser(); }
    if state().session_switch_target != "" {
        red::execute("Print", "Wait for the selected Agent session to finish restoring");
        return;
    }
    resolve_agent_issue();
    reset_model_state();
    red::state_patch(AgentState { resume_hint: "", resume_age: "", interruption_id: "" });
    // The saved thread is about to be forgotten; opening the pane must not
    // resume it first.
    let pane = state().pane;
    pane.resume_pending = false;
    red::state_patch(AgentState { pane: pane });
    set_phase("idle", "");
    clear_conversation();
    red::state_patch(AgentState { transcript: "" });
    red::execute("SetStorage", "transcript", "");
    red::execute("ClearTextPanelComposer", "agent-conversation");
    open_conversation();
    render_conversation();
    red::execute("SetTextPanelComposerState", "agent-conversation", true, "");
    load_default_model();
    // The core forgets the old thread and starts the next one right away.
    red::execute("AgentReset", true);
}

fn prompt_cancelled(event: ComposerCancelled) {}

#[red::command(
    name = "AgentCancel",
    title = "Cancel agent request",
    category = "Agent",
    description = "Cancel the active agent request",
    aliases = ["stop agent"],
    scope = "global",
)]
fn cancel() {
    red::execute("AgentStop");
}

#[red::on("agent:update")]
fn update(event: AgentTextEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    let delta = red::string(event.text, "");
    if delta == "" {
        return;
    }

    let transcript = state().transcript;
    let block_id = red::string(state().stream_block_id, "");
    if !state().streaming {
        if transcript != "" && !red::ends_with(transcript, "\n") {
            transcript = transcript + "\n";
        }
        transcript = transcript + "Agent: ";

        let generation = red::int(state().block_generation, 0) + 1;
        block_id = "agent:" + generation;
        red::state_patch(AgentState { block_generation: generation });
        red::state_patch(AgentState { streaming: true });
        red::state_patch(AgentState { stream_block_id: block_id });

        let blocks = state().transcript_blocks;
        blocks = red::push(blocks, AgentTextBlock {
            id: block_id,
            kind: "agent",
            format: "markdown",
            text: "",
        });
        red::state_patch(AgentState { transcript_blocks: blocks });
        render_conversation();
        set_phase("streaming", "Writing…");
    }

    transcript = transcript + delta;
    red::state_patch(AgentState { transcript: transcript });

    let blocks = state().transcript_blocks;
    let updated = [];
    for block in blocks {
        if block.id == block_id {
            block.text = red::string(block.text, "") + delta;
        }
        updated = red::push(updated, block);
    }
    red::state_patch(AgentState { transcript_blocks: updated });
    red::state_patch(AgentState { stream_delta: red::string(state().stream_delta, "") + delta });

    let timer = red::string(state().stream_timer, "");
    if timer == "" {
        red::state_patch(AgentState { stream_timer: red::execute("SetTimeout", 50) });
    }
}

#[red::on("agent:message_completed")]
fn message_completed(event: AgentTextEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    let text = red::string(event.text, "");
    if !state().streaming {
        update(event);
    }
    let block_id = red::string(state().stream_block_id, "");
    let blocks = state().transcript_blocks;
    let previous_visible = flat_transcript(blocks);
    let updated = [];
    for block in blocks {
        if block.id == block_id {
            block.text = text;
        }
        updated = red::push(updated, block);
    }
    red::state_patch(AgentState { transcript_blocks: updated });
    red::state_patch(AgentState { transcript: replace_visible_transcript(previous_visible, flat_transcript(updated)) });
    red::state_patch(AgentState { stream_delta: "" });
    red::state_patch(AgentState { stream_trimmed: false });
    render_conversation();
    finish_agent_message();
    set_phase("working", "Working…");
}

/// Replace the visible suffix without discarding context hidden by AgentClear.
fn replace_visible_transcript(previous: String, updated: String) -> String {
    let transcript = state().transcript;
    if transcript != "" && !red::ends_with(transcript, "\n") { transcript = transcript + "\n"; }
    if previous == "" { return transcript + updated; }
    if red::ends_with(transcript, previous) {
        return red::slice(transcript, 0, red::len(transcript) - red::len(previous)) + updated;
    }
    return updated;
}

fn flat_transcript(blocks: [AgentTextBlock]) -> String {
    let transcript = "";
    for block in blocks {
        // Live progress is presentation-only; completion saves the summary and footer.
        if block.id != "" && block.id == state().activity_block_id { continue; }
        // Interruption choices and the resume divider are not conversation.
        if red::starts_with(block.id, "interruption-choice:") || block.id == "resume-notice" { continue; }
        let text = red::string(block.text, "");
        if text == "" {
            continue;
        }
        let label = "System";
        if block.kind == "user" {
            label = "You";
        } else if block.kind == "agent" {
            label = "Agent";
        } else if block.kind == "error" {
            label = "Error";
        } else if block.kind == "activity" {
            label = "Activity";
        }
        transcript = transcript + label + ": " + text + "\n";
    }
    return transcript;
}

#[red::on("agent:completed")]
fn completed(event: AgentCompletedEvent) {
    if !is_current_session(event.session_id) || is_stale_turn(event.turn_id) {
        return;
    }
    resolve_agent_issue();
    let stop_reason = red::string(event.stop_reason, "end_turn");
    if stop_reason == "end_turn" || stop_reason == "completed" {
        finish_agent_turn();
    }
    collapse_activity(event.elapsed_ms);
    set_phase("idle", "");
    if stop_reason == "end_turn" || stop_reason == "completed" {
        if !state().panel_open || !state().panel_in_view {
            red::execute("Print", "Agent finished · Space A to view");
        }
        return;
    }
    if stop_reason == "interrupted" || stop_reason == "cancelled" {
        append_transcript("System", "Stopped at your request.");
        red::execute("Print", "Agent stopped");
        return;
    }
    append_transcript("System", "Agent stopped: " + stop_reason);
    red::execute("Print", "Agent stopped: " + stop_reason);
}

#[red::command(
    name = "AgentSendQueued",
    title = "Send queued agent follow-ups",
    category = "Agent",
    description = "Resume follow-ups held after a stopped or failed turn",
    aliases = ["resume agent queue"],
    scope = "global",
)]
fn send_queued() {
    if queued_count() == 0 {
        red::execute("Print", "Nothing is queued");
        return;
    }
    red::execute("AgentSendQueued", red::string(state().transcript, ""));
}

#[red::command(
    name = "AgentDiscardQueued",
    title = "Discard queued agent follow-ups",
    category = "Agent",
    description = "Drop follow-ups that have not been sent to the agent",
    aliases = ["clear agent queue"],
    scope = "global",
)]
fn discard_queued() {
    resolve_agent_issue();
    let count = queued_count();
    red::execute("AgentDiscardQueued");
    if count == 1 {
        red::execute("Print", "Dropped 1 queued follow-up");
    } else {
        red::execute("Print", "Dropped " + count + " queued follow-ups");
    }
}

#[red::on("agent:cancelled")]
fn cancelled(event: AgentSessionEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    red::execute("Print", "Stopping the agent…");
}

/// Codex refused the interrupt, so the turn keeps running; say so and let the
/// user retry instead of leaving the pane stuck on "Stopping…".
#[red::on("agent:cancel_failed")]
fn cancel_failed(event: AgentErrorEvent) {
    if !is_current_session(red::string(event.session_id, "")) {
        return;
    }
    report_agent_issue("Could not stop the agent: " + event.message + " · press Ctrl-C to try again");
}

#[red::on("agent:error")]
fn failed(event: AgentErrorEvent) {
    if !is_current_session(red::string(event.session_id, "")) || is_stale_turn(event.turn_id) {
        return;
    }
    if red::string(event.session_id, "") == "" && turn_running() {
        red::execute("Print", "Agent setup failed while a turn is active: " + event.message);
        return;
    }
    ensure_conversation_panel();
    collapse_activity(red::null());
    set_phase("idle", "");
    append_transcript("Error", event.message);
    if red::string(state().session_id, "") == "" {
        // The core kept any unsent message queued and paused; retry resumes it.
        let has_pending_prompt = queued_count() > 0;
        let notice = "Codex unavailable: " + event.message;
        if has_pending_prompt {
            notice = notice + ". Your prompt is preserved";
        }
        report_agent_issue(notice);
        let retry_label = "Retry Codex startup";
        if has_pending_prompt {
            retry_label = "Retry the saved prompt";
        }
        red::execute("OpenPicker", "Retry Codex", [
            PickerItem { id: "retry", label: retry_label, kind: "Action" },
            PickerItem { id: "logs", label: "Open Red logs", kind: "Diagnostics" },
        ], PickerOptions {
            placeholder: "Inspect the error in the Agent pane or choose an action",
            status: "Enter selects · Escape keeps the diagnostic visible",
            presentation: "compact",
        }, PickerHandlers {
            selected: setup_selected,
            cancelled: setup_cancelled,
        });
    } else {
        report_agent_issue("Agent error: " + event.message);
    }
}

#[red::on("agent:session_lost")]
fn session_lost(event: AgentSessionLostEvent) {
    let session_id = red::string(state().session_id, "");
    let attempted = red::string(event.prompt, "");
    let message = red::string(event.message, "Codex app-server stopped");
    if !is_current_session(red::string(event.session_id, "")) && (session_id != "" || attempted == "") {
        return;
    }
    red::state_patch(AgentState { codex_lost: true });
    invalidate_model_catalog();
    collapse_activity(red::null());
    set_phase("idle", "");
    if session_id != "" {
        red::execute("AgentArchiveSession", session_id);
    }
    reset_model_state();
    if attempted != "" {
        // The core retries a message that never reached Codex in a new thread.
        red::execute("Print", message + "; retrying the saved prompt");
    } else {
        failed(AgentErrorEvent { session_id: "", message: message });
    }
}

fn setup_selected(item: PickerItem) {
    if item.id == "retry" {
        if queued_count() > 0 {
            red::execute("AgentSendQueued", red::string(state().transcript, ""));
        } else {
            red::execute("AgentReset", true);
        }
    } else if item.id == "logs" {
        red::execute("ViewLogs");
    }
}

fn setup_cancelled(event: PickerCancelled) {
    report_agent_issue("Agent prompt saved · :AgentSendQueued retries it");
}

#[red::on("agent:credential_ready")]
#[red::on("agent:backend_ready")]
fn setup_ready(event: EmptyEvent) {
    invalidate_model_catalog();
    if state().panel_created { prefetch_models(); }
    if queued_count() > 0 && red::string(state().session_id, "") == "" {
        red::execute("AgentSendQueued", red::string(state().transcript, ""));
    }
}

fn finish_agent_turn() {
    red::state_patch(AgentState { turn_model_info: Json {} });
    refresh_model_header();
    finish_agent_message();
}

/// Each app-server message is a separate block, even within the same turn.
fn finish_agent_message() {
    if !state().streaming {
        return;
    }
    let transcript = state().transcript;
    if !red::ends_with(transcript, "\n") {
        transcript = transcript + "\n";
    }
    red::state_patch(AgentState { transcript: transcript });
    red::state_patch(AgentState { streaming: false });
    let block_id = red::string(state().stream_block_id, "");
    red::state_patch(AgentState { stream_block_id: "" });
    let timer = red::string(state().stream_timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
        red::state_patch(AgentState { stream_timer: "" });
    }
    red::execute("SetStorage", "transcript", transcript);
    flush_stream(block_id);
}

fn append_transcript(role: String, text: String) {
    append_transcript_block(role, text, "");
    red::execute("SetStorage", "transcript", state().transcript);
}

fn append_transcript_block(role: String, text: String, block_id: String) {
    let transcript = state().transcript;
    if state().streaming {
        if !red::ends_with(transcript, "\n") {
            transcript = transcript + "\n";
        }
        red::state_patch(AgentState { streaming: false });
        let timer = red::string(state().stream_timer, "");
        if timer != "" {
            red::execute("CancelTimeout", timer);
            red::state_patch(AgentState { stream_timer: "" });
        }
        red::state_patch(AgentState { stream_block_id: "" });
        red::state_patch(AgentState { stream_delta: "" });
        red::state_patch(AgentState { stream_trimmed: false });
    }
    transcript = transcript + role + ": " + text + "\n";
    red::state_patch(AgentState { transcript: transcript });

    let kind = "text";
    if role == "You" {
        kind = "user";
    } else if role == "Error" {
        kind = "error";
    }
    if block_id == "" {
        let generation = red::int(state().block_generation, 0) + 1;
        red::state_patch(AgentState { block_generation: generation });
        block_id = kind + ":" + generation;
    }
    let blocks = state().transcript_blocks;
    blocks = red::push(blocks, AgentTextBlock {
        id: block_id,
        kind: kind,
        format: "plain",
        text: text,
    });
    red::state_patch(AgentState { transcript_blocks: blocks });
    render_conversation();
}

#[red::on("timeout:callback")]
fn stream_timeout(event: TimerEvent) {
    if event.timer_id != state().stream_timer {
        return;
    }
    red::state_patch(AgentState { stream_timer: "" });
    red::execute("SetStorage", "transcript", state().transcript);
    flush_stream(red::string(state().stream_block_id, ""));
}

fn flush_stream(block_id: String) {
    let delta = red::string(state().stream_delta, "");
    let trimmed = state().stream_trimmed;
    red::state_patch(AgentState { stream_delta: "" });
    red::state_patch(AgentState { stream_trimmed: false });
    if trimmed {
        render_conversation();
    } else if delta != "" {
        red::execute("AppendTextPanel", "agent-conversation", block_id, delta);
    }
}

#[red::on("agent:transcript_restored")]
fn transcript_restored(event: AgentTranscriptEvent) {
    red::state_patch(AgentState { activity_history: [] });
    let transcript = red::string(event.transcript, "");
    let blocks = legacy_transcript_blocks(transcript);
    let generation = red::len(blocks);
    red::state_patch(AgentState { transcript: transcript });
    red::state_patch(AgentState { transcript_blocks: blocks });
    red::state_patch(AgentState { block_generation: generation });
    red::state_patch(AgentState { streaming: false });
    red::state_patch(AgentState { stream_block_id: "" });
    red::state_patch(AgentState { stream_delta: "" });
    red::state_patch(AgentState { stream_trimmed: false });
    render_conversation();
}

/// Whether the pane already shows this thread, as after Codex restarts under a
/// running editor. Its transcript then stays: it holds partial replies and
/// activity that Codex's saved history does not.
fn shows_thread(thread_id: String) -> bool {
    // A transcript saved by an earlier launch may be stale; Codex's copy wins.
    return thread_id != "" && red::string(state().session_id, "") == thread_id
        && red::len(state().transcript_blocks) > 0 && state().resume_age == "";
}

/// The quiet divider between an earlier session's messages and this one.
fn push_resume_divider(age: String) {
    let blocks = state().transcript_blocks;
    blocks = red::push(blocks, AgentTextBlock {
        id: "resume-notice", kind: "activity", format: "plain",
        text: "↺ Picked up where you left off " + age,
    });
    red::state_patch(AgentState { transcript_blocks: blocks });
    render_conversation();
}

#[red::on("agent:conversation_restore_pending")]
fn conversation_restore_pending(event: AgentConversationEvent) {
    // The core resumes the thread; the pane shows the saved conversation meanwhile.
    // A bridge restart abandons any session switch that had not completed.
    red::state_patch(AgentState { session_switch_target: "" });
    red::state_patch(AgentState { model_info: event.model_info, accepted_model: Json {}, turn_model_info: Json {} });
    if shows_thread(event.thread_id) {
        // Codex stopped under us. Keep what streamed so far; the core marks a
        // running turn as interrupted and the notice follows with the snapshot.
        red::state_patch(AgentState { codex_lost: true });
        finish_agent_message();
        collapse_activity(red::null());
    } else {
        load_conversation(event);
    }
    red::state_patch(AgentState { activity_block_id: "" });
    red::state_patch(AgentState { activity_rows: [] });
    red::state_patch(AgentState { thought: "" });
    ensure_conversation_panel();
    refresh_model_header();
    red::execute("SetTextPanelComposerState", "agent-conversation", true, "Reconnecting to Codex… you can keep typing");
}

#[red::on("agent:conversation_resumable")]
fn conversation_resumable(event: AgentResumableEvent) {
    // Saved by an earlier launch. The core resumes the thread when the pane
    // opens or the next message is sent.
    red::state_patch(AgentState { model_info: event.model_info, accepted_model: Json {}, turn_model_info: Json {} });
    load_conversation(AgentConversationEvent {
        thread_id: event.thread_id, cwd: event.cwd, model_info: event.model_info, items: event.items,
    });
    let age = red::string(event.age, "earlier");
    red::state_patch(AgentState { resume_hint: "Continuing · :AgentNew starts fresh", resume_age: age });
    push_resume_divider(age);
    if state().panel_created {
        red::execute("SetTextPanelComposerState", "agent-conversation", true, state().resume_hint);
    }
    refresh_model_header();
}

#[red::on("agent:session_restored")]
fn session_restored(event: AgentConversationEvent) {
    let switching = state().session_switch_target != "";
    // An interruption from the loss was already shown; a later failure is not one.
    red::state_patch(AgentState { codex_lost: false });
    red::state_patch(AgentState { model_info: event.model_info, accepted_model: Json {}, turn_model_info: Json {} });
    if switching {
        red::state_patch(AgentState { resume_hint: "", resume_age: "" });
    }
    if !shows_thread(event.thread_id) {
        let age = state().resume_age;
        load_conversation(event);
        if age != "" {
            red::state_patch(AgentState { resume_age: "" });
            push_resume_divider(age);
        }
    }
    red::state_patch(AgentState { session_switch_target: "" });
    set_phase("idle", "");
    red::execute("SetTextPanelComposerState", "agent-conversation", true, state().resume_hint);
    refresh_model_header();
    if switching {
        red::execute("Print", "Agent session restored");
    }
}

/// What the composer says once the thread settles: archived after a failed
/// resume, continuing after a successful one from an earlier launch.
fn ready_composer_hint() -> String {
    if red::string(state().session_id, "") == "" && state().pane.recap_pending {
        return "Archived conversation · next message starts a new session";
    }
    return state().resume_hint;
}

/// Resumes a saved conversation as soon as the pane is about to be used.
fn prepare_saved_conversation() {
    if state().pane.resume_pending {
        red::execute("AgentPrepare");
    }
    if state().resume_hint != "" && state().panel_created {
        red::execute("SetTextPanelComposerState", "agent-conversation", true, state().resume_hint);
    }
}

/// Shows or retires the notice for a reply Codex cut short.
fn sync_interruption() {
    let shown = state().interruption_id;
    let current = "";
    let text = "";
    if let Some(prompt) = state().pane.interrupted {
        current = prompt.id;
        text = prompt.text;
    }
    if current == shown {
        return;
    }
    if shown != "" {
        // Answered: the choices go, the notice stays as history.
        let kept = [];
        for block in state().transcript_blocks {
            if !red::starts_with(block.id, "interruption-choice:") { kept = red::push(kept, block); }
        }
        red::state_patch(AgentState { transcript_blocks: kept, interruption_id: "" });
        render_conversation();
    }
    if current != "" {
        show_interruption(current);
    }
}

fn show_interruption(prompt_id: String) {
    finish_agent_message();
    collapse_activity(red::null());
    set_phase("idle", "");
    let lost_codex = state().codex_lost;
    red::state_patch(AgentState { interruption_id: prompt_id, codex_lost: false, interruption_lost_codex: lost_codex });
    let queued = queued_count();
    if lost_codex {
        let notice = "Codex stopped before finishing this reply. The conversation is saved and edits it already made are still applied. Nothing more will be sent until you choose what to do.";
        if queued > 0 {
            notice = notice + " (" + queued + " queued follow-up(s) are waiting.)";
        }
        append_transcript_block("Error", notice, "interruption:" + prompt_id);
    }
    // A turn that failed while Codex kept running already shows its error;
    // it only needs the way forward.
    let blocks = state().transcript_blocks;
    blocks = red::push(blocks, AgentTextBlock {
        id: "interruption-choice:retry", kind: "action", format: "plain", text: "↻ Retry the message",
    });
    blocks = red::push(blocks, AgentTextBlock {
        id: "interruption-choice:continue", kind: "action", format: "plain", text: "→ Ask Codex to continue where it stopped",
    });
    blocks = red::push(blocks, AgentTextBlock {
        id: "interruption-choice:dismiss", kind: "action", format: "plain", text: "✕ Leave it here",
    });
    blocks = red::push(blocks, AgentTextBlock {
        id: "interruption-choice:hint", kind: "activity", format: "plain", text: "Tab, then ]l to a choice and Enter · or :AgentRecover · or type a new message",
    });
    red::state_patch(AgentState { transcript_blocks: blocks });
    render_conversation();
    red::execute("SetStorage", "transcript", state().transcript);
    if lost_codex {
        report_agent_issue("Codex stopped mid-reply · Space A to choose what to do");
    }
}

#[red::command(
    name = "AgentRecover",
    title = "Recover an interrupted agent reply",
    category = "Agent",
    description = "Retry, continue, or leave a reply that Codex stopped in the middle of",
    aliases = ["retry agent", "continue agent"],
    scope = "global",
)]
fn choose_interruption() {
    if state().interruption_id == "" {
        red::execute("Print", "No interrupted agent reply");
        return;
    }
    red::execute("OpenPicker", "Codex stopped mid-reply", [
        PickerItem { id: "retry", label: "Retry the message", kind: "Resend" },
        PickerItem { id: "continue", label: "Continue where it stopped", kind: "Resume" },
        PickerItem { id: "dismiss", label: "Leave it here", kind: "Keep" },
    ], PickerOptions {
        placeholder: "What should happen with the cut-off reply?",
        status: "Edits it already made stay applied · Escape decides later",
        presentation: "compact",
    }, PickerHandlers {
        selected: interruption_selected,
        cancelled: interruption_cancelled,
    });
}

fn interruption_selected(item: PickerItem) {
    resolve_interruption(item.id);
}

fn interruption_cancelled(event: PickerCancelled) {
    red::execute("Print", "Interrupted reply kept · :AgentRecover decides later");
}

fn resolve_interruption(choice: String) {
    if state().interruption_id == "" {
        return;
    }
    resolve_agent_issue();
    red::execute("AgentResolveInterruption", choice, red::string(state().transcript, ""));
    if choice == "dismiss" {
        let message = "Left the interrupted reply as it is";
        if queued_count() > 0 {
            message = message + " · " + queued_count() + " queued · :AgentSendQueued sends them";
        }
        red::execute("Print", message);
    }
}

struct AgentSessionRestoreFailedEvent {
    session_id: String,
    message: String,
}

#[red::on("agent:session_restore_failed")]
fn session_restore_failed(event: AgentSessionRestoreFailedEvent) {
    if state().session_switch_target != "" && event.session_id == state().session_switch_target {
        red::state_patch(AgentState { session_switch_target: "" });
        set_phase("idle", "");
        red::execute("SetTextPanelComposerState", "agent-conversation", true, ready_composer_hint());
        refresh_model_header();
        red::execute("Print", "Could not switch Agent sessions: " + event.message);
        return;
    }
    // A thread the pane already left, as after :AgentNew, failing late is not
    // this conversation's business.
    let failed = red::string(event.session_id, "");
    if failed != "" && failed != red::string(state().session_id, "") {
        return;
    }
    // The next message starts a recap-seeded thread, not a continuation.
    red::state_patch(AgentState { resume_age: "", resume_hint: "" });
    // The core forgets the thread and replays the transcript on the next message.
    reset_model_state();
    ensure_conversation_panel();
    set_phase("idle", "");
    red::execute("SetTextPanelComposerState", "agent-conversation", true, "Archived conversation · next message starts a new session");
    red::execute("Print", "Agent session could not be restored: " + event.message);
}

fn load_conversation(event: AgentConversationEvent) {
    red::state_patch(AgentState { activity_history: [] });
    let transcript = "";
    let blocks = [];
    let generation = 0;
    for item in event.items {
        let role = red::string(item.role, "agent");
        let kind = "agent";
        let label = "Agent";
        let format = "markdown";
        if role == "user" {
            kind = "user";
            label = "You";
            format = "plain";
        }
        transcript = transcript + label + ": " + red::string(item.text, "") + "\n";
        generation = generation + 1;
        blocks = red::push(blocks, AgentTextBlock {
            id: red::string(item.id, kind + ":" + generation),
            kind: kind,
            format: format,
            text: red::string(item.text, ""),
        });
    }
    red::state_patch(AgentState { transcript: transcript });
    red::state_patch(AgentState { transcript_blocks: blocks });
    red::state_patch(AgentState { block_generation: generation });
    reset_stream_render();
    render_conversation();
    red::execute("SetStorage", "transcript", transcript);
}

fn render_conversation() {
    if state().session_browser_open { return; }
    let blocks = normalize_transcript_blocks(state().transcript_blocks);
    red::state_patch(AgentState { transcript_blocks: blocks });
    let presented = [];
    for block in blocks {
        let preview = "";
        if block.kind == "activity" {
            for entry in state().activity_history {
                if entry.id == block.id {
                    block.kind = "action";
                    if entry.expanded {
                        block.text = "▾ " + red::slice(block.text, 2);
                        preview = activity_preview(entry.rows);
                    }
                }
            }
        }
        presented = red::push(presented, block);
        if preview != "" {
            presented = red::push(presented, AgentTextBlock {
                id: "activity-details:" + block.id, kind: "action", format: "plain", text: preview,
            });
        }
    }
    blocks = presented;
    // Messages the core has not sent yet render below the conversation. A prompt
    // returned for retry after a lost session is already in the transcript.
    blocks = with_unsent_prompts(blocks);
    if red::len(blocks) == 0 {
        blocks = [AgentTextBlock {
            id: "empty",
            kind: "activity",
            format: "plain",
            text: "Ask about this workspace, or ask for a change.\n\nEnter sends · Ctrl+J adds a line · Ctrl+P recalls\nCtrl+C stops a turn · follow-ups queue up\nOne u undoes an agent edit · :AgentHistory lists them",
        }];
    }
    red::execute("UpdateTextPanel", "agent-conversation", blocks);
    // Full replacement already contains pending deltas; never append them twice.
    red::state_patch(AgentState { stream_delta: "", stream_trimmed: false });
}

/// Appends messages the core has not sent yet. One held behind a running turn
/// or a paused queue is drawn dimmed; only the first message, sent while a
/// thread starts, already looks sent, and anything typed after it waits its turn.
fn with_unsent_prompts(blocks: [AgentTextBlock]) -> [AgentTextBlock] {
    let held = turn_running() || state().pane.paused;
    let position = 0;
    for prompt in state().pane.queued {
        let shown = false;
        for block in blocks {
            if block.id == prompt.id { shown = true; }
        }
        if !shown {
            let kind = "user";
            if held || position > 0 { kind = "queued"; }
            blocks = red::push(blocks, AgentTextBlock {
                id: prompt.id, kind: kind, format: "plain", text: prompt.text,
            });
        }
        position = position + 1;
    }
    return blocks;
}

/// Normalize blocks from live, migrated, and restored state before they reach the panel.
fn normalize_transcript_blocks(blocks: [AgentTextBlock]) -> [AgentTextBlock] {
    let normalized = [];
    for block in blocks {
        let kind = red::string(block.kind, "text");
        let format = "plain";
        if kind == "agent" {
            format = "markdown";
        }
        normalized = red::push(normalized, AgentTextBlock {
            id: red::string(block.id, ""),
            kind: kind,
            format: format,
            text: red::string(block.text, ""),
        });
    }
    return normalized;
}

fn legacy_transcript_blocks(transcript: String) -> [AgentTextBlock] {
    let blocks: [AgentTextBlock] = [];
    let index = 0;
    let kind = "";
    let format = "plain";
    let text = "";
    let lines = red::split(transcript, "\n");
    let line_index = 0;
    // Older flat transcripts were capped by slicing their first characters. If
    // that removed the leading role marker, infer the truncated fragment from
    // the next intact turn: a following user turn means the fragment was the
    // preceding agent response, while a following agent turn means it was the
    // preceding user prompt. Agent is the safer fallback for a lone fragment
    // because responses are normally much larger than prompts.
    let leading_kind = "agent";
    let leading_format = "markdown";
    for line in lines {
        if red::starts_with(line, "You: ") {
            break;
        }
        if red::starts_with(line, "Agent: ") {
            leading_kind = "user";
            leading_format = "plain";
            break;
        }
        if red::starts_with(line, "Error: ")
            || red::starts_with(line, "Activity: ")
            || red::starts_with(line, "System: ") {
            break;
        }
    }

    for line in lines {
        line_index = line_index + 1;
        if line == "" && line_index == red::len(lines) {
            continue;
        }
        if line == "System: Agent stopped: end_turn" {
            continue;
        }

        let next_kind = "";
        let next_format = "plain";
        let prefix = 0;
        if red::starts_with(line, "You: ") {
            next_kind = "user";
            prefix = 5;
        } else if red::starts_with(line, "Agent: ") {
            next_kind = "agent";
            next_format = "markdown";
            prefix = 7;
        } else if red::starts_with(line, "Error: ") {
            next_kind = "error";
            prefix = 7;
        } else if red::starts_with(line, "Activity: ") {
            next_kind = "activity";
            prefix = 10;
        } else if red::starts_with(line, "System: ") {
            next_kind = "text";
            prefix = 8;
        }

        if next_kind != "" {
            if kind != "" {
                blocks = red::push(blocks, AgentTextBlock {
                    id: kind + ":" + index,
                    kind: kind,
                    format: format,
                    text: text,
                });
            }
            index = index + 1;
            kind = next_kind;
            format = next_format;
            text = red::slice(line, prefix);
        } else {
            if kind == "" {
                index = index + 1;
                kind = leading_kind;
                format = leading_format;
            } else {
                text = text + "\n";
            }
            text = text + line;
        }
    }

    if kind != "" {
        blocks = red::push(blocks, AgentTextBlock {
            id: kind + ":" + index,
            kind: kind,
            format: format,
            text: text,
        });
    }
    return blocks;
}

#[red::command(
    name = "AgentHistory",
    title = "Show agent history",
    category = "Agent",
    description = "Inspect previous agent transactions",
    aliases = ["transactions"],
    scope = "global",
)]
fn history() {
    red::state_patch(AgentState { history_open: true });
    red::state_patch(AgentState { history_selected: "" });
    red::execute("OpenWorkspace", "agent-history", WorkspaceConfig {
        title: "Edit history",
        detail_ratio: 56,
        min_two_pane_width: 88,
        detail_wrap: false,
    });
    refresh_history();
}

fn refresh_history() {
    if state().history_open {
        red::request("EditHistory", render_history, "workspace");
    }
}

fn history_title(entry: AgentHistoryEntry) -> String {
    let title = entry.file;
    if entry.origin.kind == "agent" {
        title = title + " · Agent";
        if let Some(turn) = entry.turn { title = title + ", turn " + turn; }
        if let Some(prompt) = entry.prompt {
            if prompt != "" { title = title + " · “" + prompt + "”"; }
        }
    } else if entry.origin.kind == "plugin" {
        title = title + " · " + red::string(entry.origin.name, "plugin");
    } else {
        title = title + " · You";
    }
    return title + " · " + entry.age;
}

fn history_row(entry: AgentHistoryEntry) -> Json {
    let by_agent = entry.origin.kind == "agent";
    let glyph = "· ";
    let who = "you";
    if by_agent {
        // The glyph already says "agent"; the turn says which request.
        glyph = "◆ ";
        who = "agent";
        if let Some(turn) = entry.turn { who = "turn " + turn; }
    } else if entry.origin.kind == "plugin" {
        who = red::string(entry.origin.name, "plugin");
    }
    let change = "";
    if entry.added > 0 { change = "+" + entry.added; }
    if entry.removed > 0 {
        if change != "" { change = change + " "; }
        change = change + "−" + entry.removed;
    }
    let right = [PanelSegment { text: who + " · " + entry.age, style: muted_style() }];
    if !entry.applied {
        right = red::push(right, PanelSegment { text: " · undone", style: muted_style() });
    }
    let glyph_style = muted_style();
    if by_agent { glyph_style = heading_style(); }
    return WorkspaceRow {
        id: "transaction:" + entry.transaction_id,
        selectable: true,
        segments: [
            PanelSegment { text: glyph, style: glyph_style },
            PanelSegment { text: entry.file, style: normal_style() },
            PanelSegment { text: "  " + change, style: muted_style() },
        ],
        right_segments: right,
        data: AgentHistoryRowData {
            transaction_id: entry.transaction_id,
            title: history_title(entry),
            document: entry.document,
        },
    };
}

fn history_empty_detail(text: String) -> [[PanelSegment]] {
    return [
        [PanelSegment { text: text, style: muted_style() }],
        [PanelSegment { text: "", style: muted_style() }],
        [PanelSegment { text: "Edits by you and the agent in open files appear here, newest first.", style: muted_style() }],
        [PanelSegment { text: "◆ marks the agent's edits. r reverts the selected edit as a new, undoable change.", style: muted_style() }],
    ];
}

fn render_history(result: AgentHistoryResult) {
    let rows = [];
    let agent_edits = 0;
    let shown = 0;
    let files = [];
    let selected_found = false;
    let first_row = red::null();
    for entry in result.entries {
        let by_agent = entry.origin.kind == "agent";
        if by_agent { agent_edits = agent_edits + 1; }
        if state().history_agent_only && !by_agent { continue; }
        if !red::contains(files, entry.file) { files = red::push(files, entry.file); }
        let row = history_row(entry);
        shown = shown + 1;
        if first_row == red::null() { first_row = row; }
        if row.id == state().history_selected {
            selected_found = true;
            show_history_detail(row.id, row.data.title, row.data.document);
        }
        rows = red::push(rows, row);
    }
    if !selected_found {
        if first_row == red::null() {
            red::state_patch(AgentState { history_document: red::null() });
            red::state_patch(AgentState { history_detail_title: "" });
            let empty = "No edits yet";
            if state().history_agent_only { empty = "No agent edits yet"; }
            red::state_patch(AgentState { history_detail: history_empty_detail(empty) });
        } else {
            show_history_detail(first_row.id, first_row.data.title, first_row.data.document);
        }
    }
    let total = red::len(result.entries);
    if let Some(value) = result.total { total = value; }
    if total > red::len(result.entries) {
        rows = red::push(rows, WorkspaceRow {
            id: "history-truncated",
            selectable: false,
            segments: [PanelSegment { text: "… older edits not shown; the history lists the newest " + red::len(result.entries) + " of " + total, style: muted_style() }],
        });
    }
    // Count edits, not the informational rows added after them.
    let summary = shown + " edits";
    if shown == 1 { summary = "1 edit"; }
    if red::len(files) == 1 { summary = summary + " in 1 file"; }
    if red::len(files) > 1 { summary = summary + " across " + red::len(files) + " files"; }
    if !state().history_agent_only { summary = summary + " · " + agent_edits + " by the agent"; }
    let filter_label = "agent edits only";
    if state().history_agent_only { filter_label = "all edits"; }
    red::execute("UpdateWorkspace", "agent-history", WorkspaceModel {
        header: [PanelSegment { text: summary, style: muted_style() }],
        rows: rows,
        detail: state().history_detail,
        detail_document: state().history_document,
        detail_title: state().history_detail_title,
        actions: [
            AgentWorkspaceAction {
                hint: AgentWorkspaceActionHint { id: "r", key: "r", label: "revert edit", priority: "essential" },
            },
            AgentWorkspaceAction {
                hint: AgentWorkspaceActionHint { id: "a", key: "a", label: filter_label, priority: "essential" },
            },
        ],
    });
}

fn show_history_detail(id: String, title: String, document: Json) {
    red::state_patch(AgentState { history_selected: id });
    red::state_patch(AgentState { history_detail_title: title });
    red::state_patch(AgentState { history_document: document });
    red::state_patch(AgentState { history_detail: [] });
}

#[red::on("workspace:event:agent-history")]
fn history_event(event: AgentHistoryEvent) {
    if event.action == "q" || event.action == "escape" {
        red::state_patch(AgentState { history_open: false });
        red::execute("CloseWorkspace", "agent-history");
        return;
    }
    if event.action == "a" {
        red::state_patch(AgentState { history_agent_only: !state().history_agent_only });
        refresh_history();
        return;
    }
    let row = event.row;
    if row == red::null() || row.data == red::null() || row.data.transaction_id == red::null() {
        return;
    }
    if event.action == "r" {
        red::execute("RevertTransaction", row.data.transaction_id);
        refresh_history();
        return;
    }
    // Any way of moving the selection (keys, mouse, scrolling, filtering) must
    // show that row's diff, so `r` always reverts the edit on screen.
    if row.id != state().history_selected {
        show_history_detail(row.id, row.data.title, row.data.document);
        refresh_history();
    }
}

#[red::on("agent:permission_requested")]
fn permission_requested(event: AgentPermissionEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    red::state_patch(AgentState { permission_request_id: event.request_id });
    let items = [];
    for option in event.options {
        items = red::push(items, PickerItem {
            id: option.option_id,
            label: option.name,
            kind: "Permission",
            annotation: red::string(option.kind, "permission") + " · " + option.option_id,
            data: Json { option_id: option.option_id },
        });
    }
    red::execute("OpenPicker", "Agent permission", items, PickerOptions {
        placeholder: "Choose an exact option from the agent",
        status: red::len(items) + " options",
        presentation: "compact",
        item_layout: "label_first",
    }, PickerHandlers {
        selected: permission_selected,
        cancelled: permission_cancelled,
    });
}

fn permission_selected(item: PickerItem) {
    red::execute(
        "AgentPermissionResponse",
        state().permission_request_id,
        item.data.option_id
    );
    red::state_patch(AgentState { permission_request_id: "" });
}

fn is_current_session(session_id: String) -> bool {
    return session_id == "" || session_id == red::string(state().session_id, "");
}

fn permission_cancelled(event: PickerCancelled) {
    red::execute("AgentPermissionResponse", state().permission_request_id, "");
    red::state_patch(AgentState { permission_request_id: "" });
}

fn normal_style() -> Style {
    return Style { fg: red::null(), bg: red::null(), bold: false, italic: false };
}
fn muted_style() -> Style { return normal_style(); }
fn heading_style() -> Style {
    let style = normal_style();
    style.bold = true;
    return style;
}
fn success_style() -> Style { return normal_style(); }
fn warning_style() -> Style {
    let style = normal_style();
    style.bold = true;
    return style;
}

#[red::lifecycle("deactivate")]
fn deactivate() {
    let session_id = red::string(state().session_id, "");
    if session_id != "" {
        red::execute("AgentCloseSession", session_id);
    }
    red::execute("SetTextPanelStatus", "agent-conversation");
    reset_model_state();
    red::state_patch(AgentState { permission_request_id: "" });
    let timer = red::string(state().stream_timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
        red::state_patch(AgentState { stream_timer: "" });
    }
}

// Messages contains only decisions that outlive the current interaction.
fn report_agent_issue(message: String) {
    red::execute("PublishIssue", "agent:" + red::string(state().session_id, ""), message,
        "Open Agent with Space A; retry/recover the turn, send held prompts with :AgentSendQueued, or discard them with :AgentDiscardQueued.");
}

fn resolve_agent_issue() {
    red::execute("ResolveIssue", "agent:" + red::string(state().session_id, ""));
    red::execute("ResolveIssue", "agent:");
}
