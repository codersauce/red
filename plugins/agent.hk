// Bundled Codex conversation, review, permission, and attributed-history interface.
//
// Rust owns process and thread lifecycle, dynamic tools, proposal isolation, acceptance,
// and recovery. This plugin owns only presentation and session-scoped UI state. Event
// handlers ignore foreign session IDs, queued prompts remain FIFO, and deactivate closes
// plugin UI resources without claiming that an active Codex process survived recovery.

struct AgentSessionEvent {
    session_id: String,
}

struct AgentTextEvent {
    session_id: String,
    text: String,
}

struct AgentCompletedEvent {
    session_id: String,
    stop_reason: String,
    elapsed_ms: i64,
}

struct AgentErrorEvent {
    session_id: String,
    message: String,
}

struct AgentSessionLostEvent {
    session_id: String,
    prompt: String,
}

struct AgentPanelEvent {
    action: String,
    text: String,
}

struct AgentTranscriptEvent {
    transcript: String,
}

struct AgentStringValueEvent {
    value: String,
}

struct AgentStoredValueEvent {
    // Plugin storage may be absent or contain an arbitrary prior-version payload.
    value: Json,
}

struct AgentPromptQueueItem {
    text: String,
    block_id: String,
}

struct AgentActivityRow {
    id: String,
    title: String,
    status: String,
}

struct AgentThoughtContent {
    text: String,
}

struct AgentThoughtChunk {
    content: Option<AgentThoughtContent>,
}

struct AgentToolCall {
    title: Option<String>,
    kind: Option<String>,
    tool_call_id: Option<String>,
    status: Option<String>,
}

struct AgentToolCallUpdate {
    tool_call_id: Option<String>,
    status: Option<String>,
    title: Option<String>,
}

enum AgentActivityUpdate {
    AgentThoughtChunk(AgentThoughtChunk),
    ToolCall(AgentToolCall),
    ToolCallUpdate(AgentToolCallUpdate),
    Plan,
    // Forward-compatible agent updates remain intentionally opaque.
    Unknown(Json),
}

struct AgentActivityEvent {
    session_id: String,
    update: AgentActivityUpdate,
}

struct AgentTextBlock {
    id: String,
    kind: String,
    format: String,
    text: String,
}

struct BoundedAgentBlocks {
    blocks: [AgentTextBlock],
    trimmed: bool,
}

struct TextPanelComposerConfig {
    placeholder: String,
    rows: i32,
}

struct TextPanelHeaderAction {
    id: String,
    label: String,
    compact_label: String,
}

struct AgentProposalHunk {
    id: String,
    old_start: i32,
    old_end: i32,
    old_text: String,
    new_text: String,
}

struct AgentProposalFile {
    session_id: String,
    path: String,
    conflict: bool,
    message: String,
    hunks: [AgentProposalHunk],
}

struct AgentProposalsResult {
    files: [AgentProposalFile],
    // The proposal API uses null or a human-readable error string.
    error: Option<String>,
}

struct AgentProposalConflictEvent {
    session_id: String,
    path: String,
}

struct AgentProposalRowData {
    session_id: String,
    path: String,
    hunk_id: String,
    old_text: String,
    new_text: String,
    conflict: bool,
}

struct AgentProposalRow {
    data: AgentProposalRowData,
}

struct AgentReviewEvent {
    action: String,
    row: AgentProposalRow,
}

struct AgentEdit {
    old_text: String,
    new_text: String,
}

struct AgentEditOrigin {
    kind: String,
    session_id: String,
    turn_id: String,
}

struct AgentHistoryEntry {
    transaction_id: String,
    label: String,
    current: bool,
    origin: AgentEditOrigin,
    edits: [AgentEdit],
}

struct AgentHistoryResult {
    entries: [AgentHistoryEntry],
}

struct AgentHistoryRowData {
    transaction_id: String,
    edits: [AgentEdit],
}

struct AgentHistoryRow {
    data: AgentHistoryRowData,
}

struct AgentHistoryEvent {
    action: String,
    row: AgentHistoryRow,
}

struct AgentPermissionOption {
    option_id: String,
    name: String,
    kind: String,
}

struct AgentPermissionEvent {
    session_id: String,
    request_id: String,
    options: [AgentPermissionOption],
}

struct AgentState {
    session_id: String,
    panel_created: bool,
    panel_open: bool,
    focus_panel_on_first_prompt: bool,
    review_open: bool,
    detail: [[PanelSegment]],
    permission_request_id: String,
    prompt_history: [String],
    pending_prompt: String,
    pending_prompt_block_id: String,
    pending_prompt_is_replay: bool,
    proposal_notice: bool,
    transcript: String,
    transcript_blocks: [AgentTextBlock],
    streaming: bool,
    turn_active: bool,
    prompt_queue: [AgentPromptQueueItem],
    queued_prompt_blocks: [AgentTextBlock],
    recap_pending: bool,
    cancelled_session_id: String,
    stream_block_id: String,
    block_generation: i32,
    stream_timer: String,
    stream_delta: String,
    stream_trimmed: bool,
    history_open: bool,
    history_detail: [[PanelSegment]],
    ui_phase: String,
    ui_label: String,
    activity_rows: [AgentActivityRow],
    activity_block_id: String,
    thought: String,
}

#[red::state]
fn initial_state() -> AgentState {
    return AgentState {
        session_id: "",
        panel_created: false,
        panel_open: false,
        focus_panel_on_first_prompt: false,
        review_open: false,
        detail: [[PanelSegment {
            text: "Select a hunk to inspect it",
            style: muted_style(),
        }]],
        permission_request_id: "",
        prompt_history: [],
        pending_prompt: "",
        pending_prompt_block_id: "",
        pending_prompt_is_replay: false,
        proposal_notice: false,
        transcript: "",
        transcript_blocks: [],
        streaming: false,
        turn_active: false,
        prompt_queue: [],
        queued_prompt_blocks: [],
        recap_pending: false,
        cancelled_session_id: "",
        stream_block_id: "",
        block_generation: 0,
        stream_timer: "",
        stream_delta: "",
        stream_trimmed: false,
        history_open: false,
        history_detail: [[PanelSegment {
            text: "Select a transaction",
            style: muted_style(),
        }]],
        ui_phase: "idle",
        ui_label: "",
        activity_rows: [],
        activity_block_id: "",
        thought: "",
    };
}

fn state() -> AgentState {
    return red::state();
}

#[red::command(
    name = "AgentStart",
    title = "Start agent session",
    category = "Agent",
    description = "Start a new agent session",
    aliases = ["new chat"],
)]
fn start() {
    red::request("GetConfig", cwd_loaded, "cwd");
}

fn cwd_loaded(result: AgentStringValueEvent) {
    red::execute("AgentNewSession", red::string(result.value, "."));
}

#[red::on("agent:session_created")]
fn session_created(event: AgentSessionEvent) {
    let previous_session_id = red::string(state().session_id, "");
    let pending = red::string(state().pending_prompt, "");
    let pending_block_id = red::string(state().pending_prompt_block_id, "");
    let replay = state().pending_prompt_is_replay;
    red::state_patch(AgentState { session_id: event.session_id });
    if previous_session_id != event.session_id || (pending != "" && replay) {
        red::state_patch(AgentState { turn_active: false });
    }
    if previous_session_id != event.session_id {
        red::state_patch(AgentState { cancelled_session_id: "" });
    }
    if previous_session_id != "" && previous_session_id != event.session_id {
        red::execute("AgentCloseSession", previous_session_id);
    }
    ensure_conversation_panel();
    render_conversation();
    red::execute("Print", "Agent session started");
    refresh_proposals();
    if pending != "" {
        red::state_patch(AgentState { pending_prompt: "" });
        red::state_patch(AgentState { pending_prompt_block_id: "" });
        red::state_patch(AgentState { pending_prompt_is_replay: false });
        if replay {
            red::state_patch(AgentState { turn_active: true });
            red::execute("AgentPrompt", event.session_id, pending);
        } else {
            dispatch_prompt_block(pending, pending_block_id);
        }
    }
}

#[red::command(
    name = "Agent",
    title = "Ask the agent",
    category = "Agent",
    description = "Open the agent prompt",
    aliases = ["ask ai", "chat"],
)]
#[red::command(
    name = "AgentPrompt",
    title = "Open agent prompt",
    category = "Agent",
    description = "Ask a question in the active agent session",
    aliases = ["ask ai", "chat"],
)]
fn prompt() {
    if red::string(state().session_id, "") != "" {
        ensure_conversation_panel();
    }
    red::request("GetStorage", prompt_history_loaded, "prompt_history");
}

#[red::command(
    name = "AgentOpen",
    title = "Open agent conversation",
    category = "Agent",
    description = "Show and focus the conversation pane without opening a prompt",
    aliases = ["show chat", "open chat"],
)]
fn open_conversation() {
    let was_created = state().panel_created;
    ensure_conversation_panel();
    if !was_created {
        render_conversation();
    }
    red::execute("FocusPanel", "agent-conversation");
}

fn ensure_conversation_panel() {
    if !state().panel_created {
        red::execute("CreateTextPanel", "agent-conversation", PanelConfig {
            side: "right",
            width: 62,
            title: "Agent",
            composer: TextPanelComposerConfig { placeholder: "Ask a follow-up…", rows: 3 },
            header_actions: [
                TextPanelHeaderAction { id: "clear", label: "Clear", compact_label: "C" },
                TextPanelHeaderAction { id: "new", label: "New", compact_label: "N" },
                TextPanelHeaderAction { id: "close", label: "×", compact_label: "×" },
            ],
        });
        red::state_patch(AgentState { panel_created: true });
        red::state_patch(AgentState { panel_open: true });
        red::state_patch(AgentState { focus_panel_on_first_prompt: true });
        return;
    }
    if !state().panel_open {
        red::execute("SetPanelVisible", "agent-conversation", true);
        red::state_patch(AgentState { panel_open: true });
    }
}

fn prompt_history_loaded(result: AgentStoredValueEvent) {
    let history = [];
    if result.value != red::null() {
        for entry in result.value {
            let text = red::string(entry, "");
            if red::trim(text) != "" && !red::contains(history, text) && red::len(history) < 50 {
                history = red::push(history, text);
            }
        }
    }
    red::state_patch(AgentState { prompt_history: history });
    red::execute(
        "OpenComposer",
        "Agent prompt",
        red::string(state().pending_prompt, ""),
        history,
        ComposerHandlers {
            submitted: prompt_submitted,
            cancelled: prompt_cancelled,
        }
    );
}

fn prompt_submitted(text: String) {
    if red::trim(text) == "" {
        return;
    }
    let history = [text];
    for entry in state().prompt_history {
        if entry != text && red::len(history) < 50 {
            history = red::push(history, entry);
        }
    }
    red::state_patch(AgentState { prompt_history: history });
    red::state_patch(AgentState { proposal_notice: false });
    if state().session_id == "" {
        red::execute("SetStorage", "prompt_history", history);
        red::state_patch(AgentState { pending_prompt: text });
        red::state_patch(AgentState { pending_prompt_block_id: "" });
        red::state_patch(AgentState { pending_prompt_is_replay: false });
        start();
        return;
    }
    submit_prompt(text);
    red::execute("SetStorage", "prompt_history", history);
}

fn submit_prompt(text: String) {
    if red::trim(text) == "" {
        return;
    }
    if state().turn_active {
        let queue = state().prompt_queue;
        if red::len(queue) >= 16 {
            red::execute("Print", "Agent follow-up queue is full");
            return;
        }
        let generation = red::int(state().block_generation, 0) + 1;
        let block_id = "user:" + generation;
        red::state_patch(AgentState { block_generation: generation });
        queue = red::push(queue, AgentPromptQueueItem { text: text, block_id: block_id });
        red::state_patch(AgentState { prompt_queue: queue });
        // Pending blocks render below the active stream but do not enter the
        // committed transcript until their FIFO turn is dispatched.
        let queued_blocks = state().queued_prompt_blocks;
        queued_blocks = red::push(queued_blocks, AgentTextBlock {
            id: block_id,
            kind: "user",
            format: "plain",
            text: text,
        });
        let bounded = bounded_transcript_blocks(queued_blocks, block_id);
        red::state_patch(AgentState { queued_prompt_blocks: bounded.blocks });
        if state().streaming {
            red::state_patch(AgentState { stream_trimmed: true });
        }
        render_conversation();
        render_status();
        red::execute("Refresh");
        red::execute("Print", "Agent turn is still running; follow-up queued (" + red::len(queue) + ")");
        return;
    }
    if red::string(state().session_id, "") == "" {
        red::state_patch(AgentState { pending_prompt: text });
        red::state_patch(AgentState { pending_prompt_block_id: "" });
        red::state_patch(AgentState { pending_prompt_is_replay: false });
        start();
        return;
    }
    dispatch_prompt(text);
}

fn dispatch_prompt(text: String) {
    dispatch_prompt_block(text, "");
}

/// Promote an optional optimistic queue block, paint the busy state, and only
/// then persist and hand the turn to the agent bridge.
fn dispatch_prompt_block(text: String, block_id: String) {
    let wire_text = text;
    let focus_conversation = state().focus_panel_on_first_prompt;
    if state().recap_pending {
        let recap = red::string(state().transcript, "");
        if red::len(recap) > 6000 {
            recap = red::slice(recap, red::len(recap) - 6000);
        }
        if red::trim(recap) != "" {
            wire_text = "Previous conversation (the last turn was interrupted):\n" + recap + "\n\nFollow-up:\n" + text;
        }
        red::state_patch(AgentState { recap_pending: false });
    }
    remove_queued_prompt_block(block_id);
    red::state_patch(AgentState { turn_active: true });
    append_transcript_block("You", text, block_id);
    if focus_conversation {
        red::state_patch(AgentState { focus_panel_on_first_prompt: false });
        red::execute("FocusPanel", "agent-conversation");
    }
    set_phase("waiting", "Waiting for agent…");
    red::execute("Refresh");
    red::execute("SetStorage", "transcript", state().transcript);
    red::execute("AgentPrompt", state().session_id, wire_text);
}

fn remove_queued_prompt_block(block_id: String) {
    if block_id == "" {
        return;
    }
    let queued_blocks = [];
    for block in state().queued_prompt_blocks {
        if block.id != block_id {
            queued_blocks = red::push(queued_blocks, block);
        }
    }
    red::state_patch(AgentState { queued_prompt_blocks: queued_blocks });
}

#[red::on("agent:turn_started")]
fn turn_started(event: AgentSessionEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    set_phase("waiting", "Waiting for agent…");
}

/// Update the turn phase/label and re-render the panel status row.
fn set_phase(phase: String, label: String) {
    red::state_patch(AgentState { ui_phase: phase });
    red::state_patch(AgentState { ui_label: label });
    render_status();
}

/// Single writer for the panel status row; every phase change funnels here so
/// queue depth and streaming state are never clobbered by individual events.
fn render_status() {
    let phase = red::string(state().ui_phase, "idle");
    if phase == "idle" {
        red::execute("SetTextPanelStatus", "agent-conversation");
        return;
    }
    let label = red::string(state().ui_label, "");
    if label == "" {
        label = "Working…";
    }
    let queued = red::len(state().prompt_queue);
    if queued > 0 {
        label = label + " · " + queued + " queued";
    }
    red::execute("SetTextPanelStatus", "agent-conversation", TextPanelStatus {
        busy: true,
        label: label,
        stream: state().streaming,
    });
}

#[red::on("agent:activity")]
fn activity(event: AgentActivityEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    match event.update {
        AgentActivityUpdate::AgentThoughtChunk(update) => thought_activity(update),
        AgentActivityUpdate::ToolCall(update) => tool_activity(update),
        AgentActivityUpdate::ToolCallUpdate(update) => update_tool_activity(update),
        AgentActivityUpdate::Plan => set_phase("working", "Planning…"),
        AgentActivityUpdate::Unknown(update) => {},
    }
}

fn optional_text(value: Option<String>, fallback: String) -> String {
    if let Some(text) = value {
        return text;
    }
    return fallback;
}

fn thought_activity(update: AgentThoughtChunk) {
    if let Some(content) = update.content {
        let text = content.text;
        if text != "" {
            let thought = state().thought + text;
            if red::len(thought) > 240 {
                thought = red::slice(thought, red::len(thought) - 240);
            }
            red::state_patch(AgentState { thought: thought });
            render_activity();
        }
    }
    set_phase("thinking", "Thinking…");
}

fn tool_activity(update: AgentToolCall) {
    let title = optional_text(update.title, "");
    if title == "" {
        title = optional_text(update.kind, "Tool");
    }
    let rows = state().activity_rows;
    if red::len(rows) < 100 {
        rows = red::push(rows, AgentActivityRow {
            id: optional_text(update.tool_call_id, ""),
            title: title,
            status: optional_text(update.status, "in_progress"),
        });
    }
    red::state_patch(AgentState { activity_rows: rows });
    render_activity();
    set_phase("tool", title);
}

fn update_tool_activity(update: AgentToolCallUpdate) {
    let target = optional_text(update.tool_call_id, "");
    let status = optional_text(update.status, "");
    let title = optional_text(update.title, "");
    let rows = state().activity_rows;
    let updated = [];
    let active = "";
    for row in rows {
        if row.id == target && row.id != "" {
            if status != "" {
                row.status = status;
            }
            if title != "" {
                row.title = title;
            }
        }
        if row.status == "in_progress" || row.status == "pending" {
            active = row.title;
        }
        updated = red::push(updated, row);
    }
    red::state_patch(AgentState { activity_rows: updated });
    render_activity();
    if active != "" {
        set_phase("tool", active);
    } else if state().streaming {
        set_phase("streaming", "Writing…");
    } else {
        set_phase("working", "Working…");
    }
}

/// Lazily create the current turn's activity timeline block.
fn ensure_activity_block() -> String {
    let block_id = red::string(state().activity_block_id, "");
    if block_id != "" {
        return block_id;
    }
    let generation = red::int(state().block_generation, 0) + 1;
    red::state_patch(AgentState { block_generation: generation });
    block_id = "activity:" + generation;
    red::state_patch(AgentState { activity_block_id: block_id });
    let blocks = state().transcript_blocks;
    blocks = red::push(blocks, AgentTextBlock {
        id: block_id,
        kind: "activity",
        format: "plain",
        text: "",
    });
    red::state_patch(AgentState { transcript_blocks: blocks });
    return block_id;
}

fn activity_glyph(status: String) -> String {
    if status == "completed" {
        return "✓";
    }
    if status == "failed" {
        return "✗";
    }
    return "→";
}

/// Re-render the in-conversation timeline: latest thought plus one line per tool.
fn render_activity() {
    let block_id = ensure_activity_block();
    let text = "";
    let thought = red::trim(red::string(state().thought, ""));
    if thought != "" {
        text = "Thinking: " + thought;
    }
    for row in state().activity_rows {
        if text != "" {
            text = text + "\n";
        }
        text = text + activity_glyph(red::string(row.status, "")) + " " + red::string(row.title, "");
    }
    let blocks = state().transcript_blocks;
    let updated = [];
    for block in blocks {
        if block.id == block_id {
            block.text = text;
        }
        updated = red::push(updated, block);
    }
    red::state_patch(AgentState { transcript_blocks: updated });
    render_conversation();
}

/// Collapse the finished turn's timeline into a one-line summary (or drop it).
fn collapse_activity(elapsed_ms: i64) {
    let block_id = red::string(state().activity_block_id, "");
    red::state_patch(AgentState { activity_block_id: "" });
    let rows = state().activity_rows;
    red::state_patch(AgentState { activity_rows: [] });
    red::state_patch(AgentState { thought: "" });
    let elapsed = format_turn_elapsed(elapsed_ms);
    if block_id == "" && elapsed == "" {
        return;
    }
    let count = red::len(rows);
    let blocks = state().transcript_blocks;
    if block_id == "" {
        let generation = red::int(state().block_generation, 0) + 1;
        red::state_patch(AgentState { block_generation: generation });
        block_id = "activity:" + generation;
        blocks = red::push(blocks, AgentTextBlock {
            id: block_id,
            kind: "activity",
            format: "plain",
            text: "",
        });
    }
    let updated = [];
    for block in blocks {
        if block.id == block_id {
            let summary = "";
            if count > 0 {
                summary = "✓ " + count + " steps";
                if count == 1 {
                    summary = "✓ 1 step";
                }
            }
            if elapsed != "" {
                if summary != "" {
                    summary = summary + "\n";
                }
                summary = summary + "Worked for " + elapsed;
            }
            if summary == "" {
                continue;
            }
            block.text = summary;
        }
        updated = red::push(updated, block);
    }
    red::state_patch(AgentState { transcript_blocks: updated });
    render_conversation();
}

fn format_turn_elapsed(elapsed_ms: i64) -> String {
    let ms = red::int(elapsed_ms, 0);
    if ms <= 0 {
        return "";
    }
    let seconds = ms / 1000;
    if seconds < 1 {
        return "<1s";
    }
    if seconds < 60 {
        return seconds + "s";
    }
    let minutes = seconds / 60;
    let remaining_seconds = seconds - minutes * 60;
    if minutes < 60 {
        return minutes + "m " + remaining_seconds + "s";
    }
    let hours = minutes / 60;
    let remaining_minutes = minutes - hours * 60;
    return hours + "h " + remaining_minutes + "m " + remaining_seconds + "s";
}

#[red::on("panel:event:agent-conversation")]
fn panel_event(event: AgentPanelEvent) {
    if event.action == "submit" {
        let text = red::string(event.text, "");
        if red::trim(text) != "" {
            prompt_submitted(text);
        }
    } else if event.action == "composer_focus" {
        red::execute("FocusTextPanelComposer", "agent-conversation");
    } else if event.action == "interrupt" {
        cancel();
    } else if event.action == "clear" {
        clear_conversation();
    } else if event.action == "new" {
        new_conversation();
    } else if event.action == "history" {
        history();
    } else if event.action == "close" {
        close_conversation();
    }
}

#[red::command(
    name = "AgentClear",
    title = "Clear agent conversation",
    category = "Agent",
    description = "Clear the visible conversation while preserving context",
    aliases = ["clear chat"],
)]
fn clear_conversation() {
    reset_stream_render();
    red::state_patch(AgentState { transcript_blocks: [] });
    red::state_patch(AgentState { queued_prompt_blocks: [] });
    red::state_patch(AgentState { activity_block_id: "" });
    red::state_patch(AgentState { activity_rows: [] });
    red::state_patch(AgentState { thought: "" });
    red::execute("UpdateTextPanel", "agent-conversation", []);
    red::execute("SetTextPanelComposerState", "agent-conversation", true, "Conversation view cleared · context preserved");
}

fn reset_stream_render() {
    let timer = red::string(state().stream_timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
        red::state_patch(AgentState { stream_timer: "" });
    }
    red::state_patch(AgentState { streaming: false });
    red::state_patch(AgentState { stream_block_id: "" });
    red::state_patch(AgentState { stream_delta: "" });
    red::state_patch(AgentState { stream_trimmed: false });
}

#[red::command(
    name = "AgentClose",
    title = "Close agent conversation",
    category = "Agent",
    description = "Hide the conversation pane without ending the session",
    aliases = ["hide chat"],
)]
fn close_conversation() {
    if state().panel_open {
        red::execute("SetPanelVisible", "agent-conversation", false);
        red::state_patch(AgentState { panel_open: false });
    }
    red::execute("FocusEditor");
}

#[red::command(
    name = "AgentNew",
    title = "Start new agent conversation",
    category = "Agent",
    description = "Reset the session and start a new conversation",
    aliases = ["new conversation"],
)]
fn new_conversation() {
    let session_id = red::string(state().session_id, "");
    if session_id != "" {
        red::execute("AgentCloseSession", session_id);
    }
    red::state_patch(AgentState { session_id: "" });
    red::state_patch(AgentState { cancelled_session_id: "" });
    red::state_patch(AgentState { turn_active: false });
    set_phase("idle", "");
    red::state_patch(AgentState { prompt_queue: [] });
    red::state_patch(AgentState { recap_pending: false });
    red::state_patch(AgentState { pending_prompt: "" });
    red::state_patch(AgentState { pending_prompt_block_id: "" });
    red::state_patch(AgentState { pending_prompt_is_replay: false });
    red::state_patch(AgentState { proposal_notice: false });
    clear_conversation();
    red::state_patch(AgentState { transcript: "" });
    red::execute("SetStorage", "transcript", "");
    red::execute("ClearTextPanelComposer", "agent-conversation");
    prompt();
}

fn prompt_cancelled(event: ComposerCancelled) {}

#[red::command(
    name = "AgentCancel",
    title = "Cancel agent request",
    category = "Agent",
    description = "Cancel the active agent request",
    aliases = ["stop agent"],
)]
fn cancel() {
    let session_id = state().session_id;
    if session_id != "" {
        red::execute("AgentCancel", session_id);
    }
}

#[red::on("agent:update")]
fn update(event: AgentTextEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    let delta = red::string(event.text, "");
    if delta == "" {
        return;
    }

    let transcript = state().transcript;
    let block_id = red::string(state().stream_block_id, "");
    if !state().streaming {
        if transcript != "" && !red::ends_with(transcript, "\n") {
            transcript = transcript + "\n";
        }
        transcript = transcript + "Agent: ";

        let generation = red::int(state().block_generation, 0) + 1;
        block_id = "agent:" + generation;
        red::state_patch(AgentState { block_generation: generation });
        red::state_patch(AgentState { streaming: true });
        red::state_patch(AgentState { stream_block_id: block_id });

        let blocks = state().transcript_blocks;
        blocks = red::push(blocks, AgentTextBlock {
            id: block_id,
            kind: "agent",
            format: "markdown",
            text: "",
        });
        red::state_patch(AgentState { transcript_blocks: blocks });
        render_conversation();
        set_phase("streaming", "Writing…");
    }

    transcript = transcript + delta;
    if red::len(transcript) > 20000 {
        transcript = red::slice(transcript, red::len(transcript) - 20000);
    }
    red::state_patch(AgentState { transcript: transcript });

    let blocks = state().transcript_blocks;
    let updated = [];
    for block in blocks {
        if block.id == block_id {
            block.text = red::string(block.text, "") + delta;
        }
        updated = red::push(updated, block);
    }
    let bounded = bounded_transcript_blocks(updated, block_id);
    red::state_patch(AgentState { transcript_blocks: bounded.blocks });
    if bounded.trimmed {
        red::state_patch(AgentState { stream_trimmed: true });
    }
    red::state_patch(AgentState { stream_delta: red::string(state().stream_delta, "") + delta });

    let timer = red::string(state().stream_timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
    }
    red::state_patch(AgentState { stream_timer: red::execute("SetTimeout", 50) });
}

#[red::on("agent:completed")]
fn completed(event: AgentCompletedEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    red::state_patch(AgentState { turn_active: false });
    let session_id = red::string(event.session_id, "");
    let stop_reason = red::string(event.stop_reason, "end_turn");
    if stop_reason == "end_turn" || stop_reason == "completed" {
        finish_agent_turn();
    }
    collapse_activity(event.elapsed_ms);
    set_phase("idle", "");
    if session_id != "" && (stop_reason == "cancelled" || session_id == red::string(state().cancelled_session_id, "")) {
        red::execute("AgentCloseSession", session_id);
        red::state_patch(AgentState { session_id: "" });
        red::state_patch(AgentState { cancelled_session_id: "" });
        red::state_patch(AgentState { recap_pending: true });
    }
    if stop_reason == "end_turn" || stop_reason == "completed" {
        submit_next_queued();
        return;
    }
    append_transcript("System", "Agent stopped: " + stop_reason);
    red::execute("Print", "Agent stopped: " + stop_reason);
    submit_next_queued();
}

fn submit_next_queued() {
    let queue = state().prompt_queue;
    if red::len(queue) == 0 {
        return;
    }
    let next = queue[0];
    let remaining = [];
    let index = 0;
    for entry in queue {
        if index > 0 {
            remaining = red::push(remaining, entry);
        }
        index = index + 1;
    }
    red::state_patch(AgentState { prompt_queue: remaining });
    let text = red::string(next.text, red::string(next, ""));
    let block_id = red::string(next.block_id, "");
    if red::string(state().session_id, "") == "" {
        red::state_patch(AgentState { pending_prompt: text });
        red::state_patch(AgentState { pending_prompt_block_id: block_id });
        red::state_patch(AgentState { pending_prompt_is_replay: false });
        start();
        return;
    }
    dispatch_prompt_block(text, block_id);
}

#[red::on("agent:cancelled")]
fn cancelled(event: AgentSessionEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    let session_id = red::string(event.session_id, "");
    if session_id != "" {
        red::state_patch(AgentState { cancelled_session_id: session_id });
    }
    if !state().turn_active && session_id != "" {
        red::execute("AgentCloseSession", session_id);
        red::state_patch(AgentState { session_id: "" });
        red::state_patch(AgentState { cancelled_session_id: "" });
        red::state_patch(AgentState { recap_pending: true });
    }
    red::execute("Print", "Agent cancellation requested");
    set_phase("stopping", "Stopping…");
}

#[red::on("agent:error")]
fn failed(event: AgentErrorEvent) {
    if !is_current_session(red::string(event.session_id, "")) {
        return;
    }
    if red::string(event.session_id, "") == "" && state().turn_active {
        red::execute("Print", "Agent setup failed while a turn is active: " + event.message);
        return;
    }
    red::state_patch(AgentState { turn_active: false });
    collapse_activity(red::null());
    set_phase("idle", "");
    let session_id = red::string(event.session_id, "");
    if session_id != "" && session_id == red::string(state().cancelled_session_id, "") {
        red::execute("AgentCloseSession", session_id);
        red::state_patch(AgentState { session_id: "" });
        red::state_patch(AgentState { cancelled_session_id: "" });
        red::state_patch(AgentState { recap_pending: true });
    }
    append_transcript("Error", event.message);
    if red::len(state().prompt_queue) > 0 {
        submit_next_queued();
        return;
    }
    if red::string(state().pending_prompt, "") != "" || state().session_id == "" {
        red::execute("Print", "Codex unavailable: " + event.message + ". Your prompt is preserved");
        red::execute("OpenPicker", "Retry Codex", [
            PickerItem { id: "retry", label: "Retry the saved prompt", kind: "Action" },
        ], PickerOptions {
            placeholder: "Retry after fixing the Codex setup",
            status: "Enter selects; Escape keeps the saved prompt",
            presentation: "compact",
        }, PickerHandlers {
            selected: setup_selected,
            cancelled: setup_cancelled,
        });
    } else {
        red::execute("Print", "Agent error: " + event.message);
    }
}

#[red::on("agent:session_lost")]
fn session_lost(event: AgentSessionLostEvent) {
    let session_id = red::string(state().session_id, "");
    let attempted = red::string(event.prompt, "");
    if !is_current_session(red::string(event.session_id, "")) && (session_id != "" || attempted == "") {
        return;
    }
    red::state_patch(AgentState { turn_active: false });
    collapse_activity(red::null());
    set_phase("idle", "");
    if session_id != "" {
        red::execute("AgentArchiveSession", session_id);
        red::state_patch(AgentState { recap_pending: true });
    }
    red::state_patch(AgentState { session_id: "" });
    red::state_patch(AgentState { cancelled_session_id: "" });
    if attempted != "" {
        red::state_patch(AgentState { pending_prompt: attempted });
        red::state_patch(AgentState { pending_prompt_block_id: "" });
        red::state_patch(AgentState { pending_prompt_is_replay: true });
        red::execute("Print", "Codex app-server stopped; retrying the saved prompt");
        start();
    } else if red::string(state().pending_prompt, "") != "" {
        failed(AgentErrorEvent { session_id: "", message: "Codex app-server stopped" });
    } else {
        red::execute("Print", "Codex app-server stopped. Press Space A to start a new session");
    }
}

fn setup_selected(item: PickerItem) {
    if item.id == "retry" {
        start();
    }
}

fn setup_cancelled(event: PickerCancelled) {
    red::execute("Print", "Agent prompt saved. Press Space A when ready to retry");
}

#[red::on("agent:credential_ready")]
#[red::on("agent:backend_ready")]
fn setup_ready(event: EmptyEvent) {
    if red::string(state().pending_prompt, "") != "" {
        start();
    }
}

fn finish_agent_turn() {
    if !state().streaming {
        return;
    }
    let transcript = state().transcript;
    if !red::ends_with(transcript, "\n") {
        transcript = transcript + "\n";
    }
    if red::len(transcript) > 20000 {
        transcript = red::slice(transcript, red::len(transcript) - 20000);
    }
    red::state_patch(AgentState { transcript: transcript });
    red::state_patch(AgentState { streaming: false });
    let block_id = red::string(state().stream_block_id, "");
    red::state_patch(AgentState { stream_block_id: "" });
    let timer = red::string(state().stream_timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
        red::state_patch(AgentState { stream_timer: "" });
    }
    red::execute("SetStorage", "transcript", transcript);
    flush_stream(block_id);
}

fn append_transcript(role: String, text: String) {
    append_transcript_block(role, text, "");
    red::execute("SetStorage", "transcript", state().transcript);
}

fn append_transcript_block(role: String, text: String, block_id: String) {
    let transcript = state().transcript;
    if state().streaming {
        if !red::ends_with(transcript, "\n") {
            transcript = transcript + "\n";
        }
        red::state_patch(AgentState { streaming: false });
        let timer = red::string(state().stream_timer, "");
        if timer != "" {
            red::execute("CancelTimeout", timer);
            red::state_patch(AgentState { stream_timer: "" });
        }
        red::state_patch(AgentState { stream_block_id: "" });
        red::state_patch(AgentState { stream_delta: "" });
        red::state_patch(AgentState { stream_trimmed: false });
    }
    transcript = transcript + role + ": " + text + "\n";
    if red::len(transcript) > 20000 {
        transcript = red::slice(transcript, red::len(transcript) - 20000);
    }
    red::state_patch(AgentState { transcript: transcript });

    let kind = "text";
    if role == "You" {
        kind = "user";
    } else if role == "Error" {
        kind = "error";
    }
    if block_id == "" {
        let generation = red::int(state().block_generation, 0) + 1;
        red::state_patch(AgentState { block_generation: generation });
        block_id = kind + ":" + generation;
    }
    let blocks = state().transcript_blocks;
    blocks = red::push(blocks, AgentTextBlock {
        id: block_id,
        kind: kind,
        format: "plain",
        text: text,
    });
    let bounded = bounded_transcript_blocks(blocks, "");
    red::state_patch(AgentState { transcript_blocks: bounded.blocks });
    render_conversation();
}

#[red::on("timeout:callback")]
fn stream_timeout(event: TimerEvent) {
    if event.timer_id != state().stream_timer {
        return;
    }
    red::state_patch(AgentState { stream_timer: "" });
    red::execute("SetStorage", "transcript", state().transcript);
    flush_stream(red::string(state().stream_block_id, ""));
}

fn flush_stream(block_id: String) {
    let delta = red::string(state().stream_delta, "");
    let trimmed = state().stream_trimmed;
    red::state_patch(AgentState { stream_delta: "" });
    red::state_patch(AgentState { stream_trimmed: false });
    if trimmed {
        render_conversation();
    } else if delta != "" {
        red::execute("AppendTextPanel", "agent-conversation", block_id, delta);
    }
}

#[red::on("agent:transcript_restored")]
fn transcript_restored(event: AgentTranscriptEvent) {
    let transcript = red::string(event.transcript, "");
    let blocks = legacy_transcript_blocks(transcript);
    let generation = red::len(blocks);
    let bounded = bounded_transcript_blocks(blocks, "");
    red::state_patch(AgentState { transcript: transcript });
    red::state_patch(AgentState { transcript_blocks: bounded.blocks });
    red::state_patch(AgentState { block_generation: generation });
    red::state_patch(AgentState { streaming: false });
    red::state_patch(AgentState { stream_block_id: "" });
    red::state_patch(AgentState { stream_delta: "" });
    red::state_patch(AgentState { stream_trimmed: false });
    render_conversation();
}

fn render_conversation() {
    let blocks = state().transcript_blocks;
    let keep_id = red::string(state().stream_block_id, "");
    for block in state().queued_prompt_blocks {
        blocks = red::push(blocks, block);
        if keep_id == "" {
            keep_id = block.id;
        }
    }
    let bounded = bounded_transcript_blocks(blocks, keep_id);
    blocks = bounded.blocks;
    if red::len(blocks) == 0 {
        blocks = [AgentTextBlock {
            id: "empty",
            kind: "activity",
            format: "plain",
            text: "No messages yet.\n\nEnter sends · ^J adds a line\na edits from the panel · Space A opens the prompt\n^C stops a running turn",
        }];
    }
    red::execute("UpdateTextPanel", "agent-conversation", blocks);
}

fn legacy_transcript_blocks(transcript: String) -> [AgentTextBlock] {
    let blocks: [AgentTextBlock] = [];
    let index = 0;
    let kind = "";
    let format = "plain";
    let text = "";
    let lines = red::split(transcript, "\n");
    let line_index = 0;

    for line in lines {
        line_index = line_index + 1;
        if line == "" && line_index == red::len(lines) {
            continue;
        }
        if line == "System: Agent stopped: end_turn" {
            continue;
        }

        let next_kind = "";
        let next_format = "plain";
        let prefix = 0;
        if red::starts_with(line, "You: ") {
            next_kind = "user";
            prefix = 5;
        } else if red::starts_with(line, "Agent: ") {
            next_kind = "agent";
            next_format = "markdown";
            prefix = 7;
        } else if red::starts_with(line, "Error: ") {
            next_kind = "error";
            prefix = 7;
        } else if red::starts_with(line, "System: ") {
            next_kind = "text";
            prefix = 8;
        }

        if next_kind != "" {
            if kind != "" {
                blocks = red::push(blocks, AgentTextBlock {
                    id: kind + ":" + index,
                    kind: kind,
                    format: format,
                    text: text,
                });
            }
            index = index + 1;
            kind = next_kind;
            format = next_format;
            text = red::slice(line, prefix);
        } else {
            if kind == "" {
                index = index + 1;
                kind = "text";
                format = "plain";
            } else {
                text = text + "\n";
            }
            text = text + line;
        }
    }

    if kind != "" {
        blocks = red::push(blocks, AgentTextBlock {
            id: kind + ":" + index,
            kind: kind,
            format: format,
            text: text,
        });
    }
    return blocks;
}

fn bounded_transcript_blocks(blocks: [AgentTextBlock], keep_id: String) -> BoundedAgentBlocks {
    let total = 0;
    for block in blocks {
        total = total + red::len(red::string(block.text, ""));
    }
    if total <= 20000 {
        return BoundedAgentBlocks { blocks: blocks, trimmed: false };
    }

    let excess = total - 20000;
    let bounded: [AgentTextBlock] = [];
    let block_index = 0;
    for block in blocks {
        block_index = block_index + 1;
        let text = red::string(block.text, "");
        let length = red::len(text);
        if excess >= length && block.id != keep_id && block_index < red::len(blocks) {
            excess = excess - length;
            continue;
        }
        if excess > 0 {
            let cut = excess;
            if cut > length {
                cut = length;
            }
            block.text = red::slice(text, cut);
            excess = excess - cut;
        }
        bounded = red::push(bounded, block);
    }
    return BoundedAgentBlocks { blocks: bounded, trimmed: true };
}

#[red::command(
    name = "AgentReview",
    title = "Review agent changes",
    category = "Agent",
    description = "Review changes proposed by the agent",
    aliases = ["proposals"],
)]
fn review() {
    red::state_patch(AgentState { review_open: true });
    red::execute("OpenWorkspace", "agent-review", WorkspaceConfig {
        title: "Agent proposals",
        detail_ratio: 58,
        min_two_pane_width: 88,
    });
    refresh_proposals();
}

fn refresh_proposals() {
    if !state().review_open {
        return;
    }
    red::request("AgentProposals", render_proposals, state().session_id);
}

fn render_proposals(result: AgentProposalsResult) {
    let rows = [];
    let file_index = 0;
    let truncated = false;
    while file_index < red::len(result.files) && red::len(rows) < 499 {
        let file = result.files[file_index];
        let status = " " + red::len(file.hunks) + " hunks";
        let status_style = muted_style();
        if file.conflict {
            status = " conflict";
            status_style = warning_style();
        }
        rows = red::push(rows, WorkspaceRow {
            id: "file:" + file.session_id + ":" + file.path,
            selectable: true,
            segments: [PanelSegment { text: file.path, style: heading_style() }],
            right_segments: [PanelSegment {
                text: status,
                style: status_style,
            }],
            data: AgentProposalRowData {
                session_id: file.session_id,
                path: file.path,
                hunk_id: "",
                old_text: "",
                new_text: "",
                conflict: file.conflict,
            },
        });
        if file.conflict {
            if red::len(rows) < 499 {
                rows = red::push(rows, WorkspaceRow {
                    id: "conflict:" + file.session_id + ":" + file.path,
                    selectable: false,
                    depth: 1,
                    segments: [PanelSegment { text: file.message, style: warning_style() }],
                });
            } else {
                truncated = true;
            }
        } else {
            let hunk_index = 0;
            while hunk_index < red::len(file.hunks) && red::len(rows) < 499 {
                let hunk = file.hunks[hunk_index];
                rows = red::push(rows, WorkspaceRow {
                    id: "hunk:" + file.session_id + ":" + hunk.id,
                    selectable: true,
                    depth: 1,
                    segments: [PanelSegment {
                        text: "chars " + hunk.old_start + ".." + hunk.old_end,
                        style: normal_style(),
                    }],
                    data: AgentProposalRowData {
                        session_id: file.session_id,
                        path: file.path,
                        hunk_id: hunk.id,
                        old_text: hunk.old_text,
                        new_text: hunk.new_text,
                        conflict: false,
                    },
                });
                hunk_index = hunk_index + 1;
            }
            if hunk_index < red::len(file.hunks) {
                truncated = true;
            }
        }
        file_index = file_index + 1;
    }
    if file_index < red::len(result.files) {
        truncated = true;
    }
    if truncated {
        rows = red::push(rows, WorkspaceRow {
            id: "proposals-truncated",
            selectable: false,
            segments: [PanelSegment { text: "… review limited to 500 rows", style: muted_style() }],
        });
    }
    if let Some(error) = result.error {
        rows = red::push(rows, WorkspaceRow {
            id: "error",
            selectable: false,
            segments: [PanelSegment { text: error, style: warning_style() }],
        });
    } else if red::len(rows) == 0 {
        rows = red::push(rows, WorkspaceRow {
            id: "empty",
            selectable: false,
            segments: [PanelSegment { text: "No pending proposals", style: success_style() }],
        });
    }
    red::execute("UpdateWorkspace", "agent-review", WorkspaceModel {
        header: [PanelSegment { text: "Review before any buffer or disk change", style: muted_style() }],
        rows: rows,
        detail: state().detail,
        footer: [PanelSegment {
            text: "a accept hunk  A accept file  r reject hunk  R reject file  q close",
            style: muted_style(),
        }],
    });
}

#[red::on("workspace:event:agent-review")]
fn review_event(event: AgentReviewEvent) {
    if event.action == "q" || event.action == "escape" {
        red::state_patch(AgentState { review_open: false });
        red::execute("CloseWorkspace", "agent-review");
        return;
    }
    let row = event.row;
    if row == red::null() || row.data.path == red::null() {
        return;
    }
    if event.action == "up" || event.action == "down" || event.action == "page_up" || event.action == "page_down" {
        show_proposal_detail(row);
    } else if event.action == "a" {
        red::execute("AgentAcceptProposal", row.data.session_id, row.data.path, row.data.hunk_id);
    } else if event.action == "A" {
        red::execute("AgentAcceptProposal", row.data.session_id, row.data.path, "");
    } else if event.action == "r" {
        red::execute("AgentRejectProposal", row.data.session_id, row.data.path, row.data.hunk_id);
    } else if event.action == "R" {
        red::execute("AgentRejectProposal", row.data.session_id, row.data.path, "");
    }
}

fn show_proposal_detail(row: AgentProposalRow) {
    if row.data.hunk_id == "" {
        return;
    }
    let detail = [];
    let old_lines = red::split(row.data.old_text, "\n");
    let old_index = 0;
    while old_index < red::len(old_lines) && red::len(detail) < 400 {
        detail = red::push(detail, [PanelSegment { text: "- " + old_lines[old_index], style: warning_style() }]);
        old_index = old_index + 1;
    }
    let new_lines = red::split(row.data.new_text, "\n");
    let new_index = 0;
    while new_index < red::len(new_lines) && red::len(detail) < 400 {
        detail = red::push(detail, [PanelSegment { text: "+ " + new_lines[new_index], style: success_style() }]);
        new_index = new_index + 1;
    }
    if old_index < red::len(old_lines) || new_index < red::len(new_lines) {
        detail = red::push(detail, [PanelSegment {
            text: "… detail limited to 400 lines",
            style: muted_style(),
        }]);
    }
    red::state_patch(AgentState { detail: detail });
    refresh_proposals();
}

#[red::on("agent:proposals_changed")]
#[red::on("agent:proposal_applied")]
fn proposals_changed(event: AgentSessionEvent) {
    if !is_current_session(event.session_id) && !state().review_open {
        return;
    }
    refresh_proposals();
    if !state().review_open && !state().proposal_notice {
        red::request("AgentProposals", proposals_ready, state().session_id);
    }
}

fn proposals_ready(result: AgentProposalsResult) {
    let files = red::len(result.files);
    if files == 0 || state().review_open || state().proposal_notice {
        return;
    }
    let hunks = 0;
    let file_index = 0;
    while file_index < red::len(result.files) && file_index < 500 {
        hunks = hunks + red::len(result.files[file_index].hunks);
        file_index = file_index + 1;
    }
    red::state_patch(AgentState { proposal_notice: true });
    red::execute("Print", "Agent changes ready: " + files + " files, " + hunks + " hunks. Use :AgentReview to review before applying");
}

#[red::on("agent:proposal_conflict")]
fn proposal_conflict(event: AgentProposalConflictEvent) {
    red::execute("Print", "Agent proposal conflicts with current buffer: " + event.path);
    refresh_proposals();
}

#[red::command(
    name = "AgentHistory",
    title = "Show agent history",
    category = "Agent",
    description = "Inspect previous agent transactions",
    aliases = ["transactions"],
)]
fn history() {
    red::state_patch(AgentState { history_open: true });
    red::execute("OpenWorkspace", "agent-history", WorkspaceConfig {
        title: "Attributed edit history",
        detail_ratio: 58,
        min_two_pane_width: 88,
    });
    refresh_history();
}

fn refresh_history() {
    if state().history_open {
        red::request("EditHistory", render_history);
    }
}

fn render_history(result: AgentHistoryResult) {
    let rows = [];
    let index = 0;
    while index < red::len(result.entries) && index < 500 {
        let entry = result.entries[index];
        let origin = entry.origin.kind;
        if origin == "agent" {
            origin = "agent " + entry.origin.session_id + "/" + entry.origin.turn_id;
        }
        let current_marker = "  ";
        if entry.current { current_marker = "* "; }
        rows = red::push(rows, WorkspaceRow {
            id: "transaction:" + entry.transaction_id,
            selectable: true,
            segments: [
                PanelSegment { text: current_marker, style: heading_style() },
                PanelSegment { text: entry.label, style: normal_style() },
            ],
            right_segments: [PanelSegment { text: origin, style: muted_style() }],
            data: AgentHistoryRowData { transaction_id: entry.transaction_id, edits: entry.edits },
        });
        index = index + 1;
    }
    if index < red::len(result.entries) {
        rows = red::push(rows, WorkspaceRow {
            id: "history-truncated",
            selectable: false,
            segments: [PanelSegment { text: "… history limited to 500 entries", style: muted_style() }],
        });
    }
    if red::len(rows) == 0 {
        rows = red::push(rows, WorkspaceRow {
            id: "empty",
            selectable: false,
            segments: [PanelSegment { text: "No edit transactions", style: muted_style() }],
        });
    }
    red::execute("UpdateWorkspace", "agent-history", WorkspaceModel {
        rows: rows,
        detail: state().history_detail,
        footer: [PanelSegment { text: "r safe revert  q close", style: muted_style() }],
    });
}

#[red::on("workspace:event:agent-history")]
fn history_event(event: AgentHistoryEvent) {
    if event.action == "q" || event.action == "escape" {
        red::state_patch(AgentState { history_open: false });
        red::execute("CloseWorkspace", "agent-history");
        return;
    }
    let row = event.row;
    if row == red::null() || row.data.transaction_id == red::null() {
        return;
    }
    if event.action == "r" {
        red::execute("RevertTransaction", row.data.transaction_id);
        refresh_history();
        return;
    }
    if event.action == "up" || event.action == "down" || event.action == "page_up" || event.action == "page_down" {
        let detail = [];
        for edit in row.data.edits {
            detail = red::push(detail, [PanelSegment { text: "- " + edit.old_text, style: warning_style() }]);
            detail = red::push(detail, [PanelSegment { text: "+ " + edit.new_text, style: success_style() }]);
        }
        red::state_patch(AgentState { history_detail: detail });
        refresh_history();
    }
}

#[red::on("agent:permission_requested")]
fn permission_requested(event: AgentPermissionEvent) {
    if !is_current_session(event.session_id) {
        return;
    }
    red::state_patch(AgentState { permission_request_id: event.request_id });
    let items = [];
    for option in event.options {
        items = red::push(items, PickerItem {
            id: option.option_id,
            label: option.name,
            kind: "Permission",
            annotation: red::string(option.kind, "permission") + " · " + option.option_id,
            detail: "Codex permission option " + option.option_id,
            data: Json { option_id: option.option_id },
        });
    }
    red::execute("OpenPicker", "Agent permission", items, PickerOptions {
        placeholder: "Choose an exact option from the agent",
        status: red::len(items) + " options",
        presentation: "compact",
    }, PickerHandlers {
        selected: permission_selected,
        cancelled: permission_cancelled,
    });
}

fn permission_selected(item: PickerItem) {
    red::execute(
        "AgentPermissionResponse",
        state().permission_request_id,
        item.data.option_id
    );
    red::state_patch(AgentState { permission_request_id: "" });
}

fn is_current_session(session_id: String) -> bool {
    return session_id == "" || session_id == red::string(state().session_id, "");
}

fn permission_cancelled(event: PickerCancelled) {
    red::execute("AgentPermissionResponse", state().permission_request_id, "");
    red::state_patch(AgentState { permission_request_id: "" });
}

fn normal_style() -> Style {
    return Style { fg: red::null(), bg: red::null(), bold: false, italic: false };
}
fn muted_style() -> Style { return normal_style(); }
fn heading_style() -> Style {
    let style = normal_style();
    style.bold = true;
    return style;
}
fn success_style() -> Style { return normal_style(); }
fn warning_style() -> Style {
    let style = normal_style();
    style.bold = true;
    return style;
}

#[red::lifecycle("deactivate")]
fn deactivate() {
    let session_id = red::string(state().session_id, "");
    if session_id != "" {
        red::execute("AgentCloseSession", session_id);
    }
    red::execute("SetTextPanelStatus", "agent-conversation");
    red::state_patch(AgentState { session_id: "" });
    red::state_patch(AgentState { cancelled_session_id: "" });
    red::state_patch(AgentState { review_open: false });
    red::state_patch(AgentState { permission_request_id: "" });
    let timer = red::string(state().stream_timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
        red::state_patch(AgentState { stream_timer: "" });
    }
}
