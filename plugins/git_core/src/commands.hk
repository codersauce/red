// Typed command construction for operations where an invalid combination can
// change repository history or the working tree.

enum ApplyTarget {
    Stage,
    Unstage,
    Reset,
}

enum DiffTarget {
    Worktree,
    Index,
}

enum HunkView {
    Navigation,
    Selection,
}

enum CommitMode {
    Create,
    Amend,
    AmendNoEdit,
}

pub fn status_args() -> [String] {
    [
        "status",
        "--porcelain=v2",
        "--branch",
        "--show-stash",
        "-z",
        "--untracked-files=all",
    ]
}

pub fn sign_diff_args(staged: bool, paths: [String]) -> [String] {
    let mut args = ["-c", "core.quotePath=false", "diff"];
    if staged {
        args.push("--cached");
    }
    args.push("--no-ext-diff");
    args.push("--no-prefix");
    args.push("--unified=0");
    args.push("--");
    for path in paths {
        args.push(path);
    }
    args
}

pub fn detail_diff_args(section: String, path: String) -> [String] {
    if section == "untracked" {
        return [
            "diff",
            "--no-index",
            "--no-ext-diff",
            "--color=never",
            "--src-prefix=a/",
            "--dst-prefix=b/",
            "--",
            "/dev/null",
            path,
        ];
    }
    let target = diff_target(section);
    let mut args = ["diff"];
    match target {
        DiffTarget::Index => args.push("--cached"),
        DiffTarget::Worktree => {},
    };
    args.push("--no-ext-diff");
    args.push("--color=never");
    args.push("--");
    args.push(path);
    args
}

pub fn hunk_diff_args(action: String, path: String) -> [String] {
    let target = diff_target(action);
    let view = hunk_view(action);
    let mut args = ["diff"];
    match target {
        DiffTarget::Index => args.push("--cached"),
        DiffTarget::Worktree => {},
    };
    args.push("--no-ext-diff");
    match view {
        HunkView::Navigation => args.push("--unified=0"),
        HunkView::Selection => args.push("--unified=3"),
    };
    args.push("--");
    args.push(path);
    args
}

pub fn commit_args(mode: String) -> [String] {
    let mode = commit_mode(mode);
    let mut args = ["commit"];
    let mut no_edit = false;
    match mode {
        CommitMode::Create => {},
        CommitMode::Amend => args.push("--amend"),
        CommitMode::AmendNoEdit => {
            args.push("--amend");
            args.push("--no-edit");
            no_edit = true;
        },
    };
    if no_edit {
        return args;
    }
    args.push("--cleanup=strip");
    args.push("-F");
    args.push("-");
    args
}

pub fn commit_history_args(count: i32) -> [String] {
    if count < 0 { count = 0; }
    if count > 50 { count = 50; }
    return [
        "log",
        "--no-merges",
        "-n",
        "" + count,
        "--format=%H%n%B%x1e",
    ];
}

pub fn apply_hunk_args(action: String) -> [String] {
    if action != "stage" && action != "unstage" && action != "reset" {
        return [];
    }
    let target = apply_target(action);
    let mut args = ["apply"];

    match target {
        ApplyTarget::Stage => args.push("--cached"),
        ApplyTarget::Unstage => {
            args.push("--cached");
            args.push("--reverse");
        },
        ApplyTarget::Reset => args.push("--reverse"),
    };
    args.push("--unidiff-zero");
    args.push("-");
    args
}

fn apply_target(action: String) -> ApplyTarget {
    if action == "stage" {
        return ApplyTarget::Stage;
    }
    if action == "unstage" {
        return ApplyTarget::Unstage;
    }
    if action == "reset" {
        return ApplyTarget::Reset;
    }
    ApplyTarget::Reset
}

fn diff_target(value: String) -> DiffTarget {
    if value == "staged" || value == "unstage" {
        return DiffTarget::Index;
    }
    DiffTarget::Worktree
}

fn hunk_view(action: String) -> HunkView {
    if action == "next" || action == "previous" {
        return HunkView::Navigation;
    }
    HunkView::Selection
}

fn commit_mode(mode: String) -> CommitMode {
    if mode == "--amend" {
        return CommitMode::AmendNoEdit;
    }
    if mode == "amend" {
        return CommitMode::Amend;
    }
    CommitMode::Create
}

// Range argv is data. The plugin spawns `git` with the array and never builds
// a shell string. A second token stays unresolved until the plugin's own
// `rev-parse` accepts it.
pub struct GitDiffInvocation {
    ok: bool,
    error: String,
    source: String,
    label: String,
    revs: [String],
    paths: [String],
    pending_token: String,
}

pub fn parse_git_diff_invocation(args: [String]) -> GitDiffInvocation {
    let mut range = [];
    let mut paths = [];
    let mut seen_separator = false;
    for arg in args {
        if !seen_separator && arg == "--" {
            seen_separator = true;
        } else if seen_separator {
            paths.push(arg);
        } else {
            range.push(arg);
        }
    }
    if seen_separator && paths.is_empty() {
        return invalid_invocation("GitDiff requires a path after --");
    }
    if range.is_empty() {
        return invalid_invocation("GitDiff requires a range");
    }
    if range.len() > 2 {
        return invalid_invocation("GitDiff paths belong after --");
    }
    let first = range[0];
    if first == "cached" || first == "staged" {
        if range.len() != 1 {
            return invalid_invocation("GitDiff staged does not take a second revision");
        }
        return GitDiffInvocation {
            ok: true,
            error: "",
            source: "cached",
            label: "staged",
            revs: [],
            paths: paths,
            pending_token: "",
        };
    }
    if first == "working" {
        if range.len() != 1 {
            return invalid_invocation("GitDiff working does not take a second revision");
        }
        return GitDiffInvocation {
            ok: true,
            error: "",
            source: "working",
            label: "working tree",
            revs: [],
            paths: paths,
            pending_token: "",
        };
    }
    if range.len() == 1 {
        return GitDiffInvocation {
            ok: true,
            error: "",
            source: "ref",
            label: first,
            revs: [first],
            paths: paths,
            pending_token: "",
        };
    }
    GitDiffInvocation {
        ok: true,
        error: "",
        source: "needs_rev",
        label: first + " " + range[1],
        revs: [first],
        paths: paths,
        pending_token: range[1],
    }
}

pub fn range_name_status_args(source: String, revs: [String], paths: [String]) -> [String] {
    let mut args = ["-c", "core.quotePath=false", "diff", "--name-status", "-z", "--find-renames"];
    append_range(args, source, revs, paths)
}

pub fn range_diff_args(source: String, revs: [String], paths: [String]) -> [String] {
    let mut args = [
        "-c", "core.quotePath=false", "diff",
        "--no-color", "--no-ext-diff", "--color=never",
        "--src-prefix=a/", "--dst-prefix=b/",
        "--find-renames", "--full-index",
    ];
    append_range(args, source, revs, paths)
}

pub fn range_numstat_args(source: String, revs: [String], paths: [String]) -> [String] {
    let mut args = ["-c", "core.quotePath=false", "diff", "--numstat", "-z", "--find-renames"];
    append_range(args, source, revs, paths)
}

fn append_range(args: [String], source: String, revs: [String], paths: [String]) -> [String] {
    let mut args = args;
    if source == "cached" {
        args.push("--cached");
    } else if source == "ref" || source == "revs" {
        for rev in revs {
            args.push(rev);
        }
    }
    if !paths.is_empty() {
        args.push("--");
        for path in paths {
            args.push(path);
        }
    }
    args
}

fn invalid_invocation(message: String) -> GitDiffInvocation {
    GitDiffInvocation {
        ok: false,
        error: message,
        source: "",
        label: "",
        revs: [],
        paths: [],
        pending_token: "",
    }
}

#[test]
fn builds_explicit_apply_modes() {
    assert(apply_hunk_args("stage").join(" ") == "apply --cached --unidiff-zero -");
    assert(apply_hunk_args("unstage").join(" ") == "apply --cached --reverse --unidiff-zero -");
    assert(apply_hunk_args("reset").join(" ") == "apply --reverse --unidiff-zero -");
    assert(apply_hunk_args("unknown").is_empty());
}

#[test]
fn builds_bounded_noninteractive_status_and_diff_commands() {
    assert(status_args().join(" ") == "status --porcelain=v2 --branch --show-stash -z --untracked-files=all");
    assert(sign_diff_args(false, ["src/a.rs"]).join(" ") == "-c core.quotePath=false diff --no-ext-diff --no-prefix --unified=0 -- src/a.rs");
    assert(sign_diff_args(true, ["src/a.rs", "src/b.rs"]).join(" ") == "-c core.quotePath=false diff --cached --no-ext-diff --no-prefix --unified=0 -- src/a.rs src/b.rs");
    assert(detail_diff_args("staged", "src/a.rs").join(" ") == "diff --cached --no-ext-diff --color=never -- src/a.rs");
    assert(detail_diff_args("unstaged", "src/a.rs").join(" ") == "diff --no-ext-diff --color=never -- src/a.rs");
    assert(detail_diff_args("untracked", "src/new file.rs").join(" ") == "diff --no-index --no-ext-diff --color=never --src-prefix=a/ --dst-prefix=b/ -- /dev/null src/new file.rs");
}

#[test]
fn builds_navigation_selection_and_commit_modes_explicitly() {
    assert(hunk_diff_args("next", "src/a.rs").join(" ") == "diff --no-ext-diff --unified=0 -- src/a.rs");
    assert(hunk_diff_args("unstage", "src/a.rs").join(" ") == "diff --cached --no-ext-diff --unified=3 -- src/a.rs");
    assert(commit_args("create").join(" ") == "commit --cleanup=strip -F -");
    assert(commit_args("amend").join(" ") == "commit --amend --cleanup=strip -F -");
    assert(commit_args("--amend").join(" ") == "commit --amend --no-edit");
    assert(commit_history_args(20).join(" ") == "log --no-merges -n 20 --format=%H%n%B%x1e");
    assert(commit_history_args(100).join(" ") == "log --no-merges -n 50 --format=%H%n%B%x1e");
}

#[test]
fn parses_git_diff_ranges_and_requires_a_path_separator() {
    let cached = parse_git_diff_invocation(["cached", "--", "src/a.rs"]);
    assert(cached.ok);
    assert(cached.source == "cached");
    assert(cached.label == "staged");
    assert(cached.paths.join(" ") == "src/a.rs");

    let staged = parse_git_diff_invocation(["staged"]);
    assert(staged.source == "cached");
    let working = parse_git_diff_invocation(["working", "--", "src/a.rs", "src/b.rs"]);
    assert(working.source == "working");
    assert(working.paths.join(" ") == "src/a.rs src/b.rs");

    let one = parse_git_diff_invocation(["HEAD~2"]);
    assert(one.source == "ref");
    assert(one.revs.join(" ") == "HEAD~2");
    let dotted = parse_git_diff_invocation(["main..feature"]);
    assert(dotted.source == "ref");
    assert(dotted.label == "main..feature");

    let two = parse_git_diff_invocation(["main", "feature", "--", "src/a.rs"]);
    assert(two.ok);
    assert(two.source == "needs_rev");
    assert(two.pending_token == "feature");
    assert(two.revs.join(" ") == "main");
    assert(two.label == "main feature");
    assert(two.paths.join(" ") == "src/a.rs");

    let missing = parse_git_diff_invocation([]);
    assert(!missing.ok);
    let bare_separator = parse_git_diff_invocation(["HEAD", "--"]);
    assert(!bare_separator.ok);
    let extra = parse_git_diff_invocation(["HEAD", "feature", "src/a.rs"]);
    assert(!extra.ok);
    assert(extra.error == "GitDiff paths belong after --");
    let staged_rev = parse_git_diff_invocation(["cached", "HEAD"]);
    assert(!staged_rev.ok);
}

#[test]
fn builds_range_diff_argv_without_a_shell_string() {
    assert(range_name_status_args("cached", [], ["src/a.rs"]).join(" ") == "-c core.quotePath=false diff --name-status -z --find-renames --cached -- src/a.rs");
    assert(range_name_status_args("working", [], []).join(" ") == "-c core.quotePath=false diff --name-status -z --find-renames");
    assert(range_name_status_args("ref", ["HEAD~2"], []).join(" ") == "-c core.quotePath=false diff --name-status -z --find-renames HEAD~2");
    assert(range_name_status_args("revs", ["main", "feature"], ["src/a.rs"]).join(" ") == "-c core.quotePath=false diff --name-status -z --find-renames main feature -- src/a.rs");
    assert(range_diff_args("revs", ["main", "feature"], ["old name.rs", "new name.rs"]).join(" ") == "-c core.quotePath=false diff --no-color --no-ext-diff --color=never --src-prefix=a/ --dst-prefix=b/ --find-renames --full-index main feature -- old name.rs new name.rs");
    assert(range_numstat_args("cached", [], []).join(" ") == "-c core.quotePath=false diff --numstat -z --find-renames --cached");
    assert(range_diff_args("working", [], ["notes.txt"]).join(" ") == "-c core.quotePath=false diff --no-color --no-ext-diff --color=never --src-prefix=a/ --dst-prefix=b/ --find-renames --full-index -- notes.txt");
}
