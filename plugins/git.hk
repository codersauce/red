    return GitPluginState {
        dashboard_open: false,
        process: "",
        status_initialized: false,
        status_output: "",
        refresh_forced: true,
        idle_polls: 0,
        refresh_timer: "",
        poll_timer: "",
        watch_path: "",
        command_log: [],
        info: None,
        executable: "red",
        sign_glyphs: GitSignGlyphs {
            add: "+",
            change: "~",
            delete: "_",
            topdelete: "‾",
            changedelete: "~",
        },
        staged_sign_glyphs: GitSignGlyphs {
            add: "┃",
            change: "┃",
            delete: "▁",
            topdelete: "▔",
            changedelete: "~",
        },
        root: ".",
        state: empty_state(),
        hunk_action: "",
        hunk_path: "",
        hunk_patch: "",
        hunk_buffer: -1,
        hunk_selection: None,
        hunk_unsaved: false,
        hunk_disk_path: "",
        commit_mode: "",
        commit_snapshot: red::null(),
        commit_buffer: -1,
        commit_retry_text: "",
        commit_process: "",
        commit_error: "",
        commit_draft_text: "",
        commit_context_process: "",
        commit_context_output: "",
        commit_context_error: "",
        commit_generate_message: false,
        commit_history_count: 20,
        commit_history_process: "",
        commit_history_output: "",
        commit_history_error: "",
        signs: [],
        sign_jobs: [],
        prompt_kind: "",
        prompt_picker: None,
        capture_kind: "",
        capture_output: "",
        operation: "",
        operation_jobs: [],
        operation_candidate: "",
        detail: [[PanelSegment {
            text: "Select a change to inspect its diff.",
            style: Style { fg: red::null(), bg: red::null(), bold: false, italic: false },
        }]],
        detail_document: None,
        detail_process: "",
        detail_output: "",
        detail_pending_output: "",
        detail_error: "",
        detail_status: "",
        detail_suppressed: false,
        stats: Json {},
        stats_process: "",
        stats_section: "",
        stats_output: "",
        detail_path: "",
        detail_section: "",
        detail_rendered_path: "",
        detail_rendered_section: "",
        detail_timer: "",
        pending_detail_row: None,
        row_action_process: "",
        row_action_error: "",
        git_task_process: "",
        git_task_error: "",
        git_task_operation: "",
        git_task_start_message: "",
        git_task_success_message: "",
        git_task_busy_timer: "",
        git_task_done_timer: "",
        safe_sync_pending: false,
        push_preview_process: "",
        push_preview_stage: "",
        push_preview_output: "",
        push_preview_error: "",
        push_remote: "",
        push_target: "",
        push_args: [],
        push_count: 0,
        push_process: "",
        push_error: "",
        push_done_timer: "",
        confirm_mode: "",
        confirm_args: [],
        pending_commit_message: "",
        apply_check_process: "",
        apply_check_action: "",
        apply_check_patch: "",
        confirm_operation: "",
        confirm_action: "",
        tag_name: "",
        remote_name: "",
        reset_target: "",
        worktree_path: "",
