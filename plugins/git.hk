fn commit_menu() {
    red::execute("OpenPicker", "Commit", [
        PickerItem { id: "generate", label: "Generate message", kind: "Codex" },
        PickerItem { id: "create", label: "Write message", kind: "Manual" },
        PickerItem { id: "amend", label: "Amend commit", kind: "Amend" },
        PickerItem { id: "no-edit", label: "Amend without editing", kind: "Amend" },
        PickerItem { id: "cancel", label: "Cancel", kind: "Cancel" },
    ], PickerOptions {}, PickerHandlers {
        selected: commit_choice,
    });
}

fn commit_choice(item: PickerItem) {
    if item.id == "cancel" {
        return;
    }
    if item.id == "no-edit" {
        red::state_patch(GitPluginState { confirm_mode: "commit-no-edit" });
        open_confirmation("Amend commit", "Rewrite HEAD while keeping its message.");
        return;
    }
    let mode = item.id;
    let generate = item.id == "generate";
    if generate { mode = "create"; }
    red::state_patch(GitPluginState { commit_mode: mode });
    red::state_patch(GitPluginState { commit_generate_message: generate });
    if generate {
        begin_git_progress("Preparing commit message context…");
    }
    red::request("GetEditorState", commit_snapshot_loaded);
}

fn commit_snapshot_loaded(snapshot: Json) {
    // Editor snapshots are opaque capabilities that are only stored and passed back.
    red::state_patch(GitPluginState { commit_snapshot: snapshot });
    let text = red::string(plugin_state().commit_retry_text, "");
    red::state_patch(GitPluginState { commit_retry_text: "" });
    red::state_patch(GitPluginState { commit_draft_text: text });
    if text != "" {
        red::state_patch(GitPluginState { commit_generate_message: false });
    }
    red::state_patch(GitPluginState { commit_context_output: "" });
    red::state_patch(GitPluginState { commit_context_error: "" });
    red::state_patch(GitPluginState { commit_history_output: "" });
    red::state_patch(GitPluginState { commit_history_error: "" });
    let process_id = red::execute("SpawnProcess", Process {
        command: "git",
        args: ["diff", "--cached", "--stat", "--patch", "--no-ext-diff", "--color=never"],
        env: Json { GIT_PAGER: "cat", LC_ALL: "C" },
        raw_output: true,
        cwd: red::string(plugin_state().root, "."),
    });
    red::state_patch(GitPluginState { commit_context_process: process_id });
    red::on("process:" + process_id, commit_context_event);
}

fn commit_context_event(event: ProcessEvent) {
    match event {
        ProcessEvent::Stdout { process_id, line, plugin_name } => {
            if process_id == plugin_state().commit_context_process {
                red::state_patch(GitPluginState {
                    commit_context_output: plugin_state().commit_context_output + line,
                });
            }
        }
        ProcessEvent::Stderr { process_id, line, plugin_name } => {
            if process_id == plugin_state().commit_context_process {
                red::state_patch(GitPluginState {
                    commit_context_error: plugin_state().commit_context_error + line,
                });
            }
        }
        ProcessEvent::Exit { process_id, code, plugin_name } => {
            let exit_code = 1;
            if let Some(value) = code { exit_code = value; }
            if exit_code == 0 {
                finish_commit_context(process_id);
            } else {
                fail_commit_context(process_id, "git diff exited with code " + exit_code);
            }
        }
        ProcessEvent::Error { process_id, message, plugin_name } => {
            fail_commit_context(process_id, message);
        }
    }
}

fn fail_commit_context(process_id: String, fallback: String) {
    if process_id != plugin_state().commit_context_process { return; }
    red::state_patch(GitPluginState { commit_context_process: "" });
    let error = red::trim(red::string(plugin_state().commit_context_error, ""));
    if error == "" { error = fallback; }
    if red::bool(plugin_state().commit_generate_message, false) {
        complete_git_progress("Commit message preparation failed: " + bounded_git_error(error), false);
    }
    red::execute("Print", "Could not read staged changes: " + error);
    open_commit_editor(red::string(plugin_state().commit_draft_text, ""));
}

fn finish_commit_context(process_id: String) {
    if process_id != plugin_state().commit_context_process {
        return;
    }
    red::state_patch(GitPluginState { commit_context_process: "" });
    if red::bool(plugin_state().commit_generate_message, false) {
        if red::trim(red::string(plugin_state().commit_context_output, "")) == "" {
            complete_git_progress("No staged changes to describe", false);
            red::execute("Print", "No staged changes to describe; opening a blank commit message");
            open_commit_editor("");
            return;
        }
        let count = red::int(plugin_state().commit_history_count, 20);
        if count <= 0 {
            request_generated_commit_message();
            return;
        }
        update_git_progress("Generating commit message with Codex…");
        red::execute("Print", "Generating commit message with Codex…");
        let process_id = red::execute("SpawnProcess", Process {
            command: "git",
            args: red::git_core("commit_history_args", count),
            env: Json { GIT_PAGER: "cat", LC_ALL: "C" },
            raw_output: true,
            cwd: red::string(plugin_state().root, "."),
        });
        red::state_patch(GitPluginState { commit_history_process: process_id });
        red::on("process:" + process_id, commit_history_event);
        return;
    }
    open_commit_editor(red::string(plugin_state().commit_draft_text, ""));
}

fn commit_history_event(event: ProcessEvent) {
    match event {
        ProcessEvent::Stdout { process_id, line, plugin_name } => {
            if process_id == plugin_state().commit_history_process {
                red::state_patch(GitPluginState {
                    commit_history_output: plugin_state().commit_history_output + line,
                });
            }
        }
        ProcessEvent::Stderr { process_id, line, plugin_name } => {
            if process_id == plugin_state().commit_history_process {
                red::state_patch(GitPluginState {
                    commit_history_error: plugin_state().commit_history_error + line,
                });
            }
        }
        ProcessEvent::Exit { process_id, code, plugin_name } => {
            let exit_code = 1;
            if let Some(value) = code { exit_code = value; }
            if exit_code != 0 {
                warn_commit_history(process_id, "git log exited with code " + exit_code);
            } else {
                finish_commit_history(process_id);
            }
        }
        ProcessEvent::Error { process_id, message, plugin_name } => {
            warn_commit_history(process_id, message);
        }
    }
}

fn warn_commit_history(process_id: String, fallback: String) {
    if process_id != plugin_state().commit_history_process { return; }
    let error = red::trim(red::string(plugin_state().commit_history_error, ""));
    if error == "" { error = fallback; }
    red::execute(
        "Print",
        "Could not read recent commit history; generating from staged changes only: " + error
    );
    red::state_patch(GitPluginState { commit_history_output: "" });
    finish_commit_history(process_id);
}

fn finish_commit_history(process_id: String) {
    if process_id != plugin_state().commit_history_process { return; }
    red::state_patch(GitPluginState { commit_history_process: "" });
    request_generated_commit_message();
}

fn request_generated_commit_message() {
    let state = plugin_state().state;
    red::request(
        "GenerateCommitMessage",
        commit_message_generated,
        red::string(plugin_state().root, "."),
        Json {
            branch: red::string(state.head, ""),
            staged_diff: red::string(plugin_state().commit_context_output, ""),
            recent_commits: red::string(plugin_state().commit_history_output, ""),
        }
    );
}

fn commit_message_generated(result: Json) {
    let message = red::trim(red::string(result.message, ""));
    let error = red::trim(red::string(result.error, ""));
    if error != "" {
        complete_git_progress("Commit message generation failed: " + bounded_git_error(error), false);
        red::execute("Print", "Codex could not generate a commit message: " + error);
    } else {
        complete_git_progress("✓ Commit message generated", true);
    }
    open_commit_editor(message);
}

fn open_commit_editor(message: String) {
    let text = commit_editor_text(
        message,
        red::string(plugin_state().commit_context_output, "")
    );
    red::state_patch(GitPluginState { commit_draft_text: "" });
    red::state_patch(GitPluginState { commit_history_output: "" });
    red::state_patch(GitPluginState { commit_generate_message: false });
    red::request(
        "OpenScratchBuffer",
        commit_scratch_opened,
        "[Git Commit].gitcommit",
        text,
        ScratchBufferOptions {
            syntax: "gitcommit",
            submit: "GitSubmitMessage",
            cancel: "GitCancelMessage"
        }
    );
}

fn commit_scratch_opened(event: GitScratchOpenedEvent) {
    red::state_patch(GitPluginState { commit_buffer: red::int(event.buffer_index, -1) });
    close_dashboard();
}

fn restore_finished(result: GitRestoreResult) {
    if !red::bool(result.restored, false) {
        red::log("Git scratch restore did not restore editor state", result.warnings);
    }
}

fn commit_buffer_text(event: GitBufferTextEvent) {
    if red::int(plugin_state().commit_buffer, -1) < 0 {
        return;
    }
    finish_commit_scratch(true, red::string(event.text, ""));
}

fn finish_commit_scratch(submit: bool, text: String) {
    let index = red::int(plugin_state().commit_buffer, -1);
    if index < 0 {
        return;
    }
    red::execute("CloseScratchBuffer", index);
    let snapshot = plugin_state().commit_snapshot;
    if snapshot != red::null() {
        red::request("RestoreEditorState", restore_finished, snapshot);
    }
    red::state_patch(GitPluginState { commit_buffer: -1 });
    if submit {
        let message = commit_message(text);
        if message != "" {
            let mode = red::string(plugin_state().commit_mode, "");
            if mode == "amend" {
                confirm_commit(mode, message);
            } else {
                run_commit(mode, message);
            }
        }
    }
}

fn commit_context_marker() -> String {
    return "# --- Red commit context (not part of the commit message) ---";
}

fn commit_message(text: String) -> String {
    let message_lines = [];
    for line in red::split(text, "\n") {
        if line == commit_context_marker() {
            break;
        }
        message_lines = red::push(message_lines, line);
    }
    return red::trim(red::join(message_lines, "\n"));
}

fn commit_editor_text(message: String, staged_diff: String) -> String {
    let text = message;
    if text == "" {
        text = "\n";
    } else if !red::ends_with(text, "\n") {
        text = text + "\n";
    }
    text = text + "\n" + commit_context_marker() + "\n";
    text = text + "# Write the commit message above. :w or :wq submits; :q cancels.\n#\n";

    let state = plugin_state().state;
    let branch = red::string(state.head, "");
    if branch != "" {
        text = text + "# On branch " + branch + "\n";
    }
    text = append_commit_status(text, "Changes to be committed", state.staged);
    text = append_commit_status(text, "Changes not staged for commit", state.unstaged);
    text = append_commit_status(text, "Unmerged paths", state.conflicted);
    text = append_commit_status(text, "Untracked files", state.untracked);

    if red::trim(staged_diff) != "" {
        text = text + "#\n# Staged diff:\n#\n" + commented_diff(staged_diff);
    }
    return text;
}

fn append_commit_status(text: String, title: String, entries: [GitEntry]) -> String {
    if red::len(entries) == 0 {
        return text;
    }
    text = text + "#\n# " + title + ":\n#\n";
    for entry in entries {
        let status = red::string(entry.x, "?");
        if status == " " || status == "?" {
            status = red::string(entry.y, "?");
        }
        let path = entry.path;
        if let Some(original) = entry.original_path {
            path = original + " -> " + path;
        }
        text = text + "#   " + status + "  " + path + "\n";
    }
    return text;
}

fn commented_diff(diff: String) -> String {
    let commented = [];
    let lines = red::split(diff, "\n");
    let index = 0;
    while index < red::len(lines) && index < 2000 {
        commented = red::push(commented, "# " + lines[index]);
        index = index + 1;
    }
    if index < red::len(lines) {
        commented = red::push(commented, "# … staged diff truncated after 2000 lines");
    }
    return red::join(commented, "\n") + "\n";
}

fn run_commit(mode: String, message: String) {
    if red::string(plugin_state().git_task_process, "") != "" ||
        red::string(plugin_state().commit_process, "") != "" {
        red::execute("Print", "A Git operation is already in progress");
        return;
    }
    red::state_patch(GitPluginState { commit_mode: mode });
    if mode == "amend" || mode == "--amend" {
        begin_git_progress("Amending commit…");
    } else {
        begin_git_progress("Creating commit…");
    }
    let process_id = red::execute("SpawnProcess", Process {
        command: "git",
        args: red::git_core("commit_args", mode),
        stdin: message + "\n",
        cwd: red::string(plugin_state().root, "."),
    });
    red::state_patch(GitPluginState { commit_retry_text: message });
    red::state_patch(GitPluginState { commit_process: process_id });
    red::state_patch(GitPluginState { commit_error: "" });
    red::on("process:" + process_id, commit_finished);
}

fn commit_finished(event: ProcessEvent) {
    match event {
        ProcessEvent::Stderr { process_id, line, plugin_name } => {
            if process_id == plugin_state().commit_process {
                red::state_patch(GitPluginState {
                    commit_error: plugin_state().commit_error + line + "\n",
                });
            }
        }
        ProcessEvent::Error { process_id, message, plugin_name } => {
            fail_commit(process_id, message);
        }
        ProcessEvent::Exit { process_id, code, plugin_name } => {
            if process_id != plugin_state().commit_process { return; }
            let exit_code = 1;
            if let Some(value) = code { exit_code = value; }
            if exit_code == 0 {
                let mode = red::string(plugin_state().commit_mode, "");
                red::state_patch(GitPluginState { commit_process: "" });
                red::state_patch(GitPluginState { commit_error: "" });
                red::state_patch(GitPluginState { commit_retry_text: "" });
                if mode == "amend" || mode == "--amend" {
                    complete_git_progress("✓ Commit amended successfully", true);
                } else {
                    complete_git_progress("✓ Commit created successfully", true);
                }
                force_refresh();
            } else {
                fail_commit(process_id, "git commit exited with code " + exit_code);
            }
        }
        ProcessEvent::Stdout { process_id, line, plugin_name } => {}
    }
}

fn fail_commit(process_id: String, fallback: String) {
    if process_id != plugin_state().commit_process { return; }
    let error = red::trim(red::string(plugin_state().commit_error, ""));
    if error == "" { error = fallback; }
    red::state_patch(GitPluginState { commit_process: "" });
    red::state_patch(GitPluginState { commit_error: "" });
    let compact_error = bounded_git_error(error);
    complete_git_progress("Git commit failed: " + compact_error, false);
    if compact_error != error {
        red::execute("Print", "Git commit details: " + error);
    }
    red::request("GetEditorState", commit_snapshot_loaded);
}

fn begin_hunk_action(action: String) {
    red::state_patch(GitPluginState { hunk_action: action });
    red::request("GetWindows", hunk_windows_loaded);
}

fn hunk_windows_loaded(result: GitWindowsResult) {
    let path = "";
    let buffer_index = -1;
    for window in result.windows {
        if red::bool(window.active, false) {
            path = red::string(window.buffer_path, "");
            buffer_index = red::int(window.buffer_index, -1);
        }
    }
    if path == "" {
        return;
    }
    red::state_patch(GitPluginState { hunk_path: path });
    red::state_patch(GitPluginState { hunk_disk_path: path });
    red::state_patch(GitPluginState { hunk_path: repository_path(path) });
    red::state_patch(GitPluginState { hunk_buffer: buffer_index });
    red::state_patch(GitPluginState { hunk_selection: None });
    let action = red::string(plugin_state().hunk_action, "");
    if action == "stage" {
        red::request("GetBufferText", hunk_buffer_text);
        return;
    }
    spawn_hunk_diff(action);
}

fn hunk_buffer_text(event: GitBufferTextEvent) {
    red::state_patch(GitPluginState { hunk_unsaved: true });
    red::state_patch(GitPluginState { hunk_patch: "" });
    let path = red::string(plugin_state().hunk_path, "");
    let disk_path = red::string(plugin_state().hunk_disk_path, "");
    let process_id = red::execute("SpawnProcess", Process {
        command: "git",
        args: ["diff", "--no-index", "--no-ext-diff", "--unified=3", "--", disk_path, "-"],
        stdin: red::string(event.text, ""),
        raw_output: true,
        cwd: red::string(plugin_state().root, "."),
    });
    red::on("process:" + process_id, hunk_diff_event);
}

fn spawn_hunk_diff(action: String) {
    red::state_patch(GitPluginState { hunk_unsaved: false });
    red::state_patch(GitPluginState { hunk_patch: "" });
    let process_id = red::execute("SpawnProcess", Process {
        command: "git",
        args: red::git_core(
            "hunk_diff_args",
            action,
            red::string(plugin_state().hunk_path, "")
        ),
        raw_output: true,
        cwd: red::string(plugin_state().root, "."),
    });
    red::on("process:" + process_id, hunk_diff_event);
}

fn repository_path(path: String) -> String {
    let root = red::string(plugin_state().root, ".");
    if red::starts_with(path, root + "/") {
        return red::slice(path, red::len(root) + 1);
    }
    return path;
}

fn hunk_diff_event(event: ProcessEvent) {
    match event {
        ProcessEvent::Stdout { process_id, line, plugin_name } => {
            let patch = line;
            if plugin_state().hunk_unsaved {
                patch = normalize_unsaved_patch(patch, plugin_state().hunk_path);
            }
            red::state_patch(GitPluginState { hunk_patch: patch });
        }
        ProcessEvent::Exit { process_id, code, plugin_name } => {
            if plugin_state().hunk_unsaved && plugin_state().hunk_patch == "" {
                spawn_hunk_diff(plugin_state().hunk_action);
                return;
            }
            red::request("GetSelection", hunk_selection_loaded);
        }
        ProcessEvent::Stderr { process_id, line, plugin_name } => {}
        ProcessEvent::Error { process_id, message, plugin_name } => {}
    }
}

fn normalize_unsaved_patch(patch: String, path: String) -> String {
    return red::string(red::git_core("normalize_unsaved", patch, path), "");
}

fn hunk_selection_loaded(selection: Option<GitSelection>) {
    red::state_patch(GitPluginState { hunk_selection: selection });
    red::request("GetCursorPosition", hunk_cursor_loaded);
}

fn hunk_cursor_loaded(cursor: GitCursorPosition) {
    let action = red::string(plugin_state().hunk_action, "");
    let patch = red::string(plugin_state().hunk_patch, "");
    if action == "next" || action == "previous" {
        navigate_patch(patch, red::int(cursor.y, 0), action == "next");
        return;
    }
    let selected = "";
    if let Some(selection) = plugin_state().hunk_selection {
        if red::int(selection.buffer_index, -1) == red::int(plugin_state().hunk_buffer, -2) {
            let start_line = red::int(selection.start.y, 0);
            let end_line = red::int(selection.end.y, start_line);
            if end_line < start_line {
                let swap = start_line;
                start_line = end_line;
                end_line = swap;
            }
            selected = patch_for_line_range(patch, start_line, end_line);
        }
    }
    if selected == "" {
        selected = patch_for_hunk(patch, red::int(cursor.y, 0));
    }
    if selected == "" {
        red::execute("Print", "No Git hunk under cursor");
        return;
    }
    red::state_patch(GitPluginState { hunk_patch: selected });
    if action == "reset" {
        red::execute("OpenPicker", "Reset hunk", [
            PickerItem { id: "cancel", label: "Cancel", kind: "Cancel" },
            PickerItem { id: "proceed", label: "Proceed", kind: "Destructive" },
        ], PickerOptions { status: "This cannot be undone by Red." }, PickerHandlers {
            selected: reset_confirmed,
        });
    } else {
        apply_hunk(action, selected);
    }
}

fn reset_confirmed(item: PickerItem) {
    if item.id == "proceed" {
        apply_hunk("reset", red::string(plugin_state().hunk_patch, ""));
    }
}

fn navigate_patch(patch: String, cursor_line: i32, forward: bool) {
    let starts = hunk_starts(patch);
    if red::len(starts) == 0 {
        print_hunk_boundary(forward);
        return;
    }
    let target = -1;
    if forward {
        for line in starts {
            if line > cursor_line && target == -1 {
                target = line;
            }
        }
    } else {
        for line in starts {
            if line < cursor_line {
                target = line;
            }
        }
    }
    if target == -1 {
        print_hunk_boundary(forward);
        return;
    }
    red::execute("SetCursorPosition", 0, target, true);
}

fn print_hunk_boundary(forward: bool) {
    if forward {
        red::execute("Print", "No next Git hunk");
    } else {
        red::execute("Print", "No previous Git hunk");
    }
}

fn hunk_starts(patch: String) -> [i32] {
    return red::git_core("hunk_starts", patch);
}

fn patch_for_hunk(patch: String, cursor_line: i32) -> String {
    return red::string(red::git_core("editor_hunk", patch, cursor_line), "");
}

fn patch_for_line_range(patch: String, start_line: i32, end_line: i32) -> String {
    return red::string(red::git_core("editor_range", patch, start_line, end_line), "");
}

fn apply_hunk(action: String, patch: String) {
    let previous = red::string(plugin_state().apply_check_process, "");
    if previous != "" {
        red::execute("KillProcess", previous);
    }
    red::state_patch(GitPluginState { apply_check_action: action });
    red::state_patch(GitPluginState { apply_check_patch: patch });
    let args = apply_hunk_args(action);
    args = red::push(args, "--check");
    let process_id = red::execute("SpawnProcess", Process {
        command: "git",
        args: args,
        stdin: patch + "\n",
        cwd: red::string(plugin_state().root, "."),
    });
    red::state_patch(GitPluginState { apply_check_process: process_id });
    red::on("process:" + process_id, apply_hunk_check_finished);
}

fn apply_hunk_args(action: String) -> [String] {
    return red::git_core("apply_hunk_args", action);
}

fn apply_hunk_check_finished(event: ProcessEvent) {
    let ProcessEvent::Exit { process_id, code, plugin_name } = event else {
        return;
    };
    if process_id != plugin_state().apply_check_process {
        return;
    }
    red::state_patch(GitPluginState { apply_check_process: "" });
    let exit_code = 1;
    if let Some(value) = code {
        exit_code = value;
    }
    if exit_code != 0 {
        red::execute("Print", "Git rejected the selected patch; refresh and try again");
        return;
    }
    let action = red::string(plugin_state().apply_check_action, "");
    let patch = red::string(plugin_state().apply_check_patch, "");
    let process_id = red::execute("SpawnProcess", Process {
        command: "git",
        args: apply_hunk_args(action),
        stdin: patch + "\n",
        cwd: red::string(plugin_state().root, "."),
    });
    red::on("process:" + process_id, action_finished);
}

#[red::lifecycle("deactivate")]
fn deactivate() {
    cancel_detail_timer();
    for job in plugin_state().operation_jobs {
        red::execute("KillProcess", job.id);
    }
    red::state_patch(GitPluginState { operation_jobs: [] });
    let refresh_timer = red::string(plugin_state().refresh_timer, "");
    if refresh_timer != "" {
        red::execute("CancelTimeout", refresh_timer);
    }
    let poll_timer = red::string(plugin_state().poll_timer, "");
    if poll_timer != "" {
        red::execute("CancelTimeout", poll_timer);
    }
    let push_done_timer = red::string(plugin_state().push_done_timer, "");
    if push_done_timer != "" {
        red::execute("CancelTimeout", push_done_timer);
    }
    let git_task_busy_timer = red::string(plugin_state().git_task_busy_timer, "");
    if git_task_busy_timer != "" {
        red::execute("CancelTimeout", git_task_busy_timer);
    }
    let git_task_done_timer = red::string(plugin_state().git_task_done_timer, "");
    if git_task_done_timer != "" {
        red::execute("CancelTimeout", git_task_done_timer);
    }
    for process_id in [
        red::string(plugin_state().git_task_process, ""),
        red::string(plugin_state().commit_process, ""),
        red::string(plugin_state().commit_context_process, ""),
        red::string(plugin_state().commit_history_process, ""),
    ] {
        if process_id != "" { red::execute("KillProcess", process_id); }
    }
    let push_preview_process = red::string(plugin_state().push_preview_process, "");
    if push_preview_process != "" {
        red::execute("KillProcess", push_preview_process);
    }
    let push_process = red::string(plugin_state().push_process, "");
    if push_process != "" {
        red::execute("KillProcess", push_process);
    }
    red::state_patch(GitPluginState { refresh_timer: "" });
    red::state_patch(GitPluginState { poll_timer: "" });
    red::state_patch(GitPluginState { push_done_timer: "" });
    red::state_patch(GitPluginState { git_task_busy_timer: "" });
    red::state_patch(GitPluginState { git_task_done_timer: "" });
    if red::string(plugin_state().watch_path, "") != "" {
        red::execute("UnwatchDirectory", 1502);
    }
    red::execute("ClearGutterSigns", "git-signs");
    red::execute("CloseWorkspace", "git-dashboard");
    red::execute("RemoveOverlay", "git-push-progress");
    red::execute("RemoveOverlay", "git-operation-progress");
}
