// Full-screen Git workspace, gutter signs, hunk actions, and repository operation UI.
//
// All Git commands run through the plugin process permission boundary without a shell.
// Destructive or history-changing actions pass through explicit confirmation, operation
// responses are correlated by plugin-owned process state, and unsaved-buffer hunk work
// uses editor text rather than assuming disk is authoritative. Deactivation cancels
// watchers, processes, timers, panels, workspace state, and gutter namespaces.
// Picker callbacks are owner-scoped: each menu item carries its flow context, while the
// active prompt handle is retained only so query changes update the correct picker.

struct GitEntry {
    path: String,
    // Non-renames have no original path.
    original_path: Option<String>,
    x: String,
    y: String,
    kind: String,
}

struct GitDisplayEntry {
    entry: GitEntry,
    filename: String,
    parent: String,
    label: String,
}

struct GitState {
    head: String,
    oid: String,
    upstream: String,
    ahead: i32,
    behind: i32,
    stash_count: i32,
    staged: [GitEntry],
    unstaged: [GitEntry],
    untracked: [GitEntry],
    conflicted: [GitEntry],
    truncated: bool,
}

struct GitSignGlyphs {
    add: String,
    change: String,
    delete: String,
    topdelete: String,
    changedelete: String,
}

struct GitPluginOptions {
    signs: GitSignGlyphs,
    staged_signs: GitSignGlyphs,
    signs_staged: GitSignGlyphs,
    commit_generation: GitCommitGenerationOptions,
}

struct GitCommitGenerationOptions {
    history_count: i32,
}

struct GitPluginConfig {
    git: GitPluginOptions,
}

struct GitConfigValue {
    executable: String,
    plugin_config: GitPluginConfig,
}

struct GitConfigEvent {
    value: GitConfigValue,
}

struct GitStringValueEvent {
    value: String,
}

struct GitThemeUiStyle {
    muted: Style,
    popup_title: Style,
}

struct GitTheme {
    // Theme color keys are open-ended and their values may be null or color variants.
    colors: Json,
    style: Style,
    ui_style: GitThemeUiStyle,
}

struct GitEditorInfo {
    theme: GitTheme,
}

struct GitWindow {
    active: bool,
    buffer_index: i32,
    buffer_path: String,
}

struct GitWindowsResult {
    windows: [GitWindow],
}

struct SignBuffer {
    path: String,
    buffer_index: i32,
}

struct SignHunk {
    buffer_index: i32,
    old_start: i32,
    old_count: i32,
    new_start: i32,
    new_count: i32,
}

struct SignAppearance {
    text: String,
    style: Style,
}

struct SignAppearances {
    add: SignAppearance,
    change: SignAppearance,
    delete: SignAppearance,
    topdelete: SignAppearance,
    changedelete: SignAppearance,
}

struct GitGutterSign {
    buffer_index: i32,
    line: i32,
    text: String,
    priority: i32,
    style: Style,
}

struct OperationJob {
    id: String,
    kind: String,
}

struct SignJob {
    id: String,
    buffers: [SignBuffer],
    staged: bool,
}

struct GitBufferTextEvent {
    text: String,
}

struct GitScratchOpenedEvent {
    buffer_index: i32,
}

struct ScratchBufferOptions {
    syntax: String,
    submit: String,
    cancel: String,
}

struct GitRestoreResult {
    restored: bool,
    warnings: [String],
}

struct GitCursorPosition {
    x: i32,
    y: i32,
}

struct GitSelection {
    buffer_index: i32,
    start: GitCursorPosition,
    end: GitCursorPosition,
}

struct GitWorkspaceLineData {
    path: String,
    section: String,
    patch_index: i32,
    // Metadata lines do not belong to a hunk.
    hunk_id: Option<String>,
}

struct GitWorkspaceDocumentLine {
    id: String,
    text: String,
    kind: String,
    // Diff metadata lines have no old or new source line.
    old_line: Option<i32>,
    new_line: Option<i32>,
    hunk_id: Option<String>,
    data: GitWorkspaceLineData,
}

struct GitWorkspaceDocument {
    path: String,
    lines: [GitWorkspaceDocumentLine],
    added: i32,
    removed: i32,
    total_lines: i32,
    truncated: bool,
}

struct GitWorkspaceRowData {
    section: String,
    path: String,
    entry: Option<GitEntry>,
}

struct GitWorkspaceRow {
    id: String,
    selectable: bool,
    depth: i32,
    path: Option<String>,
    segments: [PanelSegment],
    right_segments: [PanelSegment],
    data: Option<GitWorkspaceRowData>,
}

struct GitWorkspaceEvent {
    action: String,
    focus: String,
    row: Option<GitWorkspaceRow>,
    detail_index: i32,
    detail_line: Option<GitWorkspaceDocumentLine>,
    detail_selection: Option<[i32]>,
}

struct GitWorkspaceModel {
    header: [PanelSegment],
    rows: [GitWorkspaceRow],
    detail: [[PanelSegment]],
    detail_document: Option<GitWorkspaceDocument>,
    footer: [PanelSegment],
    actions: [GitWorkspaceAction],
    status: String,
    detail_title: String,
}

struct GitUiAction {
    id: String,
    key: String,
    label: String,
    priority: String,
}

struct GitWorkspaceAction {
    hint: GitUiAction,
    focus: String,
    sections: [String],
    selection: String,
    change_only: bool,
    hunk_only: bool,
}

struct GitRebaseCommit {
    oid: String,
    subject: String,
}

struct GitPluginState {
    dashboard_open: bool,
    process: String,
    status_initialized: bool,
    status_output: String,
    refresh_forced: bool,
    idle_polls: i32,
    refresh_timer: String,
    poll_timer: String,
    watch_path: String,
    command_log: [String],
    info: Option<GitEditorInfo>,
    executable: String,
    sign_glyphs: GitSignGlyphs,
    staged_sign_glyphs: GitSignGlyphs,
    root: String,
    state: GitState,
    hunk_action: String,
    hunk_path: String,
    hunk_patch: String,
    hunk_buffer: i32,
    hunk_selection: Option<GitSelection>,
    hunk_unsaved: bool,
    hunk_disk_path: String,
    commit_mode: String,
    // Editor snapshots are versioned host-owned payloads.
    commit_snapshot: Json,
    commit_buffer: i32,
    commit_retry_text: String,
    commit_process: String,
    commit_error: String,
    commit_draft_text: String,
    commit_context_process: String,
    commit_context_output: String,
    commit_context_error: String,
    commit_generate_message: bool,
    commit_history_count: i32,
    commit_history_process: String,
    commit_history_output: String,
    commit_history_error: String,
    signs: [GitGutterSign],
    sign_jobs: [SignJob],
    prompt_kind: String,
    prompt_picker: Option<i32>,
    capture_kind: String,
    capture_output: String,
    operation: String,
    operation_jobs: [OperationJob],
    operation_candidate: String,
    detail: [[PanelSegment]],
    detail_document: Option<GitWorkspaceDocument>,
    detail_process: String,
    detail_output: String,
    detail_pending_output: String,
    detail_error: String,
    detail_status: String,
    detail_suppressed: bool,
    stats: Json,
    stats_process: String,
    stats_section: String,
    stats_output: String,
    detail_path: String,
    detail_section: String,
    detail_rendered_path: String,
    detail_rendered_section: String,
    detail_timer: String,
    pending_detail_row: Option<GitWorkspaceRow>,
    row_action_process: String,
    row_action_error: String,
    git_task_process: String,
    git_task_error: String,
    git_task_operation: String,
    git_task_start_message: String,
    git_task_success_message: String,
    git_task_busy_timer: String,
    git_task_done_timer: String,
    safe_sync_pending: bool,
    push_preview_process: String,
    push_preview_stage: String,
    push_preview_output: String,
    push_preview_error: String,
    push_remote: String,
    push_target: String,
    push_args: [String],
    push_count: i32,
    push_process: String,
    push_error: String,
    push_done_timer: String,
    confirm_mode: String,
    confirm_args: [String],
    pending_commit_message: String,
    apply_check_process: String,
    apply_check_action: String,
    apply_check_patch: String,
    confirm_operation: String,
    confirm_action: String,
    tag_name: String,
    remote_name: String,
    reset_target: String,
    worktree_path: String,
    rebase_base: String,
    rebase_commits: [GitRebaseCommit],
    rebase_index: i32,
    rebase_todo: [String],
    stash_action: String,
    remote_action: String,
    remote_old: String,
    worktree_action: String,
    worktree_old: String,
    log_oid: String,
}

