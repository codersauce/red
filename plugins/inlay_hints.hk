// Debounced LSP inlay hints rendered as line decorations.
//
// Viewport, editor-info, and response snapshots must refer to the same requested state
// before rendering. Request IDs reject stale LSP results, and deactivation cancels the
// pending timeout and clears the decoration namespace.

struct InlayHintsOptions {
    parameter_hints: bool,
}

struct InlayPluginConfig {
    inlay_hints: InlayHintsOptions,
}

struct InlayConfigValue {
    plugin_config: InlayPluginConfig,
}

struct InlayConfigEvent {
    value: InlayConfigValue,
}

struct InlayViewportRow {
    line: i32,
}

struct InlayViewportLayout {
    buffer_index: i32,
    rows: [InlayViewportRow],
}

struct InlayHint {
    kind: i32,
    position: Position,
    // LSP permits either a string or an array of label parts here.
    label: Json,
}

struct InlayHintsResult {
    ok: bool,
    hints: [InlayHint],
}

struct InlayHintGroup {
    line: i32,
    hints: [InlayHint],
}

struct InlayThemeBaseStyle {
    fg: Json,
    bg: Json,
}

struct InlayTheme {
    // Theme colors form an open-ended nullable color map at the host boundary.
    colors: Json,
    gutter_style: InlayThemeBaseStyle,
    style: InlayThemeBaseStyle,
}

struct InlayEditorInfo {
    theme: InlayTheme,
}

struct InlayDecoration {
    buffer_index: i32,
    line: i32,
    anchor: String,
    column: i32,
    text: String,
    style: Style,
    priority: i32,
}

struct InlayHintsState {
    timer: String,
    layout: Option<InlayViewportLayout>,
    info: Option<InlayEditorInfo>,
    hints: Option<InlayHintsResult>,
    info_loaded: bool,
    hints_loaded: bool,
    generation: i32,
    hints_request: i32,
    retry_count: i32,
    parameter_hints: bool,
    last_decorations: Option<[InlayDecoration]>,
}

#[red::state]
fn initial_state() -> InlayHintsState {
    return InlayHintsState {
        timer: "",
        layout: None,
        info: None,
        hints: None,
        info_loaded: false,
        hints_loaded: false,
        generation: 0,
        hints_request: 0,
        retry_count: 0,
        parameter_hints: false,
        last_decorations: None,
    };
}

fn state() -> InlayHintsState {
    return red::state();
}

#[red::lifecycle("activate")]
fn initialize_hints() {
    refresh();
}

#[red::config]
fn config_loaded(event: InlayConfigEvent) {
    let options = event.value.plugin_config.inlay_hints;
    if options != red::null() {
        red::state_patch(InlayHintsState { parameter_hints: red::bool(options.parameter_hints, false) });
        refresh();
    }
}

#[red::on("buffer:changed")]
#[red::on("file:opened")]
#[red::on("viewport:changed")]
#[red::on("theme:changed")]
fn schedule_refresh(event: EmptyEvent) {
    let timer = red::string(state().timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
    }
    red::state_patch(InlayHintsState { retry_count: 0 });
    red::state_patch(InlayHintsState { timer: red::execute("SetTimeout", 120) });
}

#[red::on("timeout:callback")]
fn timeout_callback(event: TimerEvent) {
    if event.timer_id != state().timer {
        return;
    }
    red::state_patch(InlayHintsState { timer: "" });
    refresh();
}

fn refresh() {
    let generation = red::int(state().generation, 0) + 1;
    red::state_patch(InlayHintsState { generation: generation });
    red::state_patch(InlayHintsState { info_loaded: false });
    red::state_patch(InlayHintsState { hints_loaded: false });
    let layout: InlayViewportLayout = red::viewport_layout();
    layout_loaded(layout);
}

fn layout_loaded(layout: InlayViewportLayout) {
    if red::len(layout.rows) == 0 {
        red::execute("ClearDecorations", "inlay-hints");
        return;
    }
    red::state_patch(InlayHintsState { layout: Some(layout) });
    let start_line = layout.rows[0].line;
    let end_line = start_line;
    for row in layout.rows {
        if row.line < start_line {
            start_line = row.line;
        }
        if row.line > end_line {
            end_line = row.line;
        }
    }
    let hints_id = red::request("InlayHints", hints_loaded, Range {
        start: Position { line: start_line, character: 0 },
        end: Position { line: end_line + 1, character: 0 },
    });
    red::state_patch(InlayHintsState { hints_request: hints_id });
    let info: InlayEditorInfo = red::editor_info();
    info_loaded(info);
}

fn info_loaded(info: InlayEditorInfo) {
    red::state_patch(InlayHintsState { info: Some(info) });
    red::state_patch(InlayHintsState { info_loaded: true });
    render_if_ready();
}

fn hints_loaded(result: InlayHintsResult, request_id: i32) {
    if request_id != red::int(state().hints_request, -2) {
        return;
    }
    red::state_patch(InlayHintsState { hints: Some(result) });
    red::state_patch(InlayHintsState { hints_loaded: true });
    render_if_ready();
}

fn render_if_ready() {
    if !state().info_loaded || !state().hints_loaded {
        return;
    }
    let Some(result) = state().hints else {
        return;
    };
    if !red::bool(result.ok, false) {
        red::execute("ClearDecorations", "inlay-hints");
        schedule_retry();
        return;
    }
    red::state_patch(InlayHintsState { retry_count: 0 });

    let Some(layout) = state().layout else {
        return;
    };
    let Some(info) = state().info else {
        return;
    };
    let hints_by_line = group_hints_by_line(result.hints, layout.rows);
    let seen: [i32] = [];
    let decorations: [InlayDecoration] = [];
    let row_index = 0;
    while row_index < red::len(layout.rows) && row_index < 64 {
        let row = layout.rows[row_index];
        if red::contains(seen, row.line) {
            row_index = row_index + 1;
            continue;
        }
        seen = red::push(seen, row.line);
        let text = line_hint_text(hints_for_line(hints_by_line, row.line));
        if text == "" {
            row_index = row_index + 1;
            continue;
        }
        decorations = red::push(decorations, InlayDecoration {
            buffer_index: layout.buffer_index,
            line: row.line,
            anchor: "eol",
            column: 0,
            text: " " + text,
            style: hint_style(info),
            priority: 1001,
        });
        row_index = row_index + 1;
    }
    if state().last_decorations != Some(decorations) {
        red::state_patch(InlayHintsState { last_decorations: Some(decorations) });
        red::execute("SetDecorations", "inlay-hints", decorations);
    }
}

fn schedule_retry() {
    let retry_count = red::int(state().retry_count, 0);
    if retry_count >= 8 {
        return;
    }
    let timer = red::string(state().timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
    }
    red::state_patch(InlayHintsState { retry_count: retry_count + 1 });
    red::state_patch(InlayHintsState { timer: red::execute("SetTimeout", 500) });
}

fn group_hints_by_line(hints: [InlayHint], rows: [InlayViewportRow]) -> [InlayHintGroup] {
    // Bound both visible rows and hints per line before the insertion sort below.
    let grouped: [InlayHintGroup] = [];
    let row_index = 0;
    while row_index < red::len(rows) && red::len(grouped) < 64 {
        let line = rows[row_index].line;
        let found = false;
        for group in grouped {
            if group.line == line {
                found = true;
            }
        }
        if !found {
            grouped = red::push(grouped, InlayHintGroup { line: line, hints: [] });
        }
        row_index = row_index + 1;
    }
    let index = 0;
    while index < red::len(hints) && index < 256 {
        let hint = hints[index];
        let line = red::int(hint.position.line, -1);
        let updated: [InlayHintGroup] = [];
        for group in grouped {
            if group.line == line {
                if red::len(group.hints) < 24 {
                    group.hints = red::push(group.hints, hint);
                }
            }
            updated = red::push(updated, group);
        }
        grouped = updated;
        index = index + 1;
    }
    return grouped;
}

fn hints_for_line(grouped: [InlayHintGroup], line: i32) -> [InlayHint] {
    for group in grouped {
        if group.line == line {
            return group.hints;
        }
    }
    return [];
}

fn line_hint_text(hints: [InlayHint]) -> String {
    let type_hints: [String] = [];
    let parameter_hints: [String] = [];
    for hint in sorted_line_hints(hints) {
        let text = red::trim(label_text(hint.label));
        if red::int(hint.kind, 0) == 1 {
            if red::starts_with(text, ":") {
                text = red::trim(red::slice(text, 1));
            }
            if text != "" {
                type_hints = red::push(type_hints, text);
            }
        } else if red::int(hint.kind, 0) == 2 && state().parameter_hints {
            if red::ends_with(text, ":") {
                text = red::slice(text, 0, red::len(text) - 1);
            }
            if text != "" {
                parameter_hints = red::push(parameter_hints, text);
            }
        }
    }
    if red::len(type_hints) == 0 && red::len(parameter_hints) == 0 {
        return "";
    }
    let result = "";
    if red::len(parameter_hints) > 0 {
        result = "<- (" + join_text(parameter_hints, ",") + ")";
    }
    if red::len(type_hints) > 0 {
        if result != "" {
            result = result + " ";
        }
        result = result + "=> " + join_text(type_hints, ",");
    }
    return result;
}

fn sorted_line_hints(hints: [InlayHint]) -> [InlayHint] {
    let sorted: [InlayHint] = [];
    for hint in hints {
        let inserted = false;
        let next: [InlayHint] = [];
        for current in sorted {
            if !inserted && red::int(hint.position.character, 0) < red::int(current.position.character, 0) {
                next = red::push(next, hint);
                inserted = true;
            }
            next = red::push(next, current);
        }
        if !inserted {
            next = red::push(next, hint);
        }
        sorted = next;
    }
    return sorted;
}

fn label_text(label: Json) -> String {
    let text = red::string(label, "");
    if text != "" {
        return text;
    }
    text = "";
    for part in label {
        text = text + red::string(part.value, "");
    }
    return text;
}

fn join_text(values: [String], separator: String) -> String {
    let joined = "";
    for value in values {
        if joined != "" {
            joined = joined + separator;
        }
        joined = joined + red::string(value, "");
    }
    return joined;
}

fn hint_style(info: InlayEditorInfo) -> Style {
    let fg = info.theme.colors["editorInlayHint.typeForeground"];
    if fg == red::null() {
        fg = info.theme.colors["editorInlayHint.foreground"];
    }
    if fg == red::null() {
        fg = info.theme.gutter_style.fg;
    }
    if fg == red::null() {
        fg = Color { Rgb: Json { r: 108, g: 112, b: 134 } };
    }
    let bg = info.theme.colors["editor.background"];
    if bg == red::null() {
        bg = info.theme.style.bg;
    }
    if bg == red::null() {
        bg = Color { Rgb: Json { r: 0, g: 0, b: 0 } };
    }
    return Style {
        fg: red::blend_color(fg, bg, 0.42),
        bg: red::null(),
        bold: false,
        italic: true,
    };
}

#[red::lifecycle("deactivate")]
fn deactivate() {
    let timer = red::string(state().timer, "");
    if timer != "" {
        red::execute("CancelTimeout", timer);
    }
    red::state_patch(InlayHintsState { timer: "" });
    red::state_patch(InlayHintsState { last_decorations: None });
    red::execute("ClearDecorations", "inlay-hints");
}
